#!/usr/bin/env bash
#
#  infra/env.sh.example — environment variable reference for hyprconf infra
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  RECOMMENDED: run  hyprconf deploy                                      │
#  │  It prompts for these settings interactively and saves them to          │
#  │  ~/.config/hyprconf/infra.env  (outside the repo, chmod 600).           │
#  │  You will not need this file for normal usage.                          │
#  └─────────────────────────────────────────────────────────────────────────┘
#
#  This file is useful if you want to:
#    • Drive deploy.sh / teardown.sh from CI/CD without interactive prompts
#    • Override specific settings without re-running the interactive setup
#    • Document the full set of supported variables for forking/reference
#
#  For CI/CD usage: export variables in your pipeline environment instead of
#  using a file — never store credentials in version control.

# ── AWS authentication ────────────────────────────────────────────────────────
# Option A: Named profile  (uses ~/.aws/config — recommended for local use)
export AWS_PROFILE="default"

# Option B: Explicit credentials  (for CI/CD or environments without ~/.aws)
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export AWS_SESSION_TOKEN=""     # only needed for temporary/SSO credentials

# Must be us-east-1: ACM certificates used by CloudFront must be in this region.
export AWS_DEFAULT_REGION="us-east-1"

# ── Project settings ──────────────────────────────────────────────────────────

# Domain where install.sh will be served over HTTPS.
# Must be within the Route53 hosted zone below.
# Example: get.yourdomain.com
export HYPRCONF_DOMAIN=""

# S3 bucket name — must be globally unique across all AWS accounts.
# Suggested convention: replace dots in the domain with hyphens.
# Example: get-yourdomain-com
export HYPRCONF_BUCKET=""

# Route53 hosted zone ID for the PARENT domain (not the full subdomain).
# Find at: https://console.aws.amazon.com/route53/v2/hostedzones
# Example: ZXXXXXXXXXXXXX
export HYPRCONF_ZONE_ID=""

# GitHub repo URL cloned by the bootstrap installer.
# Fork this repo and set this to your fork's URL.
# 'hyprconf deploy' auto-detects this from the local git remote.
export HYPRCONF_REPO=""

# >>> hyprconf >>>
# Managed block — regenerate with: bash ~/.hyprconf/install.sh
# Everything between these markers is replaced on each run; edit the source at
# zsh/zshrc.block instead. Anything outside the markers is preserved — as long
# as BOTH marker lines are here, in this order: with only one, or the two
# swapped, the installer leaves this file alone and says so, because it
# cannot tell where the block ends.
#
# Omarchy is bash-only. hyprconf runs zsh inside kitty and leaves the LOGIN
# shell as bash, so Omarchy's session, uwsm, SSH and scripts are untouched.
# The trade is that zsh does not see Omarchy's interactive bash rc chain, so
# we source Omarchy's own files rather than reimplementing them — its future
# updates then flow straight through.
#
# Deliberately failure-tolerant: these are bash files being read by zsh. They
# parse today, but a bashism in some future Omarchy release must degrade to a
# missing alias, never to an unusable shell.
_hyprconf_bash="${OMARCHY_PATH:-/usr/share/omarchy}/default/bash"
for _hyprconf_f in env-bootstrap envs aliases; do
  [ -r "$_hyprconf_bash/$_hyprconf_f" ] &&
    source "$_hyprconf_bash/$_hyprconf_f" 2>/dev/null
done
unset _hyprconf_bash _hyprconf_f

# Omarchy aliases `cd` to its `zd` wrapper, which calls zoxide's `z`. Without
# initialising zoxide for zsh, that alias breaks `cd` for anything that isn't
# an existing directory.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# Oh My Zsh hosts powerlevel10k as its theme; ~/.p10k.zsh carries the prompt
# configuration and is symlinked out of the hyprconf checkout.
export ZSH="$HOME/.oh-my-zsh"
# The pin's other half: install.sh checks Oh My Zsh out at a reviewed commit
# (stage_shell), and this disables the updater that ships INSIDE it — left
# on, its ~13-day prompt would pull and execute unreviewed upstream master
# with one keypress, reopening the exact channel the pin closes.
zstyle ':omz:update' mode disabled
ZSH_THEME="powerlevel10k/powerlevel10k"
[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"
[ -r "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"
typeset -g POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION=$''

[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# The checkout is wherever ~/.p10k.zsh — linked out of it by the same install
# stage that writes this block — points, so a relocated one (HYPRCONF_DIR)
# needs no path baked in here.
alias hyprsync='bash "$(dirname "$(dirname "$(readlink -f "$HOME/.p10k.zsh")")")/install.sh" --sync'

# Shell greeting. The layout lives in fastfetch/config.jsonc, linked to
# ~/.config/fastfetch/config.jsonc by the installer.
command -v fastfetch >/dev/null 2>&1 &&
  fastfetch --logo arch2 --logo-color-1 green --logo-color-2 green

# zsh-syntax-highlighting must be sourced last — it wraps the widgets that
# everything above may have defined.
[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# <<< hyprconf <<<

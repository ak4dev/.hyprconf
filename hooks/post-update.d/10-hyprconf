#!/usr/bin/env bash
# Re-assert hyprconf's overlay after an Omarchy update.
#
# Installed to ~/.config/omarchy/hooks/post-update.d/ — the directory
# omarchy-update runs immediately after omarchy-migrate (bin/omarchy-update:
# 48-49, Omarchy 4.0.2-1). Migrations are exactly what undoes overlay work:
# one of them replaces ~/.config/hypr/bindings.lua when it hash-matches the
# stock file, another appends to kitty.conf. A config refresh also strips the
# `include hyprconf.conf` line. This puts them back.
#
# Under hyprsync (install.sh --sync) this is the run's SECOND apply, on
# purpose: --sync applies first, then runs omarchy-update, whose migrations
# may rewrite what was just applied — so the apply after them is the one that
# counts, never a redundant one to skip. There is no environment guard for
# that case (an earlier one skipped exactly this run); --no-update below is
# the only recursion guard, and the only one needed.
#
# @HYPRCONF_DIR@ is substituted with the real checkout path at install time, so
# this works regardless of where the repo was cloned.
#
# No `set -e`: omarchy-hook reports a failing hook but must never abort an
# update, so every "nothing to do" path exits 0.
set -uo pipefail

readonly HYPRCONF_DIR="@HYPRCONF_DIR@"

[[ -r $HYPRCONF_DIR/install.sh ]] || {
  echo "hyprconf post-update hook: $HYPRCONF_DIR/install.sh is gone; skipping" >&2
  exit 0
}

# --no-update is the recursion guard proper: this ran FROM omarchy-update.
# --no-packages exports HYPRCONF_NO_SUDO, so every module skips its own
# packages and its own root writes, and an unattended run (`omarchy update -y` →
# OMARCHY_UPDATE_UNATTENDED, bin/omarchy-update:26) never blocks on a
# password prompt. Not a lock: omarchy-update-system-pkgs
# has returned by the time the hook runs (bin/omarchy-update:47-49).
exec bash "$HYPRCONF_DIR/install.sh" --no-update --no-packages

#!/usr/bin/env bash
# Extend an Omarchy theme change to the one app its own fan-out leaves out:
# Firefox / LibreWolf. Omarchy themes Chromium-family browsers only
# (omarchy-theme-set-browser: a managed-policy BrowserThemeColor for
# chromium/chrome/edge/brave; `grep -il firefox /usr/share/omarchy/bin/*`
# finds no theming, Omarchy 4.0.0-1). VS Code needs nothing here: it is
# installed by omarchy-install-editor-vscode and themed by
# omarchy-theme-set-vscode, one of the post_theme_commands omarchy-theme-set
# runs through run_parallel (Omarchy 4.0.2-1) before this hook.
#
# Installed to ~/.config/omarchy/hooks/theme-set.d/ — the directory
# `omarchy-hook theme-set <name>` runs, the call omarchy-theme-set makes
# right after its run_parallel of the post-theme commands returns. It also
# runs once from install.sh so the active theme lands without a switch.
#
# The palette is rendered by Omarchy itself: themed/userChrome.css.tpl, a
# user template, becomes ~/.local/state/omarchy/current/theme/userChrome.css
# on every theme set (bin/omarchy-theme-set-templates, which
# bin/omarchy-theme-set runs under its flock before swapping the staged
# theme in). The overlay's tested Python —
# lib/hyprconf/firefox_theme.py — copies it into each profile and merges the
# user.js prefs; Firefox picks both up at its next start. No skip toggle:
# Omarchy's are `skip-{vscode,vscode-insiders,codium,cursor}-theme-changes`
# only (`grep -Rho 'omarchy-toggle-enabled [a-z-]*' /usr/share/omarchy/bin`).
#
# @HYPRCONF_DIR@ is substituted with the real checkout path at install time.
#
# No `set -e`: omarchy-hook reports a failing hook but must never abort a
# theme switch. Every branch degrades to a message on stderr.
set -uo pipefail

readonly HYPRCONF_DIR="@HYPRCONF_DIR@"

PYTHONPATH="$HYPRCONF_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m hyprconf.firefox_theme ||
  printf 'hyprconf theme-set hook: Firefox theming failed\n' >&2
exit 0

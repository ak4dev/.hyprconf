#monitor = HDMI-A-1,3840x2160@119.88Hz,auto,2
#monitor = DP-1,3840x2160@240,auto-left,2
#monitor = DP-2,3840x2160@60,0x0,2,transform,3
monitorv2 {
  output = DP-2
  mode = 3840x2160@75
  position = 0x0
  scale = 2
  transform = 3
  supports_hdr = 1
  disabled = true
}
monitorv2 {
  output = DP-1
  mode = 3840x2160@240
  position = auto-left
  scale = 2
  supports_hdr = 1
  disabled = true
}
#monitorv2 {
#  output = HDMI-A-1
#  mode = 3840x2160@120
#  position = auto-left
#  scale = 2
#  supports_wide_color = 1
#  supports_hdr = 1
#}
monitor = HDMI-A-1, 3840x2160@120, 0x0, 2, vrr, 2, bitdepth, 10, cm, hdr, sdrbrightness, 1.2, sdrsaturation, 1.05

render {
  direct_scanout = 1
  cm_fs_passthrough = 1
}


xwayland {
  force_zero_scaling = true
}
workspace = 1,monitor:HDMI-A-1
workspace = 3,monitor:HDMI-A-1
workspace = 2,monitor:HDMI-A-1
workspace = 4,monitor:HDMI-A-1
workspace = 5,monitor:HDMI-A-1
workspace = 6,monitor:HDMI-A-1

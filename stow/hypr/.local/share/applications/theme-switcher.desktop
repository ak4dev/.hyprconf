[Desktop Entry]
Name=Theme
Comment=Switch the desktop colour theme
Exec=kitty --app-id theme-switcher -e bash -lc "~/.local/bin/hyprconf theme || { echo; echo 'Error — press any key to close'; read -n1; }"
Icon=preferences-desktop-theme
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;
Keywords=theme;color;scheme;switch;

[Desktop Action Wofi]
Name=Theme (wofi picker)
Exec=bash -lc "~/.local/bin/hyprconf theme pick"

[Desktop Action List]
Name=List Themes
Exec=kitty --app-id theme-switcher -e bash -lc "~/.local/bin/hyprconf theme list | less -R; read -n1"

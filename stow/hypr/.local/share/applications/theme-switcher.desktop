[Desktop Entry]
Name=Theme
Comment=Switch the desktop colour theme
Exec=kitty --app-id theme-switcher -e bash -lc "python3 ~/.config/hypr/scripts/theme-switcher/switch_theme.py || { echo; echo 'Error — press any key to close'; read -n1; }"
Icon=preferences-desktop-theme
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;
Keywords=theme;color;scheme;switch;
Actions=Pick;List;

[Desktop Action Pick]
Name=Theme (launcher picker)
Exec=bash -lc "python3 ~/.config/hypr/scripts/theme-switcher/switch_theme.py --pick"

[Desktop Action List]
Name=List Themes
Exec=kitty --app-id theme-switcher -e bash -lc "python3 ~/.config/hypr/scripts/theme-switcher/switch_theme.py --list | less -R; read -n1"

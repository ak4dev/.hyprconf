#!/usr/bin/env bash
set -euo pipefail

# hyprconf-idle-action — AC-aware idle action for hypridle.
#
# Security rationale: suspend-to-RAM keeps the LUKS master key in RAM and the
# disk decrypted, guarded only by the (password-only) lock screen.  On battery
# the laptop is usually in transit / in public — the high physical-risk context
# — so on idle we POWER OFF instead: RAM is cleared and the disk returns to
# encrypted-at-rest, falling back to the boot-time unlock (YubiKey/recovery key).
# On AC (typically a trusted desk) we suspend for convenience.
#
# Invoked by hypridle; also callable manually.  systemctl suspend/poweroff are
# authorized for the active local session by logind/polkit — no sudo needed.
#
#   hyprconf-idle-action auto                  # poweroff if on battery, else suspend
#   hyprconf-idle-action poweroff-if-battery   # poweroff only on battery (no-op on AC)
#   hyprconf-idle-action suspend-if-ac         # suspend only on AC (no-op on battery)
#   hyprconf-idle-action status                # print AC/battery state and the action

_has_battery() { compgen -G "/sys/class/power_supply/BAT*" > /dev/null 2>&1; }

# Return 0 if running on AC (a Mains supply reports online=1), 1 if on battery.
# No battery at all (desktop) is treated as "on AC" so desktops never power off.
_on_ac() {
    _has_battery || return 0
    local ps online
    for ps in /sys/class/power_supply/*/type; do
        [[ -f "$ps" ]] || continue
        [[ "$(< "$ps")" == "Mains" ]] || continue
        online="${ps%/type}/online"
        [[ -f "$online" ]] || continue
        [[ "$(< "$online")" == "1" ]] && return 0
    done
    return 1
}

# Locking + clipboard wipe before the transition is handled by hypridle's
# existing lock_cmd / before_sleep_cmd (and the screen locks at 45 min, well
# before the 60-min battery poweroff), so this script only does the power action.
# Explicit if/else (not A && B || C) so an exec failure can never fall through
# to the wrong action.

main() {
    local mode="${1:-auto}"
    case "$mode" in
        auto)                if _on_ac; then exec systemctl suspend; else exec systemctl poweroff; fi ;;
        poweroff-if-battery) if ! _on_ac; then exec systemctl poweroff; fi ;;   # no-op on AC
        suspend-if-ac)       if _on_ac;   then exec systemctl suspend;  fi ;;   # no-op on battery
        status)
            if _on_ac; then
                printf 'AC adapter: online  → idle action: suspend\n'
            else
                printf 'AC adapter: battery → idle action: poweroff\n'
            fi
            ;;
        *)
            printf 'Usage: hyprconf-idle-action [auto|poweroff-if-battery|suspend-if-ac|status]\n' >&2
            exit 1
            ;;
    esac
}

main "$@"

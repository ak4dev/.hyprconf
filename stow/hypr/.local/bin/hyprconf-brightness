#!/usr/bin/env bash
set -euo pipefail

# hyprconf-brightness — laptop backlight control with on-screen feedback.
#
#   hyprconf-brightness up | down | get
#
# Bound to XF86MonBrightnessUp/Down. Wraps brightnessctl for three reasons the
# bare keybind could not cover:
#
#   * it stays on the backlight. With no backlight device present — every
#     desktop — `brightnessctl set` falls through to the first LED it finds and
#     starts dimming a keyboard light instead. Here, no backlight means the key
#     does nothing.
#   * it reports. The quickshell OSD is told the resulting percentage, so the
#     keys give the same feedback the volume keys do.
#   * it never lands on 0. `-n2` floors the panel at 2% (a 5% step of zero is
#     still zero, and the brightness-up key cannot always recover a dark
#     panel), and `-e4` spends the range on a perceptual curve.

: "${_HYPRCONF_BACKLIGHT_ROOT:=/sys/class/backlight}"
: "${_HYPRCONF_QS_LAUNCH:=$HOME/.config/quickshell/launch.sh}"
: "${_HYPRCONF_RUNTIME_DIR:=${XDG_RUNTIME_DIR:-/tmp}}"

readonly STEP=5
readonly FLOOR=2
readonly CURVE=4

_has_backlight() {
    compgen -G "$_HYPRCONF_BACKLIGHT_ROOT/*/brightness" > /dev/null 2>&1
}

# brightnessctl -m prints device,class,current,percent%,max
_percent() {
    brightnessctl -c backlight -m 2>/dev/null |
        awk -F, 'NR==1 { gsub("%", "", $4); print $4 }'
}

_notify_osd() {
    local percent="$1"
    [[ -x "$_HYPRCONF_QS_LAUNCH" ]] || return 0
    # Best-effort: the bar may not be running (a bare session, or quickshell
    # restarting), and the backlight change already happened either way.
    "$_HYPRCONF_QS_LAUNCH" ipc call osd brightness "$percent" > /dev/null 2>&1 || true
}

_adjust() {
    local direction="$1" percent
    brightnessctl -c backlight -e"$CURVE" -n"$FLOOR" set "${STEP}%${direction}" > /dev/null

    percent="$(_percent)"
    if [[ -n "$percent" ]]; then
        _notify_osd "$percent"
    fi
}

_has_backlight || exit 0

case "${1:-}" in
    up | down)
        # Hardware key repeat can fire faster than brightnessctl completes; let
        # the overlapping presses fall through rather than queue up a backlog
        # that keeps stepping after the key is released.
        exec {lock_fd}> "$_HYPRCONF_RUNTIME_DIR/hyprconf-brightness.lock"
        flock -n "$lock_fd" || exit 0
        if [[ "$1" == "up" ]]; then
            _adjust "+"
        else
            _adjust "-"
        fi
        ;;
    get)
        _percent
        ;;
    *)
        printf "Usage: hyprconf-brightness [up|down|get]\n" >&2
        exit 1
        ;;
esac

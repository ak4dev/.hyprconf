#!/usr/bin/env bash
# autorotate — watch iio-sensor-proxy orientation and apply Hyprland transform.
# Requires: iio-sensor-proxy (monitor-sensor), hyprctl
set -euo pipefail

# Find the first built-in display (eDP-*). Fall back to eDP-1 if hyprctl is
# unavailable (e.g. launched before Hyprland initialises — retry loop handles it).
_find_edp() {
    hyprctl monitors -j 2>/dev/null \
        | python3 -c "
import sys, json
monitors = json.load(sys.stdin)
edp = [m['name'] for m in monitors if m['name'].startswith('eDP')]
print(edp[0] if edp else 'eDP-1')
" 2>/dev/null || echo "eDP-1"
}

_transform_for() {
    case "$1" in
        normal)     echo 0 ;;
        bottom-up)  echo 2 ;;
        left-up)    echo 1 ;;
        right-up)   echo 3 ;;
        *)          echo 0 ;;
    esac
}

# Read the current scale for a display so we preserve fractional scaling
# when reapplying the monitor keyword with a new transform.
_current_scale() {
    local name="$1"
    hyprctl monitors -j 2>/dev/null \
        | python3 -c "
import sys, json
monitors = json.load(sys.stdin)
m = next((m for m in monitors if m['name'] == sys.argv[1]), None)
print(m['scale'] if m else 'auto')
" "$name" 2>/dev/null || echo "auto"
}

# Apply a transform while preserving the display's current scale.
# hyprctl keyword monitor requires the full spec: NAME,RES,POS,SCALE[,EXTRAS]
# Also updates the touch input transform so touch coordinates follow the rotation.
_apply_transform() {
    local disp="$1" transform="$2"
    local scale
    scale="$(_current_scale "$disp")"
    [[ -z "$scale" ]] && scale="auto"
    hyprctl keyword monitor "$disp,preferred,auto,$scale,transform,$transform" 2>/dev/null || true
    hyprctl keyword input:touchdevice:transform "$transform" 2>/dev/null || true
}

# Wait until hyprctl is reachable (exec-once may fire before the socket is ready).
retries=10
until hyprctl monitors &>/dev/null || (( retries-- == 0 )); do
    sleep 1
done

display="$(_find_edp)"

# Restart monitor-sensor on exit so a crashed iio-sensor-proxy doesn't
# permanently disable auto-rotation.
while true; do
    while IFS= read -r line; do
        if [[ "$line" == *"Accelerometer orientation changed:"* ]]; then
            orientation="${line##*: }"
            orientation="${orientation#"${orientation%%[! ]*}"}"  # ltrim spaces
            transform="$(_transform_for "$orientation")"
            _apply_transform "$display" "$transform"
        fi
    done < <(monitor-sensor 2>/dev/null)
    sleep 2  # back-off before reconnecting
done

#!/usr/bin/env bash
# wvkbd-toggle — toggle wvkbd visibility via SIGUSR1.
# If wvkbd is not running, start it via wvkbd-launcher and immediately reveal it.
set -euo pipefail

LAUNCHER="${HOME}/.local/bin/wvkbd-launcher"

pid="$(pgrep -x wvkbd-mobintl 2>/dev/null || true)"

if [[ -n "$pid" ]]; then
    kill -USR1 "$pid"
else
    if [[ ! -x "$LAUNCHER" ]]; then
        echo "wvkbd-toggle: wvkbd-launcher not found at $LAUNCHER" >&2
        exit 1
    fi
    "$LAUNCHER" &
    # wvkbd-launcher starts wvkbd with --hidden; wait for it to appear then
    # send SIGUSR1 to reveal it so the first tap shows the keyboard immediately.
    deadline=20
    while (( deadline-- > 0 )); do
        sleep 0.05
        new_pid="$(pgrep -x wvkbd-mobintl 2>/dev/null || true)"
        if [[ -n "$new_pid" ]]; then
            kill -USR1 "$new_pid"
            break
        fi
    done
fi

#!/usr/bin/env bash
# wvkbd-toggle — toggle wvkbd visibility.
# wvkbd-mobintl signals: SIGUSR1=hide, SIGUSR2=show.
# Visibility state is tracked in STATE_FILE to drive reliable toggle.
#
# WVKBD_STATE_FILE may be overridden (e.g. in tests).
set -euo pipefail

LAUNCHER="${HOME}/.local/bin/wvkbd-launcher"
STATE_FILE="${WVKBD_STATE_FILE:-${XDG_RUNTIME_DIR:-/tmp}/wvkbd-visible}"

pid="$(pgrep -x -o wvkbd-mobintl 2>/dev/null || true)"

if [[ -z "$pid" ]]; then
    # Not running — start it hidden, then show immediately.
    rm -f "$STATE_FILE"
    if [[ ! -x "$LAUNCHER" ]]; then
        echo "wvkbd-toggle: wvkbd-launcher not found at $LAUNCHER" >&2
        exit 1
    fi
    "$LAUNCHER" &
    # wvkbd-launcher starts wvkbd with --hidden; poll until it appears then
    # send SIGUSR2 to reveal it so the first tap shows the keyboard.
    deadline=20
    while (( deadline-- > 0 )); do
        sleep 0.05
        new_pid="$(pgrep -x -o wvkbd-mobintl 2>/dev/null || true)"
        if [[ -n "$new_pid" ]]; then
            kill -USR2 "$new_pid"
            touch "$STATE_FILE"
            break
        fi
    done
elif [[ -f "$STATE_FILE" ]]; then
    # Running and visible — hide it.
    kill -USR1 "$pid"
    rm -f "$STATE_FILE"
else
    # Running but hidden — show it.
    kill -USR2 "$pid"
    touch "$STATE_FILE"
fi

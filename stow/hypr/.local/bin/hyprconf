#!/usr/bin/env bash
set -euo pipefail

readonly THEME_SCRIPT="$HOME/.config/hypr/scripts/theme-switcher/switch_theme.py"
readonly MONITOR_SCRIPT="$HOME/.config/hypr/scripts/switch_monitor.sh"
readonly DISPLAY_SCRIPT="$HOME/.config/hypr/scripts/toggle-native-display"
readonly SETUP_SCRIPT="$HOME/.hyprconf/setup.sh"
readonly DEPLOY_SCRIPT="$HOME/.hyprconf/infra/deploy.sh"
readonly TEARDOWN_SCRIPT="$HOME/.hyprconf/infra/teardown.sh"

readonly HYPR_LOCAL_OVERRIDES="$HOME/.config/hypr/conf.d/99-hyprconf-local.conf"
readonly HYPR_LOCAL_OVERRIDES_LEGACY="$HOME/.config/hypr/hyprconf.local.conf"

readonly HYPRCONF_CFG_DIR="$HOME/.config/hyprconf"
readonly DEPLOYMENTS_DIR="$HYPRCONF_CFG_DIR/deployments"
readonly TUI_SCRIPT="$HOME/.config/hypr/scripts/hyprconf-tui/main.py"
readonly CLI_LIB="$HOME/.local/lib/hyprconf"

if [[ -t 1 ]]; then
  _b=$'\e[1m'; _c=$'\e[36m'; _g=$'\e[32m'; _y=$'\e[33m'; _r=$'\e[0m'
else
  _b=''; _c=''; _g=''; _y=''; _r=''
fi

die() {
  printf "%s%s%s\n" "${_y}" "$1" "${_r}" >&2
  exit 1
}

usage() {
  printf "${_b}${_c}hyprconf${_r} — hyprland config control centre\n\n"
  printf "${_b}Theme${_r}\n"
  printf "  hyprconf theme                   Interactive TUI picker\n"
  printf "  hyprconf theme <name>            Apply a specific theme\n"
  printf "  hyprconf theme random            Apply a random theme\n"
  printf "  hyprconf theme next / prev       Cycle themes (alphabetical)\n"
  printf "  hyprconf theme current           Show the active theme\n"
  printf "  hyprconf theme list              Pretty colour table of all themes\n"
  printf "  hyprconf theme pick              Select via hyprlauncher\n"
  printf "  hyprconf theme filter <str>      Filter themes in TUI\n"
  printf "\n${_b}Sync / Repair${_r}\n"
  printf "  hyprconf sync                    Pull latest configs and re-stow\n"
  printf "  hyprconf sync --force            Force-reset to remote (discard local divergence)\n"
  printf "  hyprconf sync --full             Re-stow all dotfiles, resetting to repo defaults\n"
  printf "  hyprconf repair                  Scan and fix installation discrepancies\n"
  printf "                                   (stow dir-symlinks, broken links, Python\n"
  printf "                                    imports, monitors.conf)\n"
  printf "\n${_b}Monitor${_r}\n"
  printf "  hyprconf monitor list            List available presets\n"
  printf "  hyprconf monitor set <preset>    Switch to a monitor preset\n"
  printf "  hyprconf monitor <preset>        Shorthand for 'set <preset>'\n"
  printf "  hyprconf monitor config list     Show parsed monitor entries\n"
  printf "  hyprconf monitor config set <name> <res> <pos> <scale>  Edit monitor config\n"
  printf "  hyprconf monitor config delete <name>  Remove monitor entry\n"
  printf "\n${_b}Display${_r}\n"
  printf "  hyprconf display toggle          Toggle built-in screen (eDP-1) on/off\n"
  printf "\n${_b}Deploy${_r}\n"
  printf "  hyprconf deploy                  Deploy/refresh the default (legacy) domain\n"
  printf "                                   Config: ~/.config/hyprconf/infra.env\n"
  printf "  hyprconf deploy list             List configured deployments\n"
  printf "  hyprconf deploy new              Add + deploy an additional domain\n"
  printf "  hyprconf deploy <domain>         Deploy/refresh a previously added domain\n"
  printf "  hyprconf teardown                Destroy all AWS resources created by\n"
  printf "                                   deploy. Requires domain confirmation.\n"
  printf "\n${_b}Hyprland options${_r}\n"
  printf "  hyprconf get <section> [key]     Show current option value(s)\n"
  printf "  hyprconf set <section> <key> <value>  Set option (runtime + persistent)\n"
  printf "  hyprconf configure               Interactive configuration REPL\n"
  printf "  Sections: general  decoration  input  misc  binds  cursor  dwindle  master ...\n"
  printf "  (run 'hyprconf get' with no args to list all sections)\n"
  printf "\n${_b}Keybinds${_r}\n"
  printf "  hyprconf keybind list            Show all keybinds\n"
  printf "  hyprconf keybind add <kind> <mods|-> <key> <dispatcher> [args]\n"
  printf "  hyprconf keybind delete <index>  Remove keybind by list index\n"
  printf "  hyprconf keybind update <index> <kind> <mods|-> <key> <disp> [args]\n"
  printf "\n${_b}Window / Workspace Rules${_r}\n"
  printf "  hyprconf rule window list|add <rule> <filter>|delete <index>\n"
  printf "  hyprconf rule workspace list|add <id> <options>|delete <index>\n"
  printf "\n${_b}hyprlock${_r}\n"
  printf "  hyprconf lock list               Show all hyprlock blocks\n"
  printf "  hyprconf lock add <type>         Add a block (general|background|label|input-field|shape)\n"
  printf "  hyprconf lock delete <index>     Delete a block by index\n"
  printf "  hyprconf lock set <index> <key> <value>  Edit a field within a block\n"
  printf "\n${_b}hypridle${_r}\n"
  printf "  hyprconf idle list               Show all hypridle blocks\n"
  printf "  hyprconf idle add <type>         Add a block (general|listener)\n"
  printf "  hyprconf idle delete <index>     Delete a block by index\n"
  printf "  hyprconf idle set <index> <key> <value>  Edit a field within a block\n"
  printf "\n${_b}hyprpaper${_r}\n"
  printf "  hyprconf paper list              Show all hyprpaper config\n"
  printf "  hyprconf paper set-wallpaper <monitor|-> <path>  Set wallpaper for monitor\n"
  printf "  hyprconf paper add-preload <path>   Add a preload entry\n"
  printf "  hyprconf paper delete-preload <index>  Remove a preload entry\n"
  printf "  hyprconf paper delete-wallpaper <index>  Remove a wallpaper entry\n"
  printf "  hyprconf paper setting <key> <value>  Set splash, ipc, or a variable\n"
  printf "\n${_b}TUI${_r}\n"
  printf "  hyprconf tui                     Full Textual TUI configuration suite\n"
  printf "  hyprconf tui --section <sec>     Open TUI at a specific section\n"
  printf "  hyprconf tui --slim              Slim single-section view\n"
  printf "\n${_b}Config${_r}\n"
  printf "  hyprconf set mainMod <KEY...>    Set \$mainMod (e.g. SUPER, ALT, CTRL)\n"
  printf "\n${_b}Show${_r}\n"
  printf "  hyprconf show keybinds           Pretty table of keybinds from config\n"
  printf "\n${_b}Schema / AI interface${_r}\n"
  printf "  hyprconf schema dump             Dump full schema as JSON\n"
  printf "  hyprconf schema validate         Validate all section keys are known\n"
  printf "  hyprconf schema list-sections    List all known section names\n"
  printf "  hyprconf schema keys <section>   List keys in a section\n"
  printf "\n${_b}Auto-detect${_r}\n"
  printf "  hyprconf autodetect              Detect and migrate existing Hyprland config\n"
  printf "\n${_b}Hardware${_r}\n"
  printf "  hyprconf hardware status         Show detected hardware and daemon status\n"
  printf "  hyprconf hardware osk [on|off|toggle]  Control on-screen keyboard (wvkbd)\n"
  printf "  hyprconf hardware rotate [on|off]      Control auto-rotation (autorotate)\n"
  printf "\n${_b}Addons${_r}\n"
  printf "  hyprconf addon                   List available addons and their status\n"
  printf "  hyprconf addon <name>            Install a named addon\n"
  printf "  Available: dev  (full test-suite deps + GitHub Copilot CLI)\n"
  printf "\n${_b}Developer${_r}\n"
  printf "  hyprconf dev                     Show developer pipeline commands\n"
  printf "  hyprconf dev test [--unit|--integration|--tui|--vm|--install|--all]\n"
  printf "  hyprconf dev vm [start|stop|stop-all|build|status]\n"
  printf "  hyprconf dev publish             Full pipeline: tests → deploy → stable promote\n"
  printf "\n${_b}General${_r}\n"
  printf "  hyprconf doctor                  System health check (packages, services, configs)\n"
  printf "  hyprconf clipboard [fzf|rofi|wipe]  Clipboard history picker\n"
  printf "  hyprconf screenshot [region|window|full|edit]  Screen capture\n"
  printf "  hyprconf gamemode [on|off|toggle|status]  Toggle performance mode\n"
  printf "  hyprconf power [lock|logout|suspend|reboot|shutdown]  Power menu\n"
  printf "  hyprconf help                    Show this message\n"
}

cmd_theme() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    "")       python3 "$THEME_SCRIPT" ;;
    random)   python3 "$THEME_SCRIPT" --random ;;
    list)     python3 "$THEME_SCRIPT" --list ;;
    next)     python3 "$THEME_SCRIPT" --next ;;
    prev)     python3 "$THEME_SCRIPT" --prev ;;
    current)  python3 "$THEME_SCRIPT" --current ;;
    pick)     python3 "$THEME_SCRIPT" --pick ;;
    filter)   python3 "$THEME_SCRIPT" --filter "${1:-}" ;;
    set)      python3 "$THEME_SCRIPT" "${1:?Usage: hyprconf theme set <name>}" ;;
    *)        python3 "$THEME_SCRIPT" "$sub" ;;
  esac
}

cmd_sync() {
  "$SETUP_SCRIPT" --sync "$@"
}

cmd_repair() {
  "$SETUP_SCRIPT" --repair
}

cmd_monitor() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list)
      printf "${_b}Available monitor presets:${_r}\n"
      for f in "$HOME/.config/hypr/pcMonitors."*; do
        [[ -e "$f" ]] || continue
        local base; base="$(basename "$f")"
        [[ "$base" == "pcMonitors.conf" ]] && continue
        printf '  %s\n' "${base#pcMonitors.}"
      done | sort
      ;;
    set)
      "$MONITOR_SCRIPT" "${1:?Usage: hyprconf monitor set <preset>}"
      ;;
    config)
      python3 "$CLI_LIB/cli.py" monitor "$@"
      ;;
    *)
      "$MONITOR_SCRIPT" "$sub"
      ;;
  esac
}

cmd_display() {
  local sub="${1:-toggle}"
  case "$sub" in
    toggle) "$DISPLAY_SCRIPT" ;;
    *) printf "${_y}Unknown display command: %s${_r}\n" "$sub" >&2; exit 1 ;;
  esac
}

_extract_domain_from_env() {
  local env_file="$1"
  [[ -f "$env_file" ]] || return 1
  grep -E '^export HYPRCONF_DOMAIN=' "$env_file" 2>/dev/null \
    | head -1 \
    | sed -E 's/^export HYPRCONF_DOMAIN="?([^\"]*)"?$/\1/' \
    | tr -d '\n'
}

_deploy_status_from_state() {
  local state_file="$1"
  [[ -f "$state_file" ]] || { printf 'configured'; return 0; }
  grep -q '^DISTRIBUTION_ID=' "$state_file" 2>/dev/null && { printf 'deployed'; return 0; }
  printf 'configured'
}

cmd_deploy_list() {
  printf "${_b}Configured deployments:${_r}\n"

  local any=0

  local legacy_cfg="$HYPRCONF_CFG_DIR/infra.env"
  local legacy_state="$HYPRCONF_CFG_DIR/deploy-state"
  if [[ -f "$legacy_cfg" ]]; then
    local domain; domain="$(_extract_domain_from_env "$legacy_cfg" || true)"
    [[ -z "$domain" ]] && domain='(unknown)'
    printf '  %s  (%s, legacy)\n' "$domain" "$(_deploy_status_from_state "$legacy_state")"
    any=1
  fi

  if [[ -d "$DEPLOYMENTS_DIR" ]]; then
    local dir
    for dir in "$DEPLOYMENTS_DIR"/*; do
      [[ -d "$dir" ]] || continue
      local cfg="$dir/infra.env"
      local state="$dir/deploy-state"
      local name; name="$(basename "$dir")"
      if [[ -f "$cfg" ]]; then
        local domain; domain="$(_extract_domain_from_env "$cfg" || true)"
        [[ -z "$domain" ]] && domain="$name"
        printf '  %s  (%s)\n' "$domain" "$(_deploy_status_from_state "$state")"
      else
        printf '  %s  (incomplete — missing infra.env)\n' "$name"
      fi
      any=1
    done
  fi

  [[ $any -eq 1 ]] || printf '  (none)\n'
}

_validate_domain() {
  local domain="$1"
  [[ -n "$domain" ]] || return 1
  [[ "$domain" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
  [[ "$domain" == *.* ]] || return 1
  return 0
}

cmd_deploy_new() {
  local domain="${1:-}"

  if [[ -z "$domain" ]]; then
    [[ -t 0 ]] || die "Usage: hyprconf deploy new  (interactive; requires a TTY)"
    printf "%sNew domain%s (e.g. get.example.com): " "${_b}" "${_r}"
    read -r domain
  fi

  _validate_domain "$domain" || die "Invalid domain: $domain"

  local dir="$DEPLOYMENTS_DIR/$domain"
  local cfg="$dir/infra.env"
  local state="$dir/deploy-state"

  if [[ -e "$cfg" ]]; then
    die "Deployment already exists for $domain. Use: hyprconf deploy $domain"
  fi

  mkdir -p "$dir"

  HYPRCONF_DOMAIN="$domain" \
  HYPRCONF_INFRA_CFG_FILE="$cfg" \
  HYPRCONF_INFRA_STATE_FILE="$state" \
    bash "$DEPLOY_SCRIPT"
}

cmd_deploy_domain() {
  local domain="$1"
  _validate_domain "$domain" || die "Invalid domain: $domain"

  local dir="$DEPLOYMENTS_DIR/$domain"
  local cfg="$dir/infra.env"
  local state="$dir/deploy-state"

  [[ -f "$cfg" ]] || die "No deployment found for $domain. Create it first: hyprconf deploy new"

  HYPRCONF_INFRA_CFG_FILE="$cfg" \
  HYPRCONF_INFRA_STATE_FILE="$state" \
    bash "$DEPLOY_SCRIPT"
}

cmd_deploy() {
  local sub="${1:-}"
  shift || true

  case "$sub" in
    "")
      bash "$DEPLOY_SCRIPT" "$@"
      ;;
    list)
      cmd_deploy_list
      ;;
    new)
      cmd_deploy_new "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      cmd_deploy_domain "$sub"
      ;;
  esac
}

_maybe_reload_hyprland() {
  command -v hyprctl &>/dev/null || return 0
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  hyprctl reload &>/dev/null || true
}

cmd_set_mainmod() {
  local raw="${*:-}"
  [[ -n "$raw" ]] || die "Usage: hyprconf set mainMod <KEY...>"

  # Accept: ALT / SUPER / CTRL / SHIFT, plus combos like "SUPER ALT".
  raw="${raw^^}"
  raw="${raw//+/ }"
  raw="${raw//_/ }"
  raw="$(printf '%s' "$raw" | tr -s ' ' | sed -E 's/^ +//; s/ +$//')"

  local token
  for token in $raw; do
    case "$token" in
      SUPER|ALT|CTRL|SHIFT) ;;
      *) die "Invalid modifier token: $token (allowed: SUPER ALT CTRL SHIFT)" ;;
    esac
  done

  mkdir -p "$HOME/.config/hypr/conf.d"

  # Migrate legacy single-file overrides if present.
  if [[ -f "$HYPR_LOCAL_OVERRIDES_LEGACY" && ! -f "$HYPR_LOCAL_OVERRIDES" ]]; then
    cp -f "$HYPR_LOCAL_OVERRIDES_LEGACY" "$HYPR_LOCAL_OVERRIDES"
  fi

  touch "$HYPR_LOCAL_OVERRIDES"

  if grep -qE '^\$mainMod[[:space:]]*=' "$HYPR_LOCAL_OVERRIDES" 2>/dev/null; then
    sed -i 's|^\$mainMod[[:space:]]*=.*|$mainMod = '"$raw"'|' "$HYPR_LOCAL_OVERRIDES"
  else
    printf '\n$mainMod = %s\n' "$raw" >> "$HYPR_LOCAL_OVERRIDES"
  fi

  _maybe_reload_hyprland
  printf "${_b}mainMod${_r} set to ${_c}%s${_r}\n" "$raw"
}

cmd_set() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    mainMod|mainmod) cmd_set_mainmod "$@" ;;
    -h|--help|help|"") die "Usage: hyprconf set mainMod <KEY...>\n       hyprconf set <section> <key> <value>" ;;
    # section key value  (three-arg form routes to cmd_set_keyword)
    *) cmd_set_keyword "$sub" "$@" ;;
  esac
}

_trim() {
  local s="$1"
  s="${s#${s%%[![:space:]]*}}"
  s="${s%${s##*[![:space:]]}}"
  printf '%s' "$s"
}

_strip_comment() {
  # Remove trailing comments like: "...  # comment"
  # (does not attempt to parse quotes)
  local s="$1"
  printf '%s' "$s" | sed -E 's/(^|[[:space:]])#.*$//'
}

_find_keybinds_conf() {
  local cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  local kb="$cfg_home/hypr/keybinds.conf"
  if [[ -f "$kb" ]]; then
    printf '%s' "$kb"
    return 0
  fi

  local fallback="$HOME/.hyprconf/stow/hypr/.config/hypr/keybinds.conf"
  [[ -f "$fallback" ]] || return 1
  printf '%s' "$fallback"
}

cmd_show_keybinds() {
  local keybinds
  keybinds="$(_find_keybinds_conf)" || die "Could not find keybinds.conf at ~/.config/hypr/keybinds.conf"

  declare -A vars=()
  declare -A visited=()
  local -a binds=()

  _expand_known_vars() {
    local s="$1"
    local pass
    for pass in 1 2; do
      local k
      for k in "${!vars[@]}"; do
        s="${s//\$$k/${vars[$k]}}"
      done
    done
    printf '%s' "$s"
  }

  _read_conf_recursive() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    [[ -z "${visited[$file]+x}" ]] || return 0
    visited["$file"]=1

    local line lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
      lineno=$(( lineno + 1 ))
      line="$(_strip_comment "$line")"
      line="$(_trim "$line")"
      [[ -n "$line" ]] || continue

      if [[ "$line" =~ ^\$([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local k="${BASH_REMATCH[1]}"
        local v
        v="$(_trim "${BASH_REMATCH[2]}")"
        vars["$k"]="$v"
        continue
      fi

      if [[ "$line" =~ ^source[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local src
        src="$(_trim "${BASH_REMATCH[1]}")"
        src="${src%\"}"; src="${src#\"}"
        src="${src#\'}"; src="${src%\'}"

        src="${src/#\~/$HOME}"
        src="${src//\$HOME/$HOME}"
        src="${src//\${HOME}/$HOME}"

        local -a src_files=()
        local had_nullglob=0
        shopt -q nullglob && had_nullglob=1
        shopt -s nullglob
        # shellcheck disable=SC2206
        src_files=( $src )
        (( had_nullglob == 1 )) || shopt -u nullglob

        local f
        for f in "${src_files[@]}"; do
          _read_conf_recursive "$f"
        done
        continue
      fi

      if [[ "$line" =~ ^(bind[a-z]*)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local kind="${BASH_REMATCH[1]}"
        local payload
        payload="$(_trim "${BASH_REMATCH[2]}")"
        binds+=("$kind|$payload")
      fi
    done < "$file"
  }

  _read_conf_recursive "$keybinds"

  if (( ${#binds[@]} == 0 )); then
    die "No keybinds found in $keybinds"
  fi

  local mainmod="${vars[mainMod]:-${vars[mainmod]:-}}"

  printf "${_b}Keybinds${_r} (%s)" "$keybinds"
  if [[ -n "${mainmod:-}" ]]; then
    printf " — ${_b}\$mainMod${_r}=%s\n\n" "$mainmod"
  else
    printf "\n\n"
  fi

  {
    printf 'TYPE\tMODS\tKEY\tDISPATCH\tARG\n'
    local row
    for row in "${binds[@]}"; do
      local kind payload
      kind="${row%%|*}"
      payload="${row#*|}"

      local -a parts
      IFS=',' read -r -a parts <<<"$payload"

      local mods key dispatch arg
      mods="$(_trim "${parts[0]:-}")"
      key="$(_trim "${parts[1]:-}")"
      dispatch="$(_trim "${parts[2]:-}")"

      if (( ${#parts[@]} > 3 )); then
        arg="${parts[3]}"
        local i
        for (( i=4; i<${#parts[@]}; i++ )); do
          arg+=",${parts[$i]}"
        done
        arg="$(_trim "$arg")"
      else
        arg=""
      fi

      mods="$(_expand_known_vars "$mods")"
      key="$(_expand_known_vars "$key")"
      dispatch="$(_expand_known_vars "$dispatch")"
      arg="$(_expand_known_vars "$arg")"

      mods="$(_trim "$mods")"
      [[ -z "$mods" ]] && mods='-'
      mods="${mods// /+}"

      printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$mods" "$key" "$dispatch" "$arg"
    done
  } | {
    if command -v python3 &>/dev/null; then
      python3 -c '
import sys
lines = [l.rstrip("\n") for l in sys.stdin if l.strip()]
if not lines:
  raise SystemExit(0)
rows = [ln.split("\t") for ln in lines]
cols = max(len(r) for r in rows)
for r in rows:
  r.extend([""] * (cols - len(r)))
widths = [0] * cols
for r in rows:
  for i, c in enumerate(r):
    widths[i] = max(widths[i], len(c))

def hline(left, mid, right, ch="─"):
  return left + mid.join(ch * (w + 2) for w in widths) + right

def rowline(r):
  return "│" + "│".join(f" {c.ljust(widths[i])} " for i, c in enumerate(r)) + "│"

top = hline("┌", "┬", "┐")
sep = hline("├", "┼", "┤")
bot = hline("└", "┴", "┘")
out = [top, rowline(rows[0])]
if len(rows) > 1:
  out.append(sep)
  out.extend(rowline(r) for r in rows[1:])
out.append(bot)
sys.stdout.write("\n".join(out) + "\n")
'
    elif command -v column &>/dev/null; then
      column -t -s $'\t'
    else
      cat
    fi
  }
}

cmd_show() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    keybinds|keys|binds) cmd_show_keybinds "$@" ;;
    -h|--help|help|"") die "Usage: hyprconf show keybinds" ;;
    *) die "Unknown show target: $sub" ;;
  esac
}

cmd_teardown() {
  bash "$TEARDOWN_SCRIPT" "$@"
}

# ════════════════════════════════════════════════════════════════════════════
#  OPTION SCHEMA
#  Each option: "type|default|description"
#  Types: int  float  bool  str  color  gradient  vec2  enum:<val1,val2,...>
# ════════════════════════════════════════════════════════════════════════════

# Return "type|default|description" for a given section:key, empty if unknown.
_option_meta() {
  case "$1:$2" in
    # general
    general:border_size)              echo "int|1|Border size around windows (px)" ;;
    general:gaps_in)                  echo "int|5|Gap between windows" ;;
    general:gaps_out)                 echo "int|20|Gap between windows and monitor edges" ;;
    general:float_gaps)               echo "int|0|Gap for floating windows (-1 = use gaps_out)" ;;
    general:gaps_workspaces)          echo "int|0|Gap between workspaces (stacks with gaps_out)" ;;
    general:col.inactive_border)      echo "gradient|0xff444444|Inactive window border color" ;;
    general:col.active_border)        echo "gradient|0xffffffff|Active window border color" ;;
    general:col.nogroup_border)       echo "gradient|0xffffaaff|Ungroupable window inactive border" ;;
    general:col.nogroup_border_active) echo "gradient|0xffff00ff|Ungroupable window active border" ;;
    general:layout)                   echo "enum:dwindle,master,scrolling,monocle|dwindle|Active layout" ;;
    general:no_focus_fallback)        echo "bool|false|Do not fall back to next window on focus loss" ;;
    general:resize_on_border)         echo "bool|false|Allow resizing by dragging borders/gaps" ;;
    general:extend_border_grab_area)  echo "int|15|Extra grab area around border (requires resize_on_border)" ;;
    general:hover_icon_on_border)     echo "bool|true|Show resize cursor when hovering border" ;;
    general:allow_tearing)            echo "bool|false|Master switch for allowing screen tearing" ;;
    general:resize_corner)            echo "int|0|Force resize from a corner (1-4 clockwise, 0=off)" ;;

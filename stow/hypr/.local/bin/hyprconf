#!/usr/bin/env bash
set -euo pipefail

# hyprconf — launches the Textual TUI, the single configuration surface.
# (The former multi-command CLI dispatcher was removed; standalone tools
# keep their own entry points: hyprconf-vpn, hyprconf-secureboot,
# yubikey-fido2-setup, gpu-passthrough.sh, switch_theme.py, setup.sh --sync.)

readonly TUI_SCRIPT="$HOME/.config/hypr/scripts/hyprconf-tui/main.py"

if [[ ! -f "$TUI_SCRIPT" ]]; then
  printf 'hyprconf: TUI not found at %s\nRe-run setup.sh from the hyprconf repo to restow it.\n' \
    "$TUI_SCRIPT" >&2
  exit 1
fi

if ! command -v python3 &>/dev/null; then
  printf 'hyprconf: python3 is required for the TUI\n' >&2
  exit 1
fi

if ! python3 -c "import textual" &>/dev/null; then
  printf 'hyprconf: python-textual is not installed.\nInstall with: sudo pacman -S python-textual\n' >&2
  exit 1
fi

exec python3 "$TUI_SCRIPT" "$@"

cmd_theme() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    "")       python3 "$THEME_SCRIPT" ;;
    random)   python3 "$THEME_SCRIPT" --random ;;
    list)     python3 "$THEME_SCRIPT" --list ;;
    next)     python3 "$THEME_SCRIPT" --next ;;
    prev)     python3 "$THEME_SCRIPT" --prev ;;
    current)  python3 "$THEME_SCRIPT" --current ;;
    pick)     python3 "$THEME_SCRIPT" --pick ;;
    filter)   python3 "$THEME_SCRIPT" --filter "${1:-}" ;;
    generate) python3 "$THEME_SCRIPT" --generate "${1:?Usage: hyprconf theme generate <image>}" ;;
    set)      python3 "$THEME_SCRIPT" "${1:?Usage: hyprconf theme set <name>}" ;;
    *)        python3 "$THEME_SCRIPT" "$sub" ;;
  esac
}

cmd_sync() {
  "$SETUP_SCRIPT" --sync "$@"
}

cmd_repair() {
  "$SETUP_SCRIPT" --repair
}

cmd_monitor() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list)
      printf "${_b}Available monitor presets:${_r}\n"
      for f in "$HOME/.config/hypr/pcMonitors."*; do
        [[ -e "$f" ]] || continue
        local base; base="$(basename "$f")"
        [[ "$base" == "pcMonitors.conf" ]] && continue
        printf '  %s\n' "${base#pcMonitors.}"
      done | sort
      ;;
    set)
      "$MONITOR_SCRIPT" "${1:?Usage: hyprconf monitor set <preset>}"
      ;;
    config)
      python3 "$CLI_LIB/cli.py" monitor "$@"
      ;;
    *)
      "$MONITOR_SCRIPT" "$sub"
      ;;
  esac
}

cmd_display() {
  local sub="${1:-toggle}"
  case "$sub" in
    toggle) "$DISPLAY_SCRIPT" ;;
    *) printf "${_y}Unknown display command: %s${_r}\n" "$sub" >&2; exit 1 ;;
  esac
}

_maybe_reload_hyprland() {
  command -v hyprctl &>/dev/null || return 0
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
  hyprctl reload &>/dev/null || true
}

cmd_set_mainmod() {
  local raw="${*:-}"
  [[ -n "$raw" ]] || die "Usage: hyprconf set mainMod <KEY...>"

  # Accept: ALT / SUPER / CTRL / SHIFT, plus combos like "SUPER ALT".
  raw="${raw^^}"
  raw="${raw//+/ }"
  raw="${raw//_/ }"
  raw="$(printf '%s' "$raw" | tr -s ' ' | sed -E 's/^ +//; s/ +$//')"

  local token
  for token in $raw; do
    case "$token" in
      SUPER|ALT|CTRL|SHIFT) ;;
      *) die "Invalid modifier token: $token (allowed: SUPER ALT CTRL SHIFT)" ;;
    esac
  done

  mkdir -p "$HOME/.config/hypr/conf.d"

  # Migrate legacy single-file overrides if present.
  if [[ -f "$HYPR_LOCAL_OVERRIDES_LEGACY" && ! -f "$HYPR_LOCAL_OVERRIDES" ]]; then
    cp -f "$HYPR_LOCAL_OVERRIDES_LEGACY" "$HYPR_LOCAL_OVERRIDES"
  fi

  touch "$HYPR_LOCAL_OVERRIDES"

  if grep -qE '^\$mainMod[[:space:]]*=' "$HYPR_LOCAL_OVERRIDES" 2>/dev/null; then
    sed -i 's|^\$mainMod[[:space:]]*=.*|$mainMod = '"$raw"'|' "$HYPR_LOCAL_OVERRIDES"
  else
    printf '\n$mainMod = %s\n' "$raw" >> "$HYPR_LOCAL_OVERRIDES"
  fi

  _maybe_reload_hyprland
  printf "${_b}mainMod${_r} set to ${_c}%s${_r}\n" "$raw"
}

cmd_set() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    mainMod|mainmod) cmd_set_mainmod "$@" ;;
    -h|--help|help|"") die "Usage: hyprconf set mainMod <KEY...>\n       hyprconf set <section> <key> <value>" ;;
    monitors)
      # set monitors <name> <field> <value…>  → the monitor backend
      [[ -n "${1:-}" && -n "${2:-}" && -n "${3:-}" ]] \
        || die "Usage: hyprconf set monitors <name> <field> <value>"
      python3 "$CLI_LIB/cli.py" monitor field set "$1" "$2" "${*:3}"
      ;;
    # <section> <key> <value…>  → the tested Python backend (cli.py)
    *) python3 "$CLI_LIB/cli.py" set "$sub" "$@" ;;
  esac
}

_trim() {
  local s="$1"
  s="${s#${s%%[![:space:]]*}}"
  s="${s%${s##*[![:space:]]}}"
  printf '%s' "$s"
}

_strip_comment() {
  # Remove trailing comments like: "...  # comment"
  # (does not attempt to parse quotes)
  local s="$1"
  printf '%s' "$s" | sed -E 's/(^|[[:space:]])#.*$//'
}

_find_keybinds_conf() {
  local cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  local kb="$cfg_home/hypr/keybinds.conf"
  if [[ -f "$kb" ]]; then
    printf '%s' "$kb"
    return 0
  fi

  local fallback="$HOME/.hyprconf/stow/hypr/.config/hypr/keybinds.conf"
  [[ -f "$fallback" ]] || return 1
  printf '%s' "$fallback"
}

cmd_show_keybinds() {
  local keybinds
  keybinds="$(_find_keybinds_conf)" || die "Could not find keybinds.conf at ~/.config/hypr/keybinds.conf"

  declare -A vars=()
  declare -A visited=()
  local -a binds=()

  _expand_known_vars() {
    local s="$1"
    for _ in 1 2; do
      local k
      for k in "${!vars[@]}"; do
        s="${s//\$$k/${vars[$k]}}"
      done
    done
    printf '%s' "$s"
  }

  _read_conf_recursive() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    [[ -z "${visited[$file]+x}" ]] || return 0
    visited["$file"]=1

    local line lineno=0
    while IFS= read -r line || [[ -n "$line" ]]; do
      lineno=$(( lineno + 1 ))
      line="$(_strip_comment "$line")"
      line="$(_trim "$line")"
      [[ -n "$line" ]] || continue

      if [[ "$line" =~ ^\$([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local k="${BASH_REMATCH[1]}"
        local v
        v="$(_trim "${BASH_REMATCH[2]}")"
        vars["$k"]="$v"
        continue
      fi

      if [[ "$line" =~ ^source[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local src
        src="$(_trim "${BASH_REMATCH[1]}")"
        src="${src%\"}"; src="${src#\"}"
        src="${src#\'}"; src="${src%\'}"

        src="${src/#\~/$HOME}"
        src="${src//\$HOME/$HOME}"
        src="${src//\${HOME}/$HOME}"

        local -a src_files=()
        local had_nullglob=0
        shopt -q nullglob && had_nullglob=1
        shopt -s nullglob
        # shellcheck disable=SC2206
        src_files=( $src )
        (( had_nullglob == 1 )) || shopt -u nullglob

        local f
        for f in "${src_files[@]}"; do
          _read_conf_recursive "$f"
        done
        continue
      fi

      if [[ "$line" =~ ^(bind[a-z]*)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
        local kind="${BASH_REMATCH[1]}"
        local payload
        payload="$(_trim "${BASH_REMATCH[2]}")"
        binds+=("$kind|$payload")
      fi
    done < "$file"
  }

  _read_conf_recursive "$keybinds"

  if (( ${#binds[@]} == 0 )); then
    die "No keybinds found in $keybinds"
  fi

  local mainmod="${vars[mainMod]:-${vars[mainmod]:-}}"

  printf "${_b}Keybinds${_r} (%s)" "$keybinds"
  if [[ -n "${mainmod:-}" ]]; then
    printf " — ${_b}\$mainMod${_r}=%s\n\n" "$mainmod"
  else
    printf "\n\n"
  fi

  {
    printf 'TYPE\tMODS\tKEY\tDISPATCH\tARG\n'
    local row
    for row in "${binds[@]}"; do
      local kind payload
      kind="${row%%|*}"
      payload="${row#*|}"

      local -a parts
      IFS=',' read -r -a parts <<<"$payload"

      local mods key dispatch arg
      mods="$(_trim "${parts[0]:-}")"
      key="$(_trim "${parts[1]:-}")"
      dispatch="$(_trim "${parts[2]:-}")"

      if (( ${#parts[@]} > 3 )); then
        arg="${parts[3]}"
        local i
        for (( i=4; i<${#parts[@]}; i++ )); do
          arg+=",${parts[$i]}"
        done
        arg="$(_trim "$arg")"
      else
        arg=""
      fi

      mods="$(_expand_known_vars "$mods")"
      key="$(_expand_known_vars "$key")"
      dispatch="$(_expand_known_vars "$dispatch")"
      arg="$(_expand_known_vars "$arg")"

      mods="$(_trim "$mods")"
      [[ -z "$mods" ]] && mods='-'
      mods="${mods// /+}"

      printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$mods" "$key" "$dispatch" "$arg"
    done
  } | {
    if command -v python3 &>/dev/null; then
      python3 -c '
import sys
lines = [l.rstrip("\n") for l in sys.stdin if l.strip()]
if not lines:
  raise SystemExit(0)
rows = [ln.split("\t") for ln in lines]
cols = max(len(r) for r in rows)
for r in rows:
  r.extend([""] * (cols - len(r)))
widths = [0] * cols
for r in rows:
  for i, c in enumerate(r):
    widths[i] = max(widths[i], len(c))

def hline(left, mid, right, ch="─"):
  return left + mid.join(ch * (w + 2) for w in widths) + right

def rowline(r):
  return "│" + "│".join(f" {c.ljust(widths[i])} " for i, c in enumerate(r)) + "│"

top = hline("┌", "┬", "┐")
sep = hline("├", "┼", "┤")
bot = hline("└", "┴", "┘")
out = [top, rowline(rows[0])]
if len(rows) > 1:
  out.append(sep)
  out.extend(rowline(r) for r in rows[1:])
out.append(bot)
sys.stdout.write("\n".join(out) + "\n")
'
    elif command -v column &>/dev/null; then
      column -t -s $'\t'
    else
      cat
    fi
  }
}

cmd_show() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    keybind|keybinds|keys|binds)
      cmd_show_keybinds "$@"
      ;;
    -h|--help|help|"") die "Usage: hyprconf show keybind" ;;
    *) die "Unknown show target: $sub" ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf get / configure  — thin wrappers over the tested Python backend
#  (cli.py). The option schema, value reading, and the configure REPL now live
#  in the Python library (single source of truth); bash just dispatches. The
#  `set` keyword path is handled in cmd_set (above).
# ════════════════════════════════════════════════════════════════════════════

cmd_get() {
  if [[ "${1:-}" == "monitors" ]]; then
    python3 "$CLI_LIB/cli.py" monitor field show ${2:+"$2"}
  else
    python3 "$CLI_LIB/cli.py" get "$@"
  fi
}

cmd_configure() {
  python3 "$CLI_LIB/cli.py" configure
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf tui  — launch Python Textual TUI
# ════════════════════════════════════════════════════════════════════════════

cmd_tui() {
  if [[ ! -f "$TUI_SCRIPT" ]]; then
    die "TUI script not found at $TUI_SCRIPT\nRe-run the hyprconf install script to install it:\n  curl -fsSL https://raw.githubusercontent.com/ak4dev/.hyprconf/stable/install/install.sh | bash"
  fi

  if ! command -v python3 &>/dev/null; then
    die "python3 is required for the TUI"
  fi

  if ! python3 -c "import textual" &>/dev/null; then
    die "python-textual is not installed.\nInstall with: sudo pacman -S python-textual"
  fi

  exec python3 "$TUI_SCRIPT" "$@"
}

cmd_schema() {
  python3 "$CLI_LIB/cli.py" schema "$@"
}

cmd_autodetect() {
  python3 "$CLI_LIB/cli.py" autodetect "$@"
}

cmd_keybind() {
  python3 "$CLI_LIB/cli.py" keybind "$@"
}

cmd_rule() {
  python3 "$CLI_LIB/cli.py" rule "$@"
}

cmd_lock() {
  python3 "$CLI_LIB/cli.py" lock "$@"
}

cmd_idle() {
  python3 "$CLI_LIB/cli.py" idle "$@"
}

cmd_paper() {
  python3 "$CLI_LIB/cli.py" paper "$@"
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf hardware — touchscreen OSK and auto-rotation control
# ════════════════════════════════════════════════════════════════════════════

_hw_has_touchscreen() {
  # Standard udev-tagged touchscreens (ELAN HID, etc.)
  grep -rql "^ID_INPUT_TOUCHSCREEN=1" /sys/class/input/*/device/uevent 2>/dev/null \
    && return 0
  # Generic touch devices (e.g. ASUS ROG Ally, AMD-based handhelds) that use
  # ID_INPUT_TOUCH=1 instead of ID_INPUT_TOUCHSCREEN.
  grep -rql "^ID_INPUT_TOUCH=1" /sys/class/input/*/device/uevent 2>/dev/null \
    && return 0
  # Wacom I2C pen+touch digitizers (e.g. ThinkPad X13 Yoga): touch component is
  # named "Wacom HID * Finger" on an i2c bus, but udev never sets
  # ID_INPUT_TOUCHSCREEN=1 because the wacom driver bypasses generic HID rules.
  # Requiring PHYS="i2c-" prevents false-positives from external USB Wacom tablets.
  local _f
  for _f in /sys/class/input/*/device/uevent; do
    grep -q '^NAME="Wacom.*Finger' "$_f" 2>/dev/null \
      && grep -q '^PHYS="i2c-' "$_f" 2>/dev/null \
      && return 0
  done
  return 1
}

_hw_has_accelerometer() {
  compgen -G "/sys/bus/iio/devices/*/in_accel_x_raw" > /dev/null 2>&1
}

_hw_osk_running() {
  pgrep -x wvkbd-mobintl > /dev/null 2>&1
}

_hw_rotate_running() {
  pgrep -x autorotate > /dev/null 2>&1
}

cmd_hardware() {
  local sub="${1:-status}"
  shift || true

  case "$sub" in
    status)
      printf "${_b}Hardware detection${_r}\n"
      _hw_has_touchscreen  \
        && printf "  Touchscreen      ${_g}detected${_r}\n" \
        || printf "  Touchscreen      ${_y}not detected${_r}\n"
      _hw_has_accelerometer \
        && printf "  Accelerometer    ${_g}detected${_r}\n" \
        || printf "  Accelerometer    ${_y}not detected${_r}\n"
      printf "\n${_b}Daemons${_r}\n"
      command -v wvkbd-mobintl &>/dev/null \
        && printf "  wvkbd-mobintl    installed\n" \
        || printf "  wvkbd-mobintl    ${_y}not installed${_r}\n"
      _hw_osk_running \
        && printf "  wvkbd (OSK)      ${_g}running${_r}\n" \
        || printf "  wvkbd (OSK)      stopped\n"
      command -v autorotate &>/dev/null \
        && printf "  autorotate       installed\n" \
        || printf "  autorotate       ${_y}not installed${_r}\n"
      _hw_rotate_running \
        && printf "  autorotate       ${_g}running${_r}\n" \
        || printf "  autorotate       stopped\n"
      if command -v iio-sensor-proxy &>/dev/null \
          || systemctl --quiet is-active iio-sensor-proxy.service 2>/dev/null; then
        printf "  iio-sensor-proxy ${_g}active${_r}\n"
      else
        printf "  iio-sensor-proxy stopped\n"
      fi
      ;;

    osk)
      local action="${1:-toggle}"
      case "$action" in
        on)
          if _hw_osk_running; then
            printf "OSK already running.\n"
          else
            wvkbd-launcher &
            disown
            printf "${_g}OSK started.${_r}\n"
          fi
          ;;
        off)
          local _osk_pid _osk_killed=0
          while read -r _osk_pid; do
            kill "$_osk_pid" 2>/dev/null && _osk_killed=1
          done < <(pgrep -x wvkbd-mobintl 2>/dev/null || true)
          if (( _osk_killed )); then
            printf "${_g}OSK stopped.${_r}\n"
          else
            printf "OSK is not running.\n"
          fi
          ;;
        toggle)
          wvkbd-toggle
          ;;
        *)
          printf "${_y}Usage: hyprconf hardware osk [on|off|toggle]${_r}\n" >&2
          exit 1
          ;;
      esac
      ;;

    rotate)
      local action="${1:-}"
      case "$action" in
        on)
          if _hw_rotate_running; then
            printf "autorotate already running.\n"
          else
            autorotate &
            disown
            printf "${_g}Auto-rotation started.${_r}\n"
          fi
          ;;
        off)
          local _rot_pid _rot_killed=0
          while read -r _rot_pid; do
            kill "$_rot_pid" 2>/dev/null && _rot_killed=1
          done < <(pgrep -x autorotate 2>/dev/null || true)
          if (( _rot_killed )); then
            printf "${_g}Auto-rotation stopped.${_r}\n"
          else
            printf "autorotate is not running.\n"
          fi
          ;;
        *)
          printf "${_y}Usage: hyprconf hardware rotate [on|off]${_r}\n" >&2
          exit 1
          ;;
      esac
      ;;

    gpu)
      # Source the GPU passthrough library
      if [[ ! -f "$GPU_PT_SCRIPT" ]]; then
        die "GPU passthrough script not found: $GPU_PT_SCRIPT\nRun 'hyprconf sync' to restore."
      fi
      # shellcheck source=/dev/null
      source "$GPU_PT_SCRIPT"

      local gpu_sub="${1:-}"
      shift || true
      case "$gpu_sub" in
        ""|status)
          _gpu_status
          ;;
        detect)
          _gpu_detect
          ;;
        setup)
          local setup_output
          setup_output=$(_gpu_setup)
          # If the setup wizard requests the vfio addon, install it
          if echo "$setup_output" | grep -q "__NEED_ADDON_VFIO__"; then
            echo "$setup_output" | grep -v "__NEED_ADDON_VFIO__"
            _addon_install vfio
          else
            echo "$setup_output"
          fi
          # Interactive GPU selection (runs in main shell for terminal input)
          _gpu_setup_select
          # Configure boot-time binding (needs GPU_VENDOR_DEVICE from selection)
          _gpu_configure_boot_binding
          printf "\n${_g}✔${_r} Setup complete. Run 'hyprconf hardware gpu audit' to verify.\n"
          ;;
        audit)
          _gpu_audit
          ;;
        mode)
          local mode_target="${1:-}"
          shift || true
          case "$mode_target" in
            "")
              # Show current mode
              _gpu_mode_get
              ;;
            vm)
              local force=""
              if [[ "${1:-}" == "--force" ]]; then force="force"; shift; fi
              local target="${1:-}"
              if [[ -z "$target" ]]; then
                if _gpu_load_config && [[ -n "${GPU_PCI_ADDR:-}" ]]; then
                  target="$GPU_PCI_ADDR"
                  printf "${_b}→${_r} Using configured GPU: %s\n" "${GPU_NAME:-$target}"
                else
                  die "Usage: hyprconf hardware gpu mode vm [--force] [gpu]\n  Run 'hyprconf hardware gpu setup' first to configure a default GPU."
                fi
              fi
              local pci_addr
              pci_addr=$(_gpu_resolve "$target") || die "Cannot resolve GPU: $target"

              # Safety check for display GPU
              if [[ "$force" != "force" ]] && _gpu_is_display_gpu "$pci_addr"; then
                die "Refusing to bind GPU at ${pci_addr} — it has an active display connector.\nUnbinding this GPU will freeze your desktop.\nUse --force to override."
              fi

              printf "${_b}→${_r} Binding GPU at %s to vfio-pci...\n" "$pci_addr"
              _gpu_mode_vm "$force" "$pci_addr" \
                && printf "${_g}✔${_r} GPU %s bound to vfio-pci — ready for VM passthrough.\n" "$pci_addr" \
                || die "Failed to bind GPU ${pci_addr} to vfio-pci."
              ;;
            host)
              local target="${1:-}"
              if [[ -z "$target" ]]; then
                if _gpu_load_config && [[ -n "${GPU_PCI_ADDR:-}" ]]; then
                  target="$GPU_PCI_ADDR"
                  printf "${_b}→${_r} Using configured GPU: %s\n" "${GPU_NAME:-$target}"
                else
                  die "Usage: hyprconf hardware gpu mode host [gpu]\n  Run 'hyprconf hardware gpu setup' first."
                fi
              fi
              local pci_addr
              pci_addr=$(_gpu_resolve "$target") || die "Cannot resolve GPU: $target"
              printf "${_b}→${_r} Restoring GPU at %s to host driver...\n" "$pci_addr"
              _gpu_mode_host "$pci_addr" \
                && printf "${_g}✔${_r} GPU %s returned to host.\n" "$pci_addr" \
                || die "Failed to restore GPU ${pci_addr} to host."
              ;;
            none)
              local target="${1:-}"
              if [[ -z "$target" ]]; then
                if _gpu_load_config && [[ -n "${GPU_PCI_ADDR:-}" ]]; then
                  target="$GPU_PCI_ADDR"
                  printf "${_b}→${_r} Using configured GPU: %s\n" "${GPU_NAME:-$target}"
                else
                  die "Usage: hyprconf hardware gpu mode none [gpu]\n  Run 'hyprconf hardware gpu setup' first."
                fi
              fi
              local pci_addr
              pci_addr=$(_gpu_resolve "$target") || die "Cannot resolve GPU: $target"
              printf "${_b}→${_r} Unbinding GPU at %s from all drivers...\n" "$pci_addr"
              _gpu_mode_none "$pci_addr" \
                && printf "${_g}✔${_r} GPU %s unbound from all drivers.\n" "$pci_addr" \
                || die "Failed to unbind GPU ${pci_addr}."
              ;;
            *)
              printf "${_y}Unknown mode: %s${_r}\n\n" "$mode_target" >&2
              printf "Usage: hyprconf hardware gpu mode [vm|host|none]\n" >&2
              exit 1
              ;;
          esac
          ;;
        diagnose)
          _gpu_diagnose
          ;;
        report)
          _gpu_report
          ;;
        vm)
          local vm_sub="${1:-}"
          shift || true
          case "$vm_sub" in
            ""|status)
              _gpu_vm_status
              ;;
            install)
              _gpu_vm_install
              ;;
            launch|start)
              _gpu_vm_launch "$@"
              ;;
            connect)
              _gpu_vm_connect "$@"
              ;;
            stop)
              _gpu_vm_stop
              ;;
            remove)
              _gpu_vm_remove
              ;;
            usb)
              local usb_sub="${1:-}"
              shift || true
              case "$usb_sub" in
                ""|list)
                  _gpu_vm_usb
                  ;;
                add)
                  _gpu_vm_usb_add
                  ;;
                remove)
                  _gpu_vm_usb_remove
                  ;;
                *)
                  printf "${_y}Unknown usb subcommand: %s${_r}\n\n" "$usb_sub" >&2
                  printf "Usage: hyprconf hardware gpu vm usb [list|add|remove]\n" >&2
                  exit 1
                  ;;
              esac
              ;;
            *)
              printf "${_y}Unknown vm subcommand: %s${_r}\n\n" "$vm_sub" >&2
              printf "Usage: hyprconf hardware gpu vm [install|launch|connect|stop|status|remove|usb]\n" >&2
              exit 1
              ;;
          esac
          ;;
        *)
          printf "${_y}Unknown gpu subcommand: %s${_r}\n\n" "$gpu_sub" >&2
          printf "Usage: hyprconf hardware gpu [detect|setup|audit|report|mode|vm|diagnose]\n" >&2
          exit 1
          ;;
      esac
      ;;

    *)
      printf "${_y}Unknown hardware subcommand: %s${_r}\n\n" "$sub" >&2
      printf "Usage: hyprconf hardware [status|osk|rotate|gpu]\n" >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
# Doctor — system health check
# ════════════════════════════════════════════════════════════════════════════

_doctor_pass() { printf "  ${_g}✔${_r} %s\n" "$1"; }
_doctor_fail() { printf "  ${_y}✘${_r} %s\n" "$1"; _doctor_errors=$(( _doctor_errors + 1 )); }
_doctor_warn() { printf "  ${_y}⚠${_r} %s\n" "$1"; _doctor_warnings=$(( _doctor_warnings + 1 )); }

_doctor_check_packages() {
  printf "\n${_b}Packages${_r}\n"
  local pkg_file="${HOME}/.hyprconf/packages"
  if [[ ! -f "$pkg_file" ]]; then
    _doctor_fail "Package list not found: $pkg_file"
    return
  fi
  local missing=() pkg
  while IFS= read -r pkg; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    if ! pacman -Qi "$pkg" &>/dev/null; then
      missing+=("$pkg")
    fi
  done < "$pkg_file"
  if (( ${#missing[@]} == 0 )); then
    _doctor_pass "All packages from packages list are installed"
  else
    _doctor_fail "Missing packages: ${missing[*]}"
  fi
}

_doctor_check_services() {
  printf "\n${_b}Services${_r}\n"
  local svc
  for svc in NetworkManager iwd bluetooth ufw power-profiles-daemon; do
    if systemctl is-enabled "$svc" &>/dev/null; then
      if systemctl is-active "$svc" &>/dev/null; then
        _doctor_pass "$svc enabled and running"
      else
        _doctor_warn "$svc enabled but not running"
      fi
    else
      _doctor_fail "$svc not enabled"
    fi
  done
}

_doctor_check_vpn() {
  printf "\n${_b}VPN${_r}\n"
  if ! command -v nmcli &>/dev/null; then
    _doctor_warn "nmcli not found — NetworkManager VPN unavailable"
    return
  fi
  # Informational only — no VPN is a perfectly valid state, never an error.
  local prof
  prof="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
           | awk -F: '$2=="vpn"||$2=="wireguard"{print $1; exit}')"
  if [[ -n "$prof" ]]; then
    _doctor_pass "VPN connected: $prof"
  else
    printf "  ${_c}○${_r} No VPN active (optional — 'hyprconf vpn connect')\n"
  fi
  if [[ -f /etc/hyprconf/killswitch.nft ]]; then
    _doctor_pass "Kill-switch armed (nftables)"
  elif command -v protonvpn &>/dev/null; then
    printf "  ${_c}○${_r} ProtonVPN CLI present — arm with 'hyprconf vpn killswitch on'\n"
  fi
}

_doctor_check_configs() {
  printf "\n${_b}Configuration${_r}\n"
  local f
  for f in \
    "$HOME/.config/hypr/hyprland.conf" \
    "$HOME/.config/hypr/keybinds.conf" \
    "$HOME/.config/hypr/gestures.conf" \
    "$HOME/.config/hypr/monitors.conf" \
    "$HOME/.config/hypr/hypridle.conf" \
    "$HOME/.config/hypr/hyprlock.conf" \
    "$HOME/.config/hypr/hyprpaper.conf"; do
    if [[ -e "$f" ]]; then
      _doctor_pass "$(basename "$f") present"
    else
      _doctor_fail "$(basename "$f") missing"
    fi
  done

  # Check NM wifi backend
  local nm_conf="/etc/NetworkManager/conf.d/wifi-backend.conf"
  if grep -qs "wifi.backend=iwd" "$nm_conf" 2>/dev/null; then
    _doctor_pass "NetworkManager wifi backend = iwd"
  else
    _doctor_fail "NetworkManager wifi backend not configured (expected iwd)"
  fi
}

_doctor_check_symlinks() {
  printf "\n${_b}Symlinks${_r}\n"
  local broken
  broken=$(find "$HOME/.config/hypr" "$HOME/.config/kitty" \
    "$HOME/.config/waybar" "$HOME/.config/dunst" \
    -xtype l 2>/dev/null | head -20) || true
  if [[ -z "$broken" ]]; then
    _doctor_pass "No broken symlinks in managed config dirs"
  else
    local count
    count=$(echo "$broken" | wc -l)
    _doctor_fail "$count broken symlink(s) found"
    echo "$broken" | while IFS= read -r link; do
      printf "    → %s\n" "$link"
    done
  fi
}

_doctor_check_theme() {
  printf "\n${_b}Theme${_r}\n"
  if command -v python3 &>/dev/null && [[ -f "$THEME_SCRIPT" ]]; then
    local current
    current=$(python3 "$THEME_SCRIPT" --current 2>/dev/null) || true
    if [[ -n "$current" ]]; then
      _doctor_pass "Active theme: $current"
    else
      _doctor_warn "No theme currently applied"
    fi
  else
    _doctor_fail "Theme script not found"
  fi
}

_doctor_check_hardware() {
  printf "\n${_b}Hardware${_r}\n"
  local hw_conf="$HOME/.config/hypr/conf.d/60-hardware.conf"
  if [[ -f "$hw_conf" ]]; then
    _doctor_pass "Hardware config present (60-hardware.conf)"
  else
    _doctor_warn "Hardware config not generated — run 'hyprconf sync'"
  fi
  if command -v hyprctl &>/dev/null; then
    _doctor_pass "Hyprland $(hyprctl version -j 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("tag","(unknown)"))' 2>/dev/null || echo "(unknown)")"
  else
    _doctor_fail "hyprctl not found"
  fi

  # Power profile auto-switching (battery devices only)
  if compgen -G "/sys/class/power_supply/BAT*" > /dev/null 2>&1; then
    local udev_rule="/etc/udev/rules.d/99-hyprconf-power.rules"
    if [[ -f "$udev_rule" ]]; then
      if grep -qE 'RUN\+?=.*(/home/|\$HOME)' "$udev_rule" 2>/dev/null; then
        _doctor_warn "Power udev rule runs a \$HOME path as root (privilege-escalation risk) — run 'hyprconf sync' to fix"
      else
        _doctor_pass "Power profile auto-switching enabled (secure root-owned rule)"
      fi
    else
      _doctor_warn "Power profile auto-switching not configured — run 'hyprconf sync'"
    fi
    if [[ -x "$HOME/.local/bin/hyprconf-power-monitor" ]]; then
      _doctor_pass "hyprconf-power-monitor installed"
    else
      _doctor_warn "hyprconf-power-monitor not found — run 'hyprconf sync'"
    fi
  fi

  # GPU passthrough (only check if vfio addon is installed)
  if pacman -Qi qemu-desktop &>/dev/null 2>&1; then
    printf "\n${_b}GPU Passthrough${_r}\n"
    if grep -qE '(intel_iommu|amd_iommu)=on' /proc/cmdline 2>/dev/null; then
      _doctor_pass "IOMMU enabled in kernel cmdline"
    else
      _doctor_warn "IOMMU not enabled — GPU passthrough requires intel_iommu=on or amd_iommu=on"
    fi
    if systemctl is-active --quiet docker 2>/dev/null; then
      _doctor_pass "Docker running"
    else
      _doctor_warn "Docker not running — start with: sudo systemctl enable --now docker"
    fi
    if id -nG "$USER" | grep -qw docker; then
      _doctor_pass "$USER in docker group"
    else
      _doctor_warn "$USER not in docker group — run: sudo usermod -aG docker $USER"
    fi
    if id -nG "$USER" | grep -qw kvm; then
      _doctor_pass "$USER in kvm group"
    else
      _doctor_warn "$USER not in kvm group — run: sudo usermod -aG kvm $USER"
    fi
    if lsmod | grep -q "^vfio_pci" 2>/dev/null; then
      _doctor_pass "vfio_pci module loaded"
    elif modinfo vfio_pci &>/dev/null 2>&1; then
      _doctor_pass "vfio_pci module available (not loaded — loads on demand)"
    else
      _doctor_warn "vfio_pci module not available"
    fi
    if lsmod | grep -q "^kvmfr" 2>/dev/null; then
      _doctor_pass "kvmfr module loaded"
    elif modinfo kvmfr &>/dev/null 2>&1; then
      _doctor_pass "kvmfr module available (not loaded)"
    else
      _doctor_warn "kvmfr module not available — install looking-glass-module-dkms and run: sudo dkms autoinstall"
    fi
    if [[ -e /dev/kvmfr0 ]]; then
      _doctor_pass "/dev/kvmfr0 present"
    else
      _doctor_warn "/dev/kvmfr0 not found — run: sudo modprobe kvmfr static_size_mb=128"
    fi
  fi
}

_doctor_check_secureboot() {
  # UEFI only; silent on BIOS/containers.
  [[ -d /sys/firmware/efi/efivars ]] || return 0
  local guid="8be4df61-93ca-11d2-aa0d-00e098032b8c"
  local sb_var="/sys/firmware/efi/efivars/SecureBoot-${guid}"
  local esp; esp="$(bootctl -p 2>/dev/null || echo /boot)"
  local sb_state="unknown" uki=0 have_sbctl=0
  if command -v bootctl &>/dev/null && bootctl status 2>/dev/null | grep -qiE 'Secure Boot:[[:space:]]*enabled'; then
    sb_state="enabled"
  elif [[ -r "$sb_var" ]]; then
    local b; b="$(od -An -t u1 "$sb_var" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | tail -1)"
    [[ "$b" == "1" ]] && sb_state="enabled" || sb_state="disabled"
  fi
  compgen -G "$esp/EFI/Linux/*.efi" >/dev/null 2>&1 && uki=1
  command -v sbctl &>/dev/null && have_sbctl=1

  # Stay silent on systems that never engaged Secure Boot — only report drift once
  # the user has actually set it up (SB on, a UKI, or sbctl present).
  if [[ "$sb_state" != "enabled" && $uki -eq 0 && $have_sbctl -eq 0 ]]; then
    return 0
  fi

  printf "\n${_b}Secure Boot${_r}\n"
  case "$sb_state" in
    enabled)  _doctor_pass "Secure Boot enabled" ;;
    disabled) _doctor_fail "Secure Boot DISABLED but keys/UKI are present — boot integrity not enforced; re-enable it in firmware" ;;
    *)        _doctor_warn "Secure Boot state could not be read" ;;
  esac
  if (( uki )); then
    _doctor_pass "Unified Kernel Image present ($esp/EFI/Linux)"
  else
    _doctor_warn "No signed UKI on the ESP — run 'hyprconf secureboot setup'"
  fi
  (( have_sbctl )) || _doctor_warn "sbctl not installed — run 'hyprconf secureboot setup'"
  printf "  ${_c}ℹ${_r} Full report (needs sudo): hyprconf secureboot status\n"
}

_doctor_check_shell() {
  printf "\n${_b}Shell${_r}\n"
  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    _doctor_pass "Oh My Zsh installed"
  else
    _doctor_warn "Oh My Zsh not found"
  fi
  if [[ -d "$HOME/.oh-my-zsh/custom/themes/powerlevel10k" ]]; then
    _doctor_pass "Powerlevel10k installed"
  else
    _doctor_warn "Powerlevel10k not found"
  fi
}

cmd_doctor() {
  local _doctor_errors=0 _doctor_warnings=0
  printf "${_b}${_c}hyprconf doctor${_r} — system health check\n"
  _doctor_check_packages
  _doctor_check_services
  _doctor_check_vpn
  _doctor_check_configs
  _doctor_check_symlinks
  _doctor_check_theme
  _doctor_check_hardware
  _doctor_check_secureboot
  _doctor_check_shell
  printf "\n"
  if (( _doctor_errors == 0 && _doctor_warnings == 0 )); then
    printf "${_g}✔ All checks passed.${_r}\n"
  else
    (( _doctor_errors > 0 )) && printf "${_y}✘ %d error(s)${_r}" "$_doctor_errors"
    (( _doctor_errors > 0 && _doctor_warnings > 0 )) && printf ", "
    (( _doctor_warnings > 0 )) && printf "${_y}⚠ %d warning(s)${_r}" "$_doctor_warnings"
    printf "\n"
    (( _doctor_errors > 0 )) && return 1
  fi
  return 0
}

# ════════════════════════════════════════════════════════════════════════════
# Clipboard — cliphist picker
# ════════════════════════════════════════════════════════════════════════════

cmd_clipboard() {
  command -v cliphist &>/dev/null || die "cliphist not installed (pacman -S cliphist)"
  local picker="${1:-fzf}"
  case "$picker" in
    fzf)
      command -v fzf &>/dev/null || die "fzf not installed"
      cliphist list | fzf --no-sort | cliphist decode | wl-copy
      ;;
    rofi)
      command -v rofi &>/dev/null || die "rofi not installed"
      cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
      ;;
    wipe)
      cliphist wipe
      printf "${_g}✔${_r} Clipboard history cleared.\n"
      ;;
    *)
      printf "Usage: hyprconf clipboard [fzf|rofi|wipe]\n" >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
# Screenshot — unified capture workflow
# ════════════════════════════════════════════════════════════════════════════

cmd_screenshot() {
  command -v hyprshot &>/dev/null || die "hyprshot not installed"
  local mode="${1:-region}"
  local output_dir="${HYPRSHOT_DIR:-$HOME/Pictures/Screenshots}"
  mkdir -p "$output_dir"
  case "$mode" in
    region)  hyprshot -m region -o "$output_dir" ;;
    window)  hyprshot -m window -o "$output_dir" ;;
    full)    hyprshot -m output -o "$output_dir" ;;
    edit)
      # Capture region, then open in swappy for annotation
      if command -v swappy &>/dev/null; then
        hyprshot -m region -o "$output_dir" --raw | swappy -f -
      else
        printf "${_y}swappy not installed — capturing without annotation${_r}\n"
        hyprshot -m region -o "$output_dir"
      fi
      ;;
    *)
      printf "Usage: hyprconf screenshot [region|window|full|edit]\n" >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
# Game mode — toggle performance mode
# ════════════════════════════════════════════════════════════════════════════

readonly _GAMEMODE_STATE="${XDG_RUNTIME_DIR:-/tmp}/hyprconf-gamemode"

cmd_gamemode() {
  local sub="${1:-toggle}"
  case "$sub" in
    on)     _gamemode_on ;;
    off)    _gamemode_off ;;
    toggle)
      if [[ -f "$_GAMEMODE_STATE" ]]; then
        _gamemode_off
      else
        _gamemode_on
      fi
      ;;
    status)
      if [[ -f "$_GAMEMODE_STATE" ]]; then
        printf "${_y}Game mode is ON${_r} (animations, blur, shadows disabled)\n"
      else
        printf "${_g}Game mode is OFF${_r} (normal desktop)\n"
      fi
      ;;
    *)
      printf "Usage: hyprconf gamemode [on|off|toggle|status]\n" >&2
      exit 1
      ;;
  esac
}

_gamemode_on() {
  if [[ -f "$_GAMEMODE_STATE" ]]; then
    printf "${_y}Game mode already active.${_r}\n"
    return
  fi
  # Save current values
  {
    hyprctl -j getoption decoration:blur:enabled 2>/dev/null || true
    hyprctl -j getoption decoration:shadow:enabled 2>/dev/null || true
    hyprctl -j getoption animations:enabled 2>/dev/null || true
  } > "$_GAMEMODE_STATE"

  hyprctl --batch "\
    keyword animations:enabled false;\
    keyword decoration:blur:enabled false;\
    keyword decoration:shadow:enabled false;\
    keyword general:gaps_in 0;\
    keyword general:gaps_out 0;\
    keyword decoration:rounding 0" &>/dev/null

  printf "${_g}✔${_r} Game mode ${_b}ON${_r} — animations, blur, shadows, gaps disabled.\n"
}

_gamemode_off() {
  if [[ ! -f "$_GAMEMODE_STATE" ]]; then
    printf "${_y}Game mode not active.${_r}\n"
    return
  fi
  rm -f "$_GAMEMODE_STATE"

  # Restore by reloading config (picks up all persisted values)
  hyprctl reload &>/dev/null

  printf "${_g}✔${_r} Game mode ${_b}OFF${_r} — desktop restored.\n"
}

# ════════════════════════════════════════════════════════════════════════════
# Power menu — lock / logout / suspend / reboot / shutdown
# ════════════════════════════════════════════════════════════════════════════

cmd_power() {
  local action="${1:-}"
  if [[ -z "$action" ]]; then
    # Interactive menu
    local choices=("Lock" "Logout" "Suspend" "Reboot" "Shutdown")
    if command -v fzf &>/dev/null; then
      action=$(printf '%s\n' "${choices[@]}" | fzf --prompt="Power ▸ " --height=8 --no-sort) || return
    else
      printf "${_b}Power menu:${_r}\n"
      local i
      for i in "${!choices[@]}"; do
        printf "  %d) %s\n" "$((i + 1))" "${choices[$i]}"
      done
      printf "Choice [1-%d]: " "${#choices[@]}"
      local choice
      read -r choice
      [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#choices[@]} )) || { printf "${_y}Cancelled.${_r}\n"; return; }
      action="${choices[$((choice - 1))]}"
    fi
  fi

  case "${action,,}" in
    lock)     hyprlock & ;;
    logout)   hyprctl dispatch exit ;;
    suspend)  systemctl suspend ;;
    reboot)   systemctl reboot ;;
    shutdown) systemctl poweroff ;;
    *)
      printf "Usage: hyprconf power [lock|logout|suspend|reboot|shutdown]\n" >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
# Power profile — query / switch power-profiles-daemon profiles
# ════════════════════════════════════════════════════════════════════════════

_pp_available() {
  command -v powerprofilesctl &>/dev/null
}

cmd_power_profile() {
  if ! _pp_available; then
    printf "${_y}powerprofilesctl not found — install power-profiles-daemon.${_r}\n" >&2
    exit 1
  fi

  local sub="${1:-status}"
  case "$sub" in
    status)
      local current ac_state
      current="$(powerprofilesctl get 2>/dev/null || echo 'unknown')"
      if compgen -G "/sys/class/power_supply/BAT*" > /dev/null 2>&1; then
        local monitor="${HOME}/.local/bin/hyprconf-power-monitor"
        if [[ -x "$monitor" ]]; then
          ac_state="$("$monitor" status 2>/dev/null | grep 'AC adapter' | sed 's/.*: *//')"
        else
          ac_state="unknown"
        fi
        printf "${_b}Power profile:${_r} %s\n" "$current"
        printf "${_b}AC adapter:${_r}    %s\n" "$ac_state"

        local udev_rule="/etc/udev/rules.d/99-hyprconf-power.rules"
        if [[ -f "$udev_rule" ]]; then
          printf "${_b}Auto-switch:${_r}   ${_g}enabled${_r} (udev rule installed)\n"
        else
          printf "${_b}Auto-switch:${_r}   ${_y}disabled${_r} (run hyprconf sync to enable)\n"
        fi
      else
        printf "${_b}Power profile:${_r} %s\n" "$current"
        printf "${_b}Battery:${_r}       not detected (desktop)\n"
      fi
      ;;
    performance|balanced|power-saver)
      local current
      current="$(powerprofilesctl get 2>/dev/null || echo 'unknown')"
      if [[ "$current" == "$sub" ]]; then
        printf "${_y}Already set to %s.${_r}\n" "$sub"
      else
        powerprofilesctl set "$sub" 2>/dev/null \
          && printf "${_g}✔${_r} Power profile set to ${_b}%s${_r}\n" "$sub" \
          || { printf "${_y}Failed to set power profile.${_r}\n" >&2; exit 1; }
      fi
      ;;
    auto)
      local monitor="${HOME}/.local/bin/hyprconf-power-monitor"
      if [[ -x "$monitor" ]]; then
        "$monitor" auto
        local new_profile
        new_profile="$(powerprofilesctl get 2>/dev/null || echo 'unknown')"
        printf "${_g}✔${_r} Auto-detected profile: ${_b}%s${_r}\n" "$new_profile"
      else
        printf "${_y}hyprconf-power-monitor not found — run hyprconf sync.${_r}\n" >&2
        exit 1
      fi
      ;;
    *)
      printf "Usage: hyprconf power-profile [status|performance|balanced|power-saver|auto]\n" >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
# Night light — blue light filter
# ════════════════════════════════════════════════════════════════════════════

readonly _NIGHTLIGHT_STATE="${XDG_RUNTIME_DIR:-/tmp}/hyprconf-nightlight"
readonly _NIGHTLIGHT_PID="${XDG_RUNTIME_DIR:-/tmp}/hyprconf-nightlight.pid"

cmd_nightlight() {
  local sub="${1:-toggle}"
  case "$sub" in
    on)
      _nightlight_on "${2:-4000}"
      ;;
    off)
      _nightlight_off
      ;;
    toggle)
      if [[ -f "$_NIGHTLIGHT_STATE" ]]; then
        _nightlight_off
      else
        _nightlight_on "${2:-4000}"
      fi
      ;;
    status)
      if [[ -f "$_NIGHTLIGHT_STATE" ]]; then
        printf "${_y}Night light is ON${_r} (temp: %sK)\n" "$(< "$_NIGHTLIGHT_STATE")"
      else
        printf "${_g}Night light is OFF${_r}\n"
      fi
      ;;
    *)
      printf "Usage: hyprconf nightlight [on [temp]|off|toggle|status]\n" >&2
      printf "  temp: colour temperature in Kelvin (default: 4000, range: 1000-6500)\n" >&2
      exit 1
      ;;
  esac
}

_nightlight_on() {
  local temp="${1:-4000}"
  if [[ -f "$_NIGHTLIGHT_PID" ]] && kill -0 "$(< "$_NIGHTLIGHT_PID")" 2>/dev/null; then
    printf "${_y}Night light already active.${_r}\n"
    return
  fi
  if command -v hyprsunset &>/dev/null; then
    hyprsunset -t "$temp" &
    disown
    echo "$!" > "$_NIGHTLIGHT_PID"
    echo "$temp" > "$_NIGHTLIGHT_STATE"
    printf "${_g}✔${_r} Night light ${_b}ON${_r} (%sK)\n" "$temp"
  elif command -v wlsunset &>/dev/null; then
    wlsunset -T "$temp" &
    disown
    echo "$!" > "$_NIGHTLIGHT_PID"
    echo "$temp" > "$_NIGHTLIGHT_STATE"
    printf "${_g}✔${_r} Night light ${_b}ON${_r} (%sK)\n" "$temp"
  else
    die "Neither hyprsunset nor wlsunset is installed. Install with: pacman -S hyprsunset"
  fi
}

_nightlight_off() {
  if [[ ! -f "$_NIGHTLIGHT_PID" ]]; then
    printf "${_y}Night light not active.${_r}\n"
    return
  fi
  local pid
  pid=$(< "$_NIGHTLIGHT_PID")
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$_NIGHTLIGHT_PID" "$_NIGHTLIGHT_STATE"
  printf "${_g}✔${_r} Night light ${_b}OFF${_r}\n"
}

# ════════════════════════════════════════════════════════════════════════════
# Color picker — pick colour from screen
# ════════════════════════════════════════════════════════════════════════════

cmd_colorpicker() {
  command -v hyprpicker &>/dev/null \
    || die "hyprpicker not installed. Install with: pacman -S hyprpicker"
  local format="${1:-hex}"
  local color
  case "$format" in
    hex)  color=$(hyprpicker -a) ;;
    rgb)  color=$(hyprpicker -a -f rgb) ;;
    *)
      printf "Usage: hyprconf colorpicker [hex|rgb]\n" >&2
      exit 1
      ;;
  esac
  if [[ -n "$color" ]]; then
    printf "${_g}✔${_r} Copied to clipboard: ${_b}%s${_r}\n" "$color"
  fi
}

# ════════════════════════════════════════════════════════════════════════════
# Screen recording
# ════════════════════════════════════════════════════════════════════════════

readonly _RECORD_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/hyprconf-recording.pid"

cmd_record() {
  local sub="${1:-toggle}"
  case "$sub" in
    start)   _record_start "${@:2}" ;;
    stop)    _record_stop ;;
    toggle)
      if [[ -f "$_RECORD_PIDFILE" ]] && kill -0 "$(< "$_RECORD_PIDFILE")" 2>/dev/null; then
        _record_stop
      else
        _record_start "${@:2}"
      fi
      ;;
    status)
      if [[ -f "$_RECORD_PIDFILE" ]] && kill -0 "$(< "$_RECORD_PIDFILE")" 2>/dev/null; then
        printf "${_y}Recording in progress${_r} (PID %s)\n" "$(< "$_RECORD_PIDFILE")"
      else
        printf "${_g}Not recording.${_r}\n"
      fi
      ;;
    *)
      printf "Usage: hyprconf record [start|stop|toggle|status]\n" >&2
      exit 1
      ;;
  esac
}

_record_start() {
  if [[ -f "$_RECORD_PIDFILE" ]] && kill -0 "$(< "$_RECORD_PIDFILE")" 2>/dev/null; then
    printf "${_y}Already recording.${_r} Stop first with: hyprconf record stop\n"
    return
  fi
  local output_dir="${HOME}/Videos/Recordings"
  mkdir -p "$output_dir"
  local filename
  filename="$output_dir/recording-$(date +%Y%m%d-%H%M%S).mp4"

  if command -v wf-recorder &>/dev/null; then
    wf-recorder -f "$filename" "$@" &
    disown
    echo "$!" > "$_RECORD_PIDFILE"
    printf "${_g}✔${_r} Recording started → %s\n" "$filename"
  elif command -v gpu-screen-recorder &>/dev/null; then
    gpu-screen-recorder -w screen -f 60 -o "$filename" "$@" &
    disown
    echo "$!" > "$_RECORD_PIDFILE"
    printf "${_g}✔${_r} Recording started → %s\n" "$filename"
  else
    die "No screen recorder found. Install with: pacman -S wf-recorder"
  fi
}

_record_stop() {
  if [[ ! -f "$_RECORD_PIDFILE" ]]; then
    printf "${_y}Not recording.${_r}\n"
    return
  fi
  local pid
  pid=$(< "$_RECORD_PIDFILE")
  if kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$_RECORD_PIDFILE"
  printf "${_g}✔${_r} Recording stopped.\n"
}

# ════════════════════════════════════════════════════════════════════════════
# ════════════════════════════════════════════════════════════════════════════
# Developer
# ════════════════════════════════════════════════════════════════════════════

readonly DEV_REPO="${HOME}/.hyprconf"

_dev_require_repo() {
  [[ -d "${DEV_REPO}/.git" ]] \
    || die "Repo not found at ${DEV_REPO} — is hyprconf installed?"
}

_dev_vm_is_running() {
  local pf="/tmp/hyprconf-vm.pid"
  [[ -f "$pf" ]] && kill -0 "$(< "$pf")" 2>/dev/null
}

_dev_install_vm_is_running() {
  local pf="/tmp/hyprconf-install-vm.pid"
  [[ -f "$pf" ]] && kill -0 "$(< "$pf")" 2>/dev/null
}

_dev_test_with_vm() {
  if ! _dev_vm_is_running; then
    printf "Starting test VM (port 2222)...\n"
    (cd "${DEV_REPO}" && bash tests/vm/run_vm.sh)
  fi
  (cd "${DEV_REPO}" && make test-vm)
}

_dev_test_with_install_vm() {
  if ! _dev_install_vm_is_running; then
    printf "Starting install VM (port 2223)...\n"
    (cd "${DEV_REPO}" && bash tests/install/run_install_vm.sh)
  fi
  (cd "${DEV_REPO}" && make test-install)
}

_dev_test() {
  _dev_require_repo
  local flag="${1:-}"
  case "$flag" in
    --unit)        (cd "${DEV_REPO}" && make test-unit) ;;
    --integration) (cd "${DEV_REPO}" && make test-integration) ;;
    --tui)         (cd "${DEV_REPO}" && make test-tui) ;;
    --vm)          _dev_test_with_vm ;;
    --install)     _dev_test_with_install_vm ;;
    --all)
      (cd "${DEV_REPO}" && make test)   # tiers 1-3
      _dev_test_with_vm                  # tier 4 (starts VM if needed)
      _dev_test_with_install_vm          # tier 5 (starts install VM if needed)
      ;;
    "") (cd "${DEV_REPO}" && make test) ;;
    *)  die "Unknown test flag: ${flag}\nUsage: hyprconf dev test [--unit|--integration|--tui|--vm|--install|--all]" ;;
  esac
}

_dev_vm() {
  _dev_require_repo
  local sub="${1:-status}"
  case "$sub" in
    start)
      (cd "${DEV_REPO}" && bash tests/vm/run_vm.sh)
      ;;
    stop)
      (cd "${DEV_REPO}" && bash tests/vm/run_vm.sh --stop)
      ;;
    build)
      (cd "${DEV_REPO}" && bash tests/install/build_image.sh)
      ;;
    status)
      local pf="/tmp/hyprconf-vm.pid"
      local ipf="/tmp/hyprconf-install-vm.pid"
      if [[ -f "$pf" ]] && kill -0 "$(< "$pf")" 2>/dev/null; then
        printf "Test VM:    running (PID %s, port 2222)\n" "$(< "$pf")"
      else
        printf "Test VM:    stopped\n"
      fi
      if [[ -f "$ipf" ]] && kill -0 "$(< "$ipf")" 2>/dev/null; then
        printf "Install VM: running (PID %s, port 2223)\n" "$(< "$ipf")"
      else
        printf "Install VM: stopped\n"
      fi
      if [[ -f "${DEV_REPO}/tests/vm/arch-hyprconf.meta" ]]; then
        printf "Image:      %s (commit %s)\n" \
          "$(grep '^built_at='    "${DEV_REPO}/tests/vm/arch-hyprconf.meta" | cut -d= -f2-)" \
          "$(grep '^git_commit='  "${DEV_REPO}/tests/vm/arch-hyprconf.meta" | cut -d= -f2-)"
      else
        printf "Image:      not built\n"
      fi
      ;;
    stop-all)
      (cd "${DEV_REPO}" && bash tests/vm/run_vm.sh         --stop 2>/dev/null || true)
      (cd "${DEV_REPO}" && bash tests/install/run_install_vm.sh --stop 2>/dev/null || true)
      ;;
    *)
      die "Unknown vm subcommand: ${sub}\nUsage: hyprconf dev vm [start|stop|stop-all|build|status]"
      ;;
  esac
}

_dev_checkout() {
  _dev_require_repo
  printf "${_b}→${_r} Disabling sparse checkout...\n"
  git -C "${DEV_REPO}" sparse-checkout disable
  printf "${_b}→${_r} Fetching dev branch...\n"
  git -C "${DEV_REPO}" fetch origin dev
  printf "${_b}→${_r} Switching to dev branch...\n"
  git -C "${DEV_REPO}" checkout dev
  git -C "${DEV_REPO}" pull
  printf "${_g}✓${_r} Repo is now a full clone on branch 'dev'.\n"
  printf "  All files (including .github/copilot-instructions.md) are now available.\n"
}

_dev_usage() {
  printf "${_b}${_c}hyprconf dev${_r} — developer pipeline\n\n"
  printf "${_b}Tests${_r}\n"
  printf "  hyprconf dev test                   Tiers 1-3: unit / integration / tui\n"
  printf "  hyprconf dev test --all             All tiers (1-5); starts VMs if needed\n"
  printf "  hyprconf dev test --unit            Unit tests only\n"
  printf "  hyprconf dev test --integration     Integration tests only\n"
  printf "  hyprconf dev test --tui             TUI tests only\n"
  printf "  hyprconf dev test --vm              Tier 4: VM integration (starts VM if needed)\n"
  printf "  hyprconf dev test --install         Tier 5: install-script (starts install VM if needed)\n"
  printf "\n${_b}VM${_r}\n"
  printf "  hyprconf dev vm start               Start test VM (port 2222)\n"
  printf "  hyprconf dev vm stop                Stop test VM\n"
  printf "  hyprconf dev vm stop-all            Stop both test and install VMs\n"
  printf "  hyprconf dev vm build               Build VM image via Packer (~20 min)\n"
  printf "  hyprconf dev vm status              Show VM and image status\n"
  printf "\n${_b}Repo${_r}\n"
  printf "  hyprconf dev checkout               Convert sparse checkout → full dev clone (branch: dev)\n"
  printf "\n${_b}Publish${_r}\n"
  printf "  hyprconf dev publish                Full pipeline: tests → stable promote\n"
}

cmd_dev() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    test)            _dev_test "$@" ;;
    vm)              _dev_vm "$@" ;;
    checkout)        _dev_checkout ;;
    publish)         _dev_require_repo; bash "${DEV_REPO}/scripts/publish" ;;
    help|-h|--help|"") _dev_usage ;;
    *)
      printf "${_y}Unknown dev subcommand: %s${_r}\n\n" "$sub" >&2
      _dev_usage >&2
      exit 1
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
#  Addon system — optional package sets
#
#  To register a new addon:
#    1. Add its name to _ADDON_NAMES
#    2. Add a matching case branch to each of the five _addon_* functions below
# ════════════════════════════════════════════════════════════════════════════

readonly -a _ADDON_NAMES=(dev vfio vpn librewolf)

_addon_description() {
  case "$1" in
    dev)  printf "Developer tools: full test-suite deps (pytest-xdist, QEMU/KVM, Packer) + GitHub Copilot CLI" ;;
    vfio) printf "GPU passthrough: QEMU, OVMF, VFIO, Looking Glass, RDP (for GPU VM)" ;;
    vpn)  printf "ProtonVPN official CLI: NetShield, Secure Core, built-in kill-switch (layer over the core NetworkManager VPN)" ;;
    librewolf) printf "LibreWolf: privacy-hardened Firefox fork (no telemetry, RFP, uBlock Origin) — auto-themed by hyprconf" ;;
    *)    printf "" ;;
  esac
}

# Space-separated pacman packages for the addon (empty string = none).
_addon_packages() {
  case "$1" in
    dev)  printf "python-pytest-xdist qemu-full edk2-ovmf aws-cli" ;;
    vfio) printf "qemu-desktop edk2-ovmf docker docker-compose dmidecode freerdp linux-headers dnsmasq iptables-nft" ;;
    vpn)  printf "proton-vpn-cli" ;;
    *)    printf "" ;;
  esac
}

# Space-separated AUR packages for the addon (installed via yay; empty = none).
_addon_aur_packages() {
  case "$1" in
    dev)  printf "packer" ;;
    vfio) printf "looking-glass looking-glass-module-dkms" ;;
    librewolf) printf "librewolf-bin" ;;
    *)    printf "" ;;
  esac
}

# Arbitrary steps run after all packages are installed.
_addon_post_install() {
  case "$1" in
    dev)
      # Persist KVM kernel modules so they load automatically on boot.
      local kvm_mod
      if grep -q "AMD" /proc/cpuinfo 2>/dev/null; then
        kvm_mod="kvm_amd"
      else
        kvm_mod="kvm_intel"
      fi
      local kvm_conf="/etc/modules-load.d/kvm.conf"
      if [[ ! -f "$kvm_conf" ]] || ! grep -q "^${kvm_mod}$" "$kvm_conf" 2>/dev/null; then
        printf "${_b}→${_r} Enabling KVM module (%s) in %s...\n" "$kvm_mod" "$kvm_conf"
        printf '%s\n' "$kvm_mod" | sudo tee -a "$kvm_conf" > /dev/null \
          && printf "${_g}✓${_r} KVM module %s registered for auto-load.\n" "$kvm_mod" \
          || printf "${_y}⚠${_r} Could not write %s — load manually: sudo modprobe %s\n" "$kvm_conf" "$kvm_mod"
      else
        printf "${_g}✓${_r} KVM module %s already registered.\n" "$kvm_mod"
      fi
      sudo modprobe "$kvm_mod" 2>/dev/null \
        && printf "${_g}✓${_r} KVM module %s loaded.\n" "$kvm_mod" \
        || printf "${_y}⚠${_r} modprobe %s failed — reboot may be required.\n" "$kvm_mod"

      printf "${_b}→${_r} Installing GitHub Copilot CLI...\n"
      curl -fsSL https://gh.io/copilot-install | bash \
        && printf "${_g}✓${_r} GitHub Copilot CLI installed.\n" \
        || printf "${_y}⚠${_r} Copilot install failed — run manually: curl -fsSL https://gh.io/copilot-install | bash\n"
      ;;
    vpn)
      # No daemon config touched here — ProtonVPN sign-in is interactive and
      # personal, so we only point the way (keeps addon installs non-blocking).
      printf "\n${_g}✓${_r} ProtonVPN CLI installed. Next steps:\n"
      printf "  ${_b}1.${_r} Sign in:        ${_c}protonvpn signin${_r}\n"
      printf "  ${_b}2.${_r} Connect:        ${_c}hyprconf vpn connect${_r}  (or: protonvpn connect)\n"
      printf "  ${_b}3.${_r} Kill-switch on: ${_c}hyprconf vpn killswitch on${_r}\n"
      printf "  Core NetworkManager VPN profiles keep working via ${_c}hyprconf vpn${_r} either way.\n"
      ;;
    librewolf)
      # LibreWolf has no profile until its first launch, so there's nothing to
      # theme yet — just point the way. The theme engine writes LibreWolf's
      # userChrome.css/user.js automatically on the next 'hyprconf theme' change.
      printf "\n${_g}✓${_r} LibreWolf installed. Next steps:\n"
      printf "  ${_b}1.${_r} Launch it once (creates its profile): ${_c}librewolf${_r}\n"
      printf "  ${_b}2.${_r} Apply the hyprconf palette:           ${_c}hyprconf theme \$(hyprconf theme current)${_r}\n"
      printf "  Thereafter every theme change re-themes LibreWolf automatically.\n"
      ;;
    vfio)
      # Load VFIO kernel modules
      local vfio_mod
      for vfio_mod in vfio_pci vfio_iommu_type1; do
        sudo modprobe "$vfio_mod" 2>/dev/null \
          && printf "${_g}✓${_r} Module %s loaded.\n" "$vfio_mod" \
          || printf "${_y}⚠${_r} modprobe %s failed — reboot may be required.\n" "$vfio_mod"
      done

      # Persist VFIO modules for boot
      local vfio_conf="/etc/modules-load.d/vfio.conf"
      if [[ ! -f "$vfio_conf" ]]; then
        printf "${_b}→${_r} Registering VFIO modules for auto-load...\n"
        printf 'vfio_pci\nvfio_iommu_type1\n' | sudo tee "$vfio_conf" > /dev/null \
          && printf "${_g}✓${_r} VFIO modules registered in %s.\n" "$vfio_conf" \
          || printf "${_y}⚠${_r} Could not write %s.\n" "$vfio_conf"
      else
        printf "${_g}✓${_r} VFIO module autoload already configured.\n"
      fi

      # KVM module (shared logic with dev addon)
      local kvm_mod
      if grep -q "AMD" /proc/cpuinfo 2>/dev/null; then
        kvm_mod="kvm_amd"
      else
        kvm_mod="kvm_intel"
      fi
      local kvm_conf="/etc/modules-load.d/kvm.conf"
      if [[ ! -f "$kvm_conf" ]] || ! grep -q "^${kvm_mod}$" "$kvm_conf" 2>/dev/null; then
        printf "${_b}→${_r} Enabling KVM module (%s)...\n" "$kvm_mod"
        printf '%s\n' "$kvm_mod" | sudo tee -a "$kvm_conf" > /dev/null \
          && printf "${_g}✓${_r} KVM module %s registered.\n" "$kvm_mod" \
          || printf "${_y}⚠${_r} Could not register KVM module.\n"
      else
        printf "${_g}✓${_r} KVM module %s already registered.\n" "$kvm_mod"
      fi
      sudo modprobe "$kvm_mod" 2>/dev/null \
        && printf "${_g}✓${_r} KVM module %s loaded.\n" "$kvm_mod" \
        || printf "${_y}⚠${_r} modprobe %s failed — reboot may be required.\n" "$kvm_mod"

      # Add user to kvm group
      if id -nG "$USER" | grep -qw kvm; then
        printf "${_g}✓${_r} %s already in 'kvm' group.\n" "$USER"
      else
        printf "${_b}→${_r} Adding %s to 'kvm' group...\n" "$USER"
        sudo usermod -aG kvm "$USER" \
          && printf "${_g}✓${_r} Added to 'kvm'. Log out and back in to apply.\n" \
          || printf "${_y}⚠${_r} Could not add to 'kvm' group.\n"
      fi

      # Docker service + group
      printf "${_b}→${_r} Enabling Docker service...\n"
      sudo systemctl enable --now docker 2>/dev/null \
        && printf "${_g}✓${_r} Docker service enabled and started.\n" \
        || printf "${_y}⚠${_r} Could not enable Docker — start manually: sudo systemctl enable --now docker\n"
      if id -nG "$USER" | grep -qw docker; then
        printf "${_g}✓${_r} %s already in 'docker' group.\n" "$USER"
      else
        printf "${_b}→${_r} Adding %s to 'docker' group...\n" "$USER"
        sudo usermod -aG docker "$USER" \
          && printf "${_g}✓${_r} Added to 'docker'. Log out and back in to apply.\n" \
          || printf "${_y}⚠${_r} Could not add to 'docker' group.\n"
      fi

      printf "\n${_g}✓${_r} VFIO addon setup complete.\n"

      # kvmfr module (Looking Glass shared memory)
      local kvmfr_conf="/etc/modules-load.d/kvmfr.conf"
      if [[ ! -f "$kvmfr_conf" ]] || ! grep -q "^kvmfr$" "$kvmfr_conf" 2>/dev/null; then
        printf "${_b}→${_r} Registering kvmfr module for auto-load...\n"
        printf 'kvmfr\n' | sudo tee "$kvmfr_conf" > /dev/null \
          && printf "${_g}✓${_r} kvmfr registered in %s.\n" "$kvmfr_conf" \
          || printf "${_y}⚠${_r} Could not write %s.\n" "$kvmfr_conf"
      else
        printf "${_g}✓${_r} kvmfr module autoload already configured.\n"
      fi

      local kvmfr_opts="/etc/modprobe.d/kvmfr.conf"
      if [[ ! -f "$kvmfr_opts" ]] || ! grep -q "static_size_mb" "$kvmfr_opts" 2>/dev/null; then
        printf "${_b}→${_r} Setting kvmfr shared memory to 128MB...\n"
        printf 'options kvmfr static_size_mb=128\n' | sudo tee "$kvmfr_opts" > /dev/null \
          && printf "${_g}✓${_r} kvmfr options saved to %s.\n" "$kvmfr_opts" \
          || printf "${_y}⚠${_r} Could not write %s.\n" "$kvmfr_opts"
      else
        printf "${_g}✓${_r} kvmfr options already configured.\n"
      fi

      sudo dkms autoinstall 2>/dev/null \
        && printf "${_g}✓${_r} DKMS modules built for current kernel.\n" \
        || printf "${_y}⚠${_r} DKMS autoinstall failed — check 'dkms status'.\n"

      sudo modprobe kvmfr static_size_mb=128 2>/dev/null \
        && printf "${_g}✓${_r} kvmfr module loaded (/dev/kvmfr0).\n" \
        || printf "${_y}⚠${_r} modprobe kvmfr failed — reboot may be required after DKMS build.\n"

      # Set /dev/kvmfr0 permissions for current user
      if [[ -e /dev/kvmfr0 ]]; then
        sudo chown "$USER:kvm" /dev/kvmfr0 2>/dev/null \
          && sudo chmod 660 /dev/kvmfr0 2>/dev/null \
          && printf "${_g}✓${_r} /dev/kvmfr0 owned by %s (mode 0660).\n" "$USER"

        # Persist via udev rule
        local udev_rule="/etc/udev/rules.d/99-kvmfr.rules"
        if [[ ! -f "$udev_rule" ]]; then
          printf 'SUBSYSTEM=="kvmfr", OWNER="%s", GROUP="kvm", MODE="0660"\n' "$USER" \
            | sudo tee "$udev_rule" > /dev/null \
            && printf "${_g}✓${_r} udev rule created for /dev/kvmfr0 permissions.\n"
        fi
      fi

      printf "\n${_g}✓${_r} VFIO addon fully configured.\n"
      printf "  Run 'hyprconf hardware gpu audit' to verify system readiness.\n"
      printf "  Run 'hyprconf hardware gpu setup' to configure GPU and driver blacklist.\n"
      ;;
  esac
}

# Returns 0 if the addon appears fully installed; non-zero otherwise.
_addon_is_installed() {
  case "$1" in
    dev)
      pacman -Qi python-pytest-xdist &>/dev/null \
        && pacman -Qi qemu-full &>/dev/null \
        && pacman -Qi edk2-ovmf &>/dev/null
      ;;
    vfio)
      # qemu-full (e.g. from the dev addon) provides the same `qemu` virtual
      # package as qemu-desktop and satisfies the vfio addon's QEMU requirement.
      { pacman -Qi qemu-desktop &>/dev/null || pacman -Qi qemu-full &>/dev/null; } \
        && pacman -Qi edk2-ovmf &>/dev/null
      ;;
    vpn)
      pacman -Qi proton-vpn-cli &>/dev/null
      ;;
    librewolf)
      pacman -Qi librewolf-bin &>/dev/null || pacman -Qi librewolf &>/dev/null
      ;;
    *) return 1 ;;
  esac
}

_addon_usage() {
  printf "${_b}${_c}hyprconf addon${_r} — optional package sets\n\n"
  printf "${_b}Usage${_r}\n"
  printf "  hyprconf addon               List available addons and their status\n"
  printf "  hyprconf addon <name>        Install a named addon\n"
  printf "\n${_b}Available addons${_r}\n"
  local name
  for name in "${_ADDON_NAMES[@]}"; do
    printf "  %-16s %s\n" "$name" "$(_addon_description "$name")"
  done
}

_addon_list() {
  printf "${_b}Available addons${_r}\n\n"
  local name status_str
  for name in "${_ADDON_NAMES[@]}"; do
    if _addon_is_installed "$name" 2>/dev/null; then
      status_str="${_g}installed${_r}"
    else
      status_str="${_y}not installed${_r}"
    fi
    printf "  ${_b}%-14s${_r}  %b\n" "$name" "$status_str"
    printf "                   %s\n" "$(_addon_description "$name")"
  done
}

_addon_install() {
  local name="$1"
  local pkgs; pkgs="$(_addon_packages "$name")"
  local aur_pkgs; aur_pkgs="$(_addon_aur_packages "$name")"

  if [[ -n "$pkgs" ]]; then
    printf "${_b}→${_r} Installing %s addon packages: %s...\n" "$name" "$pkgs"
    # shellcheck disable=SC2086
    sudo pacman -S --noconfirm --needed $pkgs \
      && printf "${_g}✓${_r} Packages installed.\n" \
      || printf "${_y}⚠${_r} One or more pacman packages failed to install — check output above.\n"
  fi

  if [[ -n "$aur_pkgs" ]]; then
    # AUR packages are never installed silently. hyprconf's policy is to install
    # only official-repo packages automatically; anything from the AUR is built
    # from source, unvetted by Arch, and must be confirmed explicitly.
    printf "\n${_y}⚠  WARNING${_r} — the '%s' addon includes AUR package(s):\n" "$name"
    printf "     ${_b}%s${_r}\n" "$aur_pkgs"
    printf "   ${_y}AUR packages are built from source and are NOT vetted by the official${_r}\n"
    printf "   ${_y}Arch repositories or by hyprconf. Install them only if you trust them.${_r}\n"
    if command -v yay &>/dev/null; then
      local _aur_ans=""
      if [[ -t 0 ]]; then
        printf "   ${_b}Install these AUR packages? [y/N]${_r} "
        read -r _aur_ans
      else
        printf "${_y}⚠${_r} Non-interactive shell — AUR packages skipped (cannot confirm).\n"
      fi
      case "${_aur_ans,,}" in
        y|yes)
          printf "${_b}→${_r} Installing %s AUR packages: %s...\n" "$name" "$aur_pkgs"
          # No --noconfirm: let yay show its own PKGBUILD/diff review for AUR safety.
          # shellcheck disable=SC2086
          yay -S --needed $aur_pkgs \
            && printf "${_g}✓${_r} AUR packages installed.\n" \
            || printf "${_y}⚠${_r} One or more AUR packages failed to install — check output above.\n"
          ;;
        *)
          printf "${_y}⚠${_r} Skipped AUR packages. To install manually: ${_c}yay -S %s${_r}\n" "$aur_pkgs"
          ;;
      esac
    else
      printf "${_y}⚠${_r} yay not found — skipping AUR packages: %s\n" "$aur_pkgs"
      printf "${_y}⚠${_r} Install yay first, then re-run: hyprconf addon %s\n" "$name"
    fi
  fi

  _addon_post_install "$name"
  printf "${_g}✓${_r} Addon '%s' installation complete.\n" "$name"
}

cmd_addon() {
  local name="${1:-}"
  shift || true
  case "$name" in
    help|-h|--help|"") _addon_list ;;
    *)
      local valid=false n
      for n in "${_ADDON_NAMES[@]}"; do
        [[ "$n" == "$name" ]] && valid=true && break
      done
      if ! $valid; then
        printf "${_y}Unknown addon: %s${_r}\n\n" "$name" >&2
        _addon_usage >&2
        exit 1
      fi
      _addon_install "$name" "$@"
      ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf yubikey — FIDO2+PIN auth for sudo/login/SSH/LUKS
# ════════════════════════════════════════════════════════════════════════════

_yk_usage() {
  printf "${_b}hyprconf yubikey${_r} — YubiKey FIDO2+PIN authentication\n\n"
  printf "  hyprconf yubikey status       Show keys, PAM coverage, and LUKS FIDO2 slots\n"
  printf "  hyprconf yubikey setup        Full FIDO2+PIN setup (sudo/TTY/DM/SSH/LUKS)\n"
  printf "  hyprconf yubikey enroll       Enroll an additional / backup key\n"
  printf "  hyprconf yubikey harden-luks  Remove passphrase → key-only LUKS (recovery key first)\n"
}

# Run the YubiKey script as an action, escalating to root when needed (the
# script edits system files and reads root-owned credentials/keyslots).
_yk_run() {
  local action="$1"
  if [[ $EUID -eq 0 ]]; then
    exec "$YUBIKEY_SCRIPT" "$action"
  elif command -v sudo &>/dev/null; then
    exec sudo "$YUBIKEY_SCRIPT" "$action"
  else
    die "Root required — run: sudo $YUBIKEY_SCRIPT $action"
  fi
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf vpn — NetworkManager VPN control + kill-switch
# ════════════════════════════════════════════════════════════════════════════

cmd_vpn() {
  if [[ ! -x "$VPN_SCRIPT" ]]; then
    die "VPN helper not found: $VPN_SCRIPT\nRun 'hyprconf sync' to restore it."
  fi
  exec "$VPN_SCRIPT" "$@"
}

cmd_yubikey() {
  if [[ ! -x "$YUBIKEY_SCRIPT" ]]; then
    die "YubiKey script not found: $YUBIKEY_SCRIPT\nRun 'hyprconf sync' to restore it."
  fi
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    status|list|"")     _yk_run status ;;
    setup)              _yk_run setup ;;
    enroll|add|add-key) _yk_run enroll ;;
    harden-luks|key-only) _yk_run harden-luks ;;
    help|-h|--help)     _yk_usage ;;
    *)
      printf "${_y}Unknown yubikey subcommand: %s${_r}\n\n" "$sub" >&2
      _yk_usage >&2
      exit 1
      ;;
  esac
}

_sb_usage() {
  printf "${_b}hyprconf secureboot${_r} — Secure Boot (signed UKI) + key-only LUKS\n\n"
  printf "  hyprconf secureboot status       SB state, Setup Mode, UKI, sbctl verify, factors\n"
  printf "  hyprconf secureboot setup        sbctl + signed UKI + keys/sign/verify/enroll/hook\n"
  printf "  hyprconf secureboot enroll       Enroll keys into firmware (requires Setup Mode)\n"
  printf "  hyprconf secureboot sign         (Re)sign + verify the boot chain\n"
  printf "  hyprconf secureboot verify       Run 'sbctl verify'\n"
  printf "  hyprconf secureboot tpm-bind     Optional: bind LUKS unlock to TPM2 PCRs\n"
  printf "  hyprconf secureboot harden       Key-only LUKS (remove the passphrase slot)\n"
}

# Run the Secure Boot helper, escalating to root: it edits boot config, signs EFI
# binaries, enrolls firmware keys, and reads root-owned LUKS keyslot metadata.
_sb_run() {
  if [[ $EUID -eq 0 ]]; then
    exec "$SECUREBOOT_SCRIPT" "$@"
  elif command -v sudo &>/dev/null; then
    exec sudo "$SECUREBOOT_SCRIPT" "$@"
  else
    die "Root required — run: sudo $SECUREBOOT_SCRIPT $*"
  fi
}

cmd_secureboot() {
  if [[ ! -x "$SECUREBOOT_SCRIPT" ]]; then
    die "Secure Boot script not found: $SECUREBOOT_SCRIPT\nRun 'hyprconf sync' to restore it."
  fi
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    status|list|info|"")            _sb_run status "$@" ;;
    setup)                          _sb_run setup "$@" ;;
    enroll|enroll-keys|add)         _sb_run enroll "$@" ;;
    sign|sign-all)                  _sb_run sign "$@" ;;
    verify)                         _sb_run verify "$@" ;;
    tpm-bind|tpm)                   _sb_run tpm-bind "$@" ;;
    harden|harden-luks|key-only)    _sb_run harden "$@" ;;
    ack-firmware-password|ack-fwpw) _sb_run ack-firmware-password "$@" ;;
    help|-h|--help)                 _sb_usage ;;
    *)
      printf "${_y}Unknown secureboot subcommand: %s${_r}\n\n" "$sub" >&2
      _sb_usage >&2
      exit 1
      ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    secureboot|sb)    cmd_secureboot "$@" ;;
    theme)            cmd_theme "$@" ;;
    sync)             cmd_sync "$@" ;;
    repair)           cmd_repair ;;
    monitor)          cmd_monitor "$@" ;;
    display)          cmd_display "$@" ;;
    set)              cmd_set "$@" ;;
    get)              cmd_get "$@" ;;
    configure|conf)   cmd_configure "$@" ;;
    tui)              cmd_tui "$@" ;;
    show)             cmd_show "$@" ;;
    schema)           cmd_schema "$@" ;;
    autodetect)       cmd_autodetect "$@" ;;
    keybind)          cmd_keybind "$@" ;;
    rule)             cmd_rule "$@" ;;
    lock)             cmd_lock "$@" ;;
    idle)             cmd_idle "$@" ;;
    paper)            cmd_paper "$@" ;;
    hardware)         cmd_hardware "$@" ;;
    yubikey|yk)       cmd_yubikey "$@" ;;
    vpn)              cmd_vpn "$@" ;;
    doctor)           cmd_doctor ;;
    clipboard|clip)   cmd_clipboard "$@" ;;
    screenshot|ss)    cmd_screenshot "$@" ;;
    gamemode|game)    cmd_gamemode "$@" ;;
    power)            cmd_power "$@" ;;
    power-profile|pp) cmd_power_profile "$@" ;;
    nightlight|night) cmd_nightlight "$@" ;;
    colorpicker|color) cmd_colorpicker "$@" ;;
    record|rec)       cmd_record "$@" ;;
    addon)            cmd_addon "$@" ;;
    dev)              cmd_dev "$@" ;;
    help|-h|--help)   usage ;;
    *)
      printf "${_y}Unknown command: %s${_r}\n\n" "$cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

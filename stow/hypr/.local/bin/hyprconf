}

cmd_keybind() {
  python3 "$CLI_LIB/cli.py" keybind "$@"
}

cmd_rule() {
  python3 "$CLI_LIB/cli.py" rule "$@"
}

cmd_lock() {
  python3 "$CLI_LIB/cli.py" lock "$@"
}

cmd_idle() {

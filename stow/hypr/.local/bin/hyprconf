# List keys for a given section
_section_keys() {
  case "$1" in
    general) echo "border_size gaps_in gaps_out float_gaps gaps_workspaces col.inactive_border col.active_border col.nogroup_border layout no_focus_fallback resize_on_border extend_border_grab_area hover_icon_on_border allow_tearing resize_corner modal_parent_blocking" ;;
    general.snap) echo "enabled window_gap monitor_gap border_overlap respect_gaps" ;;
    decoration) echo "rounding rounding_power active_opacity inactive_opacity fullscreen_opacity dim_modal dim_inactive dim_strength dim_special dim_around screen_shader border_part_of_window" ;;
    decoration.blur) echo "enabled size passes ignore_opacity new_optimizations xray noise contrast brightness vibrancy vibrancy_darkness special popups popups_ignorealpha" ;;
    decoration.shadow) echo "enabled range render_power sharp ignore_window color color_inactive offset scale" ;;
    animations) echo "enabled workspace_wraparound" ;;
    input) echo "kb_layout kb_variant kb_model kb_options kb_rules numlock_by_default resolve_binds_by_sym repeat_rate repeat_delay sensitivity accel_profile force_no_accel left_handed scroll_method scroll_factor scroll_button scroll_button_lock natural_scroll follow_mouse focus_on_close mouse_refocus float_switch_override_focus special_fallthrough off_window_axis_events emulate_discrete_scroll" ;;
    input.touchpad) echo "disable_while_typing natural_scroll scroll_factor middle_button_emulation clickfinger_behavior tap-to-click drag_lock tap-and-drag flip_x flip_y" ;;
    gestures) echo "workspace_swipe_distance workspace_swipe_touch workspace_swipe_invert workspace_swipe_touch_invert workspace_swipe_min_speed_to_force workspace_swipe_cancel_ratio workspace_swipe_create_new workspace_swipe_direction_lock workspace_swipe_direction_lock_threshold workspace_swipe_forever workspace_swipe_use_r" ;;
    group) echo "auto_group insert_after_current focus_removed_window drag_into_group col.border_active col.border_inactive col.border_locked_active col.border_locked_inactive" ;;
    group.groupbar) echo "enabled font_size gradients height stacked render_titles scrolling rounding rounding_power text_color col.active col.inactive col.locked_active col.locked_inactive" ;;
    misc) echo "disable_hyprland_logo disable_splash_rendering force_default_wallpaper vfr vrr mouse_move_enables_dpms key_press_enables_dpms animate_manual_resizes animate_mouse_windowdragging disable_autoreload enable_swallow swallow_regex swallow_exception_regex focus_on_activate mouse_move_focuses_monitor allow_session_lock_restore background_color close_special_on_empty initial_workspace_tracking middle_click_paste render_unfocused_fps disable_xdg_env_checks lockdead_screen_delay" ;;
    binds) echo "pass_mouse_when_bound scroll_event_delay workspace_back_and_forth hide_special_on_workspace_change allow_workspace_cycles workspace_center_on focus_preferred_method ignore_group_lock movefocus_cycles_fullscreen movefocus_cycles_groupfirst window_direction_monitor_fallback disable_keybind_grabbing allow_pin_fullscreen drag_threshold" ;;
    cursor) echo "no_hardware_cursors min_refresh_rate hotspot_padding inactive_timeout no_warps persistent_warps warp_on_change_workspace default_monitor zoom_factor zoom_rigid enable_hyprcursor hide_on_key_press hide_on_touch" ;;
    render) echo "direct_scanout expand_undersized_textures cm_fs_passthrough cm_enabled" ;;
    opengl) echo "nvidia_anti_flicker" ;;
    xwayland) echo "enabled use_nearest_neighbor force_zero_scaling" ;;
    dwindle) echo "pseudotile force_split preserve_split smart_split smart_resizing permanent_direction_override use_active_for_splits default_split_ratio" ;;
    master) echo "allow_small_split special_scale_factor mfact new_client_position new_status inherit_fullscreen smart_resizing drop_at_cursor" ;;
    *) echo "" ;;
  esac
}

# Canonical Hyprland section name (for hyprctl getoption / keyword)
# Most sections use "section:key" but subcategories differ:
#   "decoration.blur" → "decoration:blur:enabled" in hyprctl
_hyprctl_key() {
  local section="$1" key="$2"
  # Subcategories use colon-separated path: general.snap → general:snap:key
  local hypr_section
  hypr_section="${section//./:}"
  printf '%s:%s' "$hypr_section" "$key"
}

# Read current value from hyprctl getoption; echo value or empty on failure.
_hyprctl_get_value() {
  local hkey="$1"
  command -v hyprctl &>/dev/null || return 1
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 1
  local raw
  raw="$(hyprctl getoption "$hkey" -j 2>/dev/null)" || return 1
  # Extract the most meaningful field from JSON
  local v
  v="$(printf '%s' "$raw" | python3 -c "
import json, sys
d = json.load(sys.stdin)
# str field: used by string, color, gradient options (non-empty when relevant)
s = str(d.get('str') or '')
if s.strip():
    print(s)
    sys.exit(0)
# float: use when it has a meaningful fractional component distinct from int
f = d.get('float', 0.0)
i = d.get('int', 0)
if f != 0.0 and f != float(i):
    print(f)
    sys.exit(0)
# int: always print (covers bool 0/1, int 0, and floats like 1.0)
print(i)
" 2>/dev/null)" || true
  printf '%s' "$v"
}

# Read a persisted value from the overrides file.
# Echos the value string or nothing if not found.
_read_persisted_value() {
  local hkey="$1"
  local file="$HYPR_LOCAL_OVERRIDES"
  [[ -f "$file" ]] || return 0
  grep -m1 -F "${hkey} =" "$file" 2>/dev/null | sed -E 's/^[^=]+=\s*//' | sed 's/[[:space:]]*$//' || true
}

# Apply a value at runtime via hyprctl keyword.
_hyprctl_apply() {
  local hkey="$1" value="$2"
  command -v hyprctl &>/dev/null || return 1
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 1
  hyprctl keyword "$hkey" "$value" &>/dev/null
}

# Upsert key=value in the overrides file (persistent).
# Uses Python for safe string handling — values may contain sed delimiters.
_persist_option() {
  local section="$1" key="$2" value="$3"
  local hkey; hkey="$(_hyprctl_key "$section" "$key")"
  local file="$HYPR_LOCAL_OVERRIDES"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  python3 - "$hkey" "$value" "$file" <<'PY'
import sys, re
hkey, value, path = sys.argv[1], sys.argv[2], sys.argv[3]
pattern = re.compile(r'^' + re.escape(hkey) + r'\s*=', re.MULTILINE)
with open(path) as f:
    lines = f.readlines()
new_line = f'{hkey} = {value}\n'
replaced = False
result = []
for ln in lines:
    if pattern.match(ln):
        result.append(new_line)
        replaced = True
    else:
        result.append(ln)
if not replaced:
    result.append(new_line)
with open(path, 'w') as f:
    f.writelines(result)
PY
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf get  — read current option values
# ════════════════════════════════════════════════════════════════════════════

cmd_get() {
  local section="${1:-}"
  local key="${2:-}"

  [[ -n "$section" ]] || {
    printf "${_b}Available sections:${_r}\n"
    printf '  monitors\n'
    printf '  general  general.snap  decoration  decoration.blur  decoration.shadow\n'
    printf '  animations  input  input.touchpad  gestures  group  group.groupbar\n'
    printf '  misc  binds  cursor  render  opengl  xwayland  dwindle  master\n'
    return 0
  }

  # Special section: monitors
  if [[ "$section" == "monitors" ]]; then
    python3 "$CLI_LIB/cli.py" monitor field show ${key:+"$key"}
    return $?
  fi

  local keys
  keys="$(_section_keys "$section")"
  [[ -n "$keys" ]] || die "Unknown section: $section  (run: hyprconf get for a list)"

  if [[ -n "$key" ]]; then
    local meta
    meta="$(_option_meta "$section" "$key")"
    [[ -n "$meta" ]] || die "Unknown option '$key' in section '$section'"
    local type default desc
    IFS='|' read -r type default desc <<<"$meta"
    local hkey; hkey="$(_hyprctl_key "$section" "$key")"
    local current; current="$(_hyprctl_get_value "$hkey" 2>/dev/null || true)"
    [[ -z "$current" ]] && current="$(_read_persisted_value "$hkey")"
    [[ -z "$current" ]] && current="(${default})"
    printf '%-40s  %s\n' "${_b}${section}:${key}${_r}" "${_c}${current}${_r}"
    printf '  type: %s   default: %s\n' "$type" "$default"
    printf '  %s\n' "$desc"
  else
    printf "${_b}${section}${_r}\n"
    printf '%-40s  %-22s  %s\n' "  KEY" "CURRENT" "DEFAULT"
    printf '  %-38s  %-22s  %s\n' "$(printf '%0.s─' {1..38})" "$(printf '%0.s─' {1..22})" "$(printf '%0.s─' {1..12})"
    local k
    for k in $keys; do
      local meta; meta="$(_option_meta "$section" "$k")"
      [[ -n "$meta" ]] || continue
      local type default desc
      IFS='|' read -r type default desc <<<"$meta"
      local hkey; hkey="$(_hyprctl_key "$section" "$k")"
      local current; current="$(_hyprctl_get_value "$hkey" 2>/dev/null || true)"
      [[ -z "$current" ]] && current="$(_read_persisted_value "$hkey")"
      [[ -z "$current" ]] && current="${_y}(${default})${_r}"
      printf "  %-38s  ${_c}%-22s${_r}  %s\n" "$k" "$current" "$default"
    done
  fi
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf set  — set a Hyprland option (runtime + persistent)
# ════════════════════════════════════════════════════════════════════════════

cmd_set_keyword() {
  local section="${1:-}"
  local key="${2:-}"
  local value="${3:-}"

  [[ -n "$section" && -n "$key" && -n "$value" ]] || {
    die "Usage: hyprconf set <section> <key> <value>\nExample: hyprconf set general gaps_in 8"
  }

  # Special section: monitors — key=<name>  value=<field> <fieldvalue>
  if [[ "$section" == "monitors" ]]; then
    local mon_name="$key"
    local -a fv_parts=()
    read -r -a fv_parts <<<"$value"
    if (( ${#fv_parts[@]} < 2 )); then
      die "Usage: hyprconf set monitors <name> <field> <value>\nExample: hyprconf set monitors HDMI-A-1 vrr 1"
    fi
    python3 "$CLI_LIB/cli.py" monitor field set "$mon_name" "${fv_parts[0]}" "${fv_parts[*]:1}"
    return $?
  fi

  local meta; meta="$(_option_meta "$section" "$key")"
  [[ -n "$meta" ]] || die "Unknown option '$key' in section '$section'  (try: hyprconf get $section)"

  local type default _desc
  IFS='|' read -r type default _desc <<<"$meta"

  # Basic type validation
  case "$type" in
    int)
      [[ "$value" =~ ^-?[0-9]+$ ]] || die "Value must be an integer, got: $value" ;;
    float)
      [[ "$value" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || die "Value must be a number, got: $value" ;;
    bool)
      case "${value,,}" in true|false|yes|no|on|off|0|1) ;; *) die "Value must be true/false, got: $value" ;; esac ;;
    enum:*)
      local choices="${type#enum:}"
      local valid=0
      IFS=',' read -r -a opts <<<"$choices"
      for opt in "${opts[@]}"; do
        [[ "$value" == "$opt" ]] && valid=1 && break
      done
      (( valid == 1 )) || die "Invalid value '$value'. Choices: $(echo "$choices" | tr ',' ' ')" ;;
  esac

  local hkey; hkey="$(_hyprctl_key "$section" "$key")"

  if _hyprctl_apply "$hkey" "$value"; then
    printf "${_b}Applied:${_r}  ${_c}%s${_r} = %s\n" "$hkey" "$value"
  else
    printf "${_y}Warning: Hyprland not running — change written to config only.${_r}\n"
  fi

  _persist_option "$section" "$key" "$value"
  printf "${_b}Persisted:${_r} %s\n" "$HYPR_LOCAL_OVERRIDES"
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf configure  — interactive Cisco IOS-style REPL
# ════════════════════════════════════════════════════════════════════════════

_repl_sections=(
  monitors
  general general.snap
  decoration decoration.blur decoration.shadow
  animations
  input input.touchpad
  gestures
  group group.groupbar
  misc binds cursor
  render opengl xwayland
  dwindle master
)

_repl_help_root() {
  printf '\n%s  Available sections:%s\n' "$_b" "$_r"
  local s
  for s in "${_repl_sections[@]}"; do
    if [[ "$s" == "monitors" ]]; then
      printf '  %-22s  %s\n' "monitors" "<name> <field> <value>"
    else
      local first_key; first_key="$(  _section_keys "$s" | awk '{print $1}')"
      printf '  %-22s  %s\n' "$s" "${first_key:+<${first_key}> ...}"
    fi
  done
  printf '\n'
  printf '  %-22s  %s\n' "?" "Show this help"
  printf '  %-22s  %s\n' "exit / quit" "Leave configure mode"
  printf '\n'
}

_repl_help_monitors() {
  printf '\n%s  monitors — per-monitor configuration%s\n' "$_b" "$_r"
  printf '  %-20s  %-8s  %s\n' "FIELD" "TYPE" "DESCRIPTION"
  printf '  %-20s  %-8s  %s\n' "$(printf '%0.s─' {1..20})" "$(printf '%0.s─' {1..8})" "$(printf '%0.s─' {1..30})"
  printf '  %-20s  %-8s  %s\n' "res"           "string" "Resolution@Hz  (e.g. 1920x1080@60 or preferred)"
  printf '  %-20s  %-8s  %s\n' "pos"           "string" "Position  (e.g. 0x0 or auto-right)"
  printf '  %-20s  %-8s  %s\n' "scale"         "float"  "Scale factor  (e.g. 1.5)"
  printf '  %-20s  %-8s  %s\n' "vrr"           "0|1|2"  "Adaptive sync  (0=off 1=on 2=fullscreen)"
  printf '  %-20s  %-8s  %s\n' "bitdepth"      "8|10"   "Bit depth"
  printf '  %-20s  %-8s  %s\n' "cm"            "string" "Colour management  (srgb wide hdr10 …)"
  printf '  %-20s  %-8s  %s\n' "sdrbrightness" "float"  "SDR brightness multiplier in HDR mode"
  printf '  %-20s  %-8s  %s\n' "sdrsaturation" "float"  "SDR saturation multiplier in HDR mode"
  printf '  %-20s  %-8s  %s\n' "transform"     "0-7"    "Display rotation / transform"
  printf '  %-20s  %-8s  %s\n' "mirror"        "string" "Mirror another monitor by name"
  printf '\n'
  printf '  %-40s  %s\n' "show"                   "List all configured monitors"
  printf '  %-40s  %s\n' "show <name>"             "Show fields for a specific monitor"
  printf '  %-40s  %s\n' "<name> <field> <value>"  "Set a monitor field"
  printf '  %-40s  %s\n' "exit"                    "Return to root context"
  printf '\n'
}

_repl_help_section() {
  local section="$1"
  if [[ "$section" == "monitors" ]]; then
    _repl_help_monitors
    return
  fi
  printf '\n%s  %s options:%s\n' "$_b" "$section" "$_r"
  printf '  %-40s  %-12s  %-18s  %s\n' "KEY" "TYPE" "DEFAULT" "DESCRIPTION"
  printf '  %-40s  %-12s  %-18s\n' "$(printf '%0.s─' {1..40})" "$(printf '%0.s─' {1..12})" "$(printf '%0.s─' {1..18})"
  local k
  for k in $(_section_keys "$section"); do
    local meta; meta="$(_option_meta "$section" "$k")"
    [[ -n "$meta" ]] || continue
    local type default desc
    IFS='|' read -r type default desc <<<"$meta"
    # Shorten enum types
    [[ "$type" == enum:* ]] && type="enum"
    printf '  %-40s  %-12s  %-18s  %s\n' "$k" "$type" "$default" "$desc"
  done
  printf '\n'
  printf '  %-40s  %s\n' "<key> <value>" "Set option"
  printf '  %-40s  %s\n' "<key> ?" "Show option details and current value"
  printf '  %-40s  %s\n' "no <key>" "Reset option to its default value"
  printf '  %-40s  %s\n' "show [key]" "Show current value(s)"
  printf '  %-40s  %s\n' "exit" "Return to root context"
  printf '\n'
}

cmd_configure() {
  [[ -t 0 && -t 1 ]] || die "configure requires an interactive TTY"

  printf '\n%s  hyprconf configure%s  — interactive configuration mode\n' "$_b" "$_r"
  printf '%s  Type "?" for help, "exit" to leave.%s\n\n' "$_c" "$_r"

  local context=""  # empty = root, otherwise = section name

  while true; do
    local prompt line
    if [[ -z "$context" ]]; then
      prompt="hyprconf(config)# "
    else
      prompt="hyprconf(config-${context})# "
    fi

    IFS= read -e -r -p "$prompt" line || { printf '\n'; break; }
    [[ -n "$line" ]] && history -s "$line"
    # Trim leading/trailing whitespace without a subshell
    line="${line#"${line%%[! ]*}"}"
    line="${line%"${line##*[! ]}"}"
    [[ -z "$line" ]] && continue

    if [[ -z "$context" ]]; then
      case "$line" in
        exit|quit|q) printf 'Leaving configure mode.\n'; break ;;
        "?"|help) _repl_help_root ;;
        *)
          local matched=0 s
          for s in "${_repl_sections[@]}"; do
            if [[ "$line" == "$s" ]]; then
              context="$s"; matched=1; break
            fi
          done
          if (( matched == 0 )); then
            printf '%s  Unknown section: %s%s\n' "$_y" "$line" "$_r"
            printf '  Type "?" to list sections.\n'
          fi
          ;;
      esac
    else
      case "$line" in
        exit|quit|q|up) context="" ;;
        "?"|help)    _repl_help_section "$context" ;;
        show)        cmd_get "$context" ;;
        show\ *)     cmd_get "$context" "${line#show }" ;;
        no\ *)
          if [[ "$context" == "monitors" ]]; then
            printf '%s  "no" is not applicable for monitors. Use: <name> <field> <value>%s\n' "$_y" "$_r"
          else
            local reset_key="${line#no }"
            local meta; meta="$(_option_meta "$context" "$reset_key")"
            [[ -n "$meta" ]] || { printf '%s  Unknown key: %s%s\n' "$_y" "$reset_key" "$_r"; continue; }
            local _type _default _desc
            IFS='|' read -r _type _default _desc <<<"$meta"
            cmd_set_keyword "$context" "$reset_key" "$_default"
          fi
          ;;
        *"?")
          if [[ "$context" == "monitors" ]]; then
            local mon_name="${line% \?}"
            cmd_get "monitors" "$mon_name"
          else
            local qkey="${line% \?}"
            local meta; meta="$(_option_meta "$context" "$qkey")"
            [[ -n "$meta" ]] && cmd_get "$context" "$qkey" \
              || printf '%s  Unknown key: %s%s\n' "$_y" "$qkey" "$_r"
          fi
          ;;
        *)
          local -a parts=()
          read -r -a parts <<<"$line"
          if [[ "$context" == "monitors" ]]; then
            if (( ${#parts[@]} >= 3 )); then
              # <name> <field> <value>
              cmd_set_keyword "monitors" "${parts[0]}" "${parts[*]:1}"
            elif (( ${#parts[@]} == 1 )); then
              cmd_get "monitors" "${parts[0]}"
            else
              printf '%s  Usage: <name> <field> <value>  or  show [<name>]%s\n' "$_y" "$_r"
            fi
          elif (( ${#parts[@]} >= 2 )); then
            cmd_set_keyword "$context" "${parts[0]}" "${parts[*]:1}"
          elif (( ${#parts[@]} == 1 )); then
            cmd_get "$context" "${parts[0]}"
          fi
          ;;
      esac
    fi
  done
}

# ════════════════════════════════════════════════════════════════════════════
#  hyprconf tui  — launch Python Textual TUI
# ════════════════════════════════════════════════════════════════════════════

cmd_tui() {
  if [[ ! -f "$TUI_SCRIPT" ]]; then
    die "TUI script not found at $TUI_SCRIPT\nRe-run the hyprconf install script to install it:\n  curl -fsSL https://raw.githubusercontent.com/ak4dev/.hyprconf/stable/install/install.sh | bash"
  fi

  if ! command -v python3 &>/dev/null; then
    die "python3 is required for the TUI"
  fi

  if ! python3 -c "import textual" &>/dev/null; then
    die "python-textual is not installed.\nInstall with: sudo pacman -S python-textual"
  fi

  exec python3 "$TUI_SCRIPT" "$@"
}


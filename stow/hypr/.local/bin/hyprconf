  printf "  hyprconf theme list              Pretty colour table of all themes\n"
  printf "  hyprconf theme pick              Select via hyprlauncher\n"
  printf "  hyprconf theme filter <str>      Filter themes in TUI\n"
  printf "  hyprconf theme generate <image>  Generate theme from wallpaper image\n"
  printf "\n${_b}Sync / Repair${_r}\n"

#!/usr/bin/env bash
# touch-panel-launcher — start touch-panel at session start only when no
# physical keyboard is connected.
#
# A physical keyboard has both ID_INPUT_KEYBOARD=1 and a non-empty PHYS
# (bus address) in its sysfs uevent.  Virtual keys (power button, etc.)
# have ID_INPUT_KEYBOARD=1 but an empty or absent PHYS.
#
# exec-once = touch-panel-launcher   (emitted by write_hardware_conf when
#                                      a touchscreen is detected)
set -euo pipefail

for f in /sys/class/input/*/device/uevent; do
    grep -q '^ID_INPUT_KEYBOARD=1' "$f" 2>/dev/null \
        && grep -E -q '^PHYS=.+' "$f" 2>/dev/null \
        && exit 0  # physical keyboard present — touch panel not needed
done

exec touch-panel

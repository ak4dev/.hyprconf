#!/usr/bin/env -S python3 -B
"""
touch-panel — minimal floating action panel for touch-only Hyprland devices.

A small overlay button anchored to the bottom-right corner of the screen.
Tap the FAB (☰) to expand: shows an OSK toggle (⌨) and launcher (⊞) button.
Reads colors from ~/.config/touch-panel/colors (written by the theme-switcher).
Reloads colors in-place on SIGUSR1 — no restart needed for theme changes.

Requires: python-gobject, gtk-layer-shell
"""
import os
import signal as pysignal
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GLib, Gtk, GtkLayerShell  # noqa: E402

COLORS_FILE = Path.home() / ".config" / "touch-panel" / "colors"
BTN_SIZE    = 56
MARGIN      = 16
PADDING     = 8
SPACING     = 8

_CSS = """\
window, .background {{
    background-color: transparent;
}}
.tp-box {{
    background-color: {bg_alpha};
    border-radius: 32px;
    padding: {pad}px;
}}
.tp-btn {{
    background-color: {bg};
    color: {fg};
    border-radius: 28px;
    border: none;
    outline: none;
    font-size: 22px;
    min-width:  {sz}px;
    min-height: {sz}px;
    padding: 0;
}}
.tp-btn:hover,
.tp-btn:active {{
    background-color: {accent};
    color: {bg};
}}
"""


def _hex_to_rgba(hex_color: str, alpha: float) -> str:
    """Convert #rrggbb → rgba(r,g,b,alpha) for GTK3 CSS compatibility.
    GTK3 does not support 8-digit hex colors (#rrggbbaa).
    """
    h = hex_color.lstrip("#")
    if len(h) == 6:
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return f"rgba({r}, {g}, {b}, {alpha})"
    return hex_color


def _load_colors() -> dict:
    defaults = {"bg": "#1e1e2e", "fg": "#cdd6f4", "accent": "#89b4fa"}
    if not COLORS_FILE.exists():
        return dict(defaults)
    colors = dict(defaults)
    try:
        for line in COLORS_FILE.read_text(encoding="utf-8").splitlines():
            if "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            if k in colors and len(v) == 7 and v.startswith("#"):
                colors[k] = v
    except OSError:
        pass
    return colors


class TouchPanel(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="touch-panel")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_app_paintable(True)
        self._expanded = False
        self._colors   = _load_colors()
        self._provider = Gtk.CssProvider()

        self._setup_layer_shell()
        self._build_ui()
        self._apply_css()

        self.connect("delete-event", Gtk.main_quit)

        pysignal.signal(
            pysignal.SIGUSR1,
            lambda *_: GLib.idle_add(self._reload_colors),
        )

    def _setup_layer_shell(self) -> None:
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, MARGIN)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, MARGIN)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)

    def _build_ui(self) -> None:
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SPACING)
        outer.get_style_context().add_class("tp-box")

        self._expand_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=SPACING
        )
        # set_no_show_all prevents show_all() on the window from recursing
        # into this box, so the expand menu stays collapsed until the FAB is
        # tapped.  NOTE: set_no_show_all also makes show_all() on the box
        # itself a no-op, so we must show each child button individually here
        # and use show()/hide() (not show_all()) in _on_fab.
        self._expand_box.set_no_show_all(True)

        self._btn_launcher = self._make_btn("⊞", self._on_launcher)
        self._btn_osk      = self._make_btn("⌨", self._on_osk)
        self._expand_box.pack_start(self._btn_launcher, False, False, 0)
        self._expand_box.pack_start(self._btn_osk,      False, False, 0)
        self._btn_launcher.show()
        self._btn_osk.show()

        self._btn_fab = self._make_btn("☰", self._on_fab)

        outer.pack_start(self._expand_box, False, False, 0)
        outer.pack_start(self._btn_fab,    False, False, 0)
        self.add(outer)

    def _make_btn(self, label: str, handler) -> Gtk.Button:
        btn = Gtk.Button(label=label)
        btn.get_style_context().add_class("tp-btn")
        btn.set_size_request(BTN_SIZE, BTN_SIZE)
        btn.connect("clicked", handler)
        return btn

    def _apply_css(self) -> None:
        c   = self._colors
        css = _CSS.format(
            bg=c["bg"], fg=c["fg"], accent=c["accent"],
            bg_alpha=_hex_to_rgba(c["bg"], 0.93),
            sz=BTN_SIZE, pad=PADDING,
        )
        self._provider.load_from_data(css.encode())
        screen = self.get_screen()
        Gtk.StyleContext.add_provider_for_screen(
            screen, self._provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _reload_colors(self) -> bool:
        self._colors = _load_colors()
        self._apply_css()
        return GLib.SOURCE_REMOVE

    def _on_fab(self, _btn: Gtk.Button) -> None:
        self._expanded = not self._expanded
        # Children were shown individually in _build_ui; just toggle the box.
        # show_all() would be a no-op here because set_no_show_all is True.
        if self._expanded:
            self._expand_box.show()
        else:
            self._expand_box.hide()

    def _on_osk(self, _btn: Gtk.Button) -> None:
        toggle = Path.home() / ".local" / "bin" / "wvkbd-toggle"
        if toggle.exists():
            subprocess.Popen([str(toggle)])

    def _on_launcher(self, _btn: Gtk.Button) -> None:
        subprocess.Popen(["hyprlauncher"])
        self._expanded = False
        self._expand_box.set_visible(False)


def main() -> None:
    panel = TouchPanel()
    panel.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# touch-panel-watch — runtime keyboard hot-plug daemon for touchscreen devices.
#
# Monitors udev input events.  On any device removal, re-checks whether a
# physical keyboard is still connected.  If none remains and touch-panel is
# not already running, starts it.
#
# Only ever started on touchscreen devices (emitted by write_hardware_conf
# inside the touchscreen-detected block).  udevadm ships with systemd and
# requires no extra packages.
#
# exec-once = touch-panel-watch   (emitted by write_hardware_conf)
set -euo pipefail

_has_physical_keyboard() {
    local f
    for f in /sys/class/input/*/device/uevent; do
        grep -q '^ID_INPUT_KEYBOARD=1' "$f" 2>/dev/null \
            && grep -q '^PHYS=.\+' "$f" 2>/dev/null \
            && return 0
    done
    return 1
}

udevadm monitor --udev --subsystem-match=input | \
while IFS= read -r line; do
    [[ "$line" == *" remove "* ]] || continue
    sleep 0.3  # debounce — let sysfs settle after device removal
    _has_physical_keyboard && continue
    pgrep -f '[/]touch-panel$' >/dev/null 2>&1 && continue
    touch-panel &
done

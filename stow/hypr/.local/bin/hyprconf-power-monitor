#!/usr/bin/env bash
set -euo pipefail

# hyprconf-power-monitor — power profile management.
#
# Entry points:
#   udev, on AC plug/unplug   →  hyprconf-power-monitor auto
#   session start             →  hyprconf-power-monitor auto
#   the user                  →  hyprconf-power-monitor set <profile>
#                                hyprconf-power-monitor status
#
# `auto` applies the profile remembered for the current power state, falling
# back to performance on AC and power-saver on battery. `set` is what
# remembers: choose balanced on battery once and every later unplug returns to
# balanced, instead of the automation overriding the choice every time.
#
# Automatic switching stays battery-only — a machine with no battery is never
# switched behind the user's back — but `set` and `status` work anywhere.

readonly LOG_TAG="hyprconf-power"

# System paths, env-overridable so tests can point at a fake tree.
: "${_HYPRCONF_PS_ROOT:=/sys/class/power_supply}"
: "${_HYPRCONF_SESSION_CONF:=/usr/local/lib/hyprconf/power-monitor.conf}"

# Where the per-state remembered profiles live.
#
# udev executes its RUN+= program as root with a minimal environment — no HOME
# — and that is the path that matters most here, since plug/unplug is what
# triggers a switch. Deriving the directory from $HOME would resolve to
# "/.local/state" there and silently ignore everything the user chose. setup.sh
# therefore records the real location in a root-owned file beside the
# root-owned copy udev runs, and that file is consulted whenever $HOME is
# unusable. Whatever comes back is only ever used to read a profile *name*,
# which is then checked against powerprofilesctl's own list before it is
# applied — a writable state file cannot make root do anything the user could
# not already do with powerprofilesctl.
_state_dir() {
    if [[ -n "${_HYPRCONF_STATE_DIR:-}" ]]; then
        printf '%s\n' "$_HYPRCONF_STATE_DIR"
        return
    fi

    if [[ -z "${HOME:-}" || ! -d "${HOME:-}" ]] && [[ -r "$_HYPRCONF_SESSION_CONF" ]]; then
        local recorded
        recorded="$(sed -n 's/^state_dir=//p' "$_HYPRCONF_SESSION_CONF" | head -n1)"
        if [[ -n "$recorded" ]]; then
            printf '%s\n' "$recorded"
            return
        fi
    fi

    printf '%s/hyprconf\n' "${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}"
}

_log() { logger -t "$LOG_TAG" "$*" 2>/dev/null || true; }

if ! command -v powerprofilesctl &>/dev/null; then
    _log "powerprofilesctl not found — exiting."
    exit 0
fi

# ── Power supplies ──────────────────────────────────────────────────────────

# Any supply reporting type Battery, not just BAT*: Asahi and some ACPI
# implementations name theirs differently (macsmc-battery, CMB0).
_has_battery() {
    local t
    for t in "$_HYPRCONF_PS_ROOT"/*/type; do
        [[ -r "$t" ]] || continue
        [[ "$(< "$t")" == "Battery" ]] && return 0
    done
    return 1
}

# On AC if ANY mains-type supply is online. Modern laptops expose several — the
# barrel jack plus one per USB-C PD port — and deciding from the first one
# found reported "on battery" while charging over USB-C.
_ac_online() {
    local t online
    for t in "$_HYPRCONF_PS_ROOT"/*/type; do
        [[ -r "$t" ]] || continue
        [[ "$(< "$t")" == "Mains" ]] || continue
        online="${t%/type}/online"
        [[ -r "$online" ]] || continue
        [[ "$(< "$online")" == "1" ]] && return 0
    done
    return 1
}

# A machine with no battery is always on AC, even though it usually publishes
# no mains supply either.
_power_state() {
    if ! _has_battery; then
        printf 'ac\n'
    elif _ac_online; then
        printf 'ac\n'
    else
        printf 'battery\n'
    fi
}

# ── Profiles ────────────────────────────────────────────────────────────────

# `powerprofilesctl list` prints "  balanced:" / "* power-saver:" headers.
_available_profiles() {
    powerprofilesctl list 2>/dev/null | sed -n 's/^[[:space:]*]*\([a-z-]\{1,\}\):$/\1/p'
}

_profile_available() {
    _available_profiles | grep -qx -- "$1"
}

# First of the preferences the daemon actually offers: plenty of laptops expose
# only balanced and power-saver, and asking such a machine for performance used
# to fail and leave the profile wherever it was.
_first_available() {
    local p
    for p in "$@"; do
        if _profile_available "$p"; then
            printf '%s\n' "$p"
            return 0
        fi
    done
    return 1
}

_default_for_state() {
    case "$1" in
        ac)      _first_available performance balanced power-saver ;;
        battery) _first_available power-saver balanced performance ;;
    esac
}

_state_file() { printf '%s/power-profile.%s\n' "$(_state_dir)" "$1"; }

# A remembered profile the daemon no longer offers is ignored rather than
# applied — firmware and driver changes can retire one between boots.
_remembered_for_state() {
    local file profile
    file="$(_state_file "$1")"
    [[ -r "$file" ]] || return 1
    read -r profile < "$file" || return 1
    [[ -n "$profile" ]] || return 1
    _profile_available "$profile" || return 1
    printf '%s\n' "$profile"
}

_remember_for_state() {
    mkdir -p "$(_state_dir)" 2>/dev/null || return 0
    printf '%s\n' "$2" > "$(_state_file "$1")" 2>/dev/null || true
}

_current_profile() {
    powerprofilesctl get 2>/dev/null || echo "unknown"
}

_apply_profile() {
    local target="$1" current
    current="$(_current_profile)"
    if [[ "$current" == "$target" ]]; then
        _log "Profile already set to $target — no change."
        return 0
    fi
    if powerprofilesctl set "$target" 2>/dev/null; then
        _log "Switched power profile: $current → $target"
    else
        _log "Failed to set power profile to $target"
        return 1
    fi
}

# ── Commands ────────────────────────────────────────────────────────────────

_auto() {
    # Only laptops switch by themselves.
    _has_battery || exit 0

    local state target
    state="$(_power_state)"
    target="$(_remembered_for_state "$state" || _default_for_state "$state" || true)"
    if [[ -z "$target" ]]; then
        _log "No usable power profile for state $state — leaving as is."
        return 0
    fi
    _apply_profile "$target"
}

_set() {
    local target="${1:-}" state
    if [[ -z "$target" ]]; then
        printf "Usage: hyprconf-power-monitor set <profile>\n" >&2
        return 1
    fi
    if ! _profile_available "$target"; then
        printf "Unknown power profile: %s\nAvailable: %s\n" \
            "$target" "$(_available_profiles | tr '\n' ' ')" >&2
        return 1
    fi
    state="$(_power_state)"
    _apply_profile "$target" || return 1
    _remember_for_state "$state" "$target"
    printf "Power profile: %s (remembered for %s)\n" "$target" "$state"
}

_status() {
    local state ac_state remembered
    state="$(_power_state)"
    if [[ "$state" == "ac" ]]; then
        _has_battery && ac_state="plugged in (AC)" || ac_state="plugged in (AC, no battery)"
    else
        ac_state="on battery"
    fi

    printf "Power profile: %s\n" "$(_current_profile)"
    printf "AC adapter:    %s\n" "$ac_state"
    printf "Available:     %s\n" "$(_available_profiles | tr '\n' ' ')"
    for state in ac battery; do
        remembered="$(_remembered_for_state "$state" || true)"
        printf "Remembered %-8s %s\n" "$state:" "${remembered:-(default)}"
    done
}

case "${1:-auto}" in
    auto)   _auto ;;
    set)    shift; _set "${1:-}" ;;
    status) _status ;;
    *)
        printf "Usage: hyprconf-power-monitor [auto|set <profile>|status]\n" >&2
        exit 1
        ;;
esac

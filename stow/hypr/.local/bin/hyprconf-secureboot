#!/usr/bin/env bash
# hyprconf-secureboot — Secure Boot (signed UKI) setup & verification for Arch Linux
#
# Closes the evil-maid boot-tamper gap that defeats even a YubiKey-FIDO2 LUKS
# unlock: an attacker who can modify the unsigned initramfs captures the unwrapped
# LUKS master key the next time *you* unlock (PIN/touch don't help — you provide
# them to what looks like a normal boot). The fix is a signed Unified Kernel Image
# (kernel + initramfs + cmdline in one signed EFI binary) under Secure Boot, so a
# tampered image will not run; plus a firmware admin password so Secure Boot cannot
# simply be switched off. YubiKey FIDO2 stays the recommended decrypt factor; this
# also offers key-only LUKS (delegated to yubikey-fido2-setup) so the weak,
# login-reused passphrase slot cannot be brute-forced as a side door.
#
# Layers, all required together:
#   1. Secure Boot + signed UKI       — stops unsigned/tampered boot code
#   2. Firmware admin password        — stops Secure Boot being disabled / re-keyed
#   3. FIDO2 unlock (+ key-only LUKS)  — physical key to decrypt, no weak passphrase
#
# Every file edit is backed up; an unexpected error offers interactive rollback.

set -uo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────────
R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m'
B='\033[0;34m' C='\033[0;36m' W='\033[1m' N='\033[0m'

# ── Globals ───────────────────────────────────────────────────────────────────
BACKUP_DIR="/tmp/secureboot-backup-$(date +%Y%m%d-%H%M%S)"
# Per-run log set in main() via mktemp (a fixed /tmp path can be unwritable for
# root when a stale copy is owned by another user under fs.protected_regular).
LOG="/tmp/hyprconf-secureboot.log"
STATE_DIR="/var/lib/hyprconf"
FWPW_ACK="${STATE_DIR}/secureboot-firmware-password.ack"
VERIFY_HOOK="/etc/pacman.d/hooks/zz-hyprconf-sb-verify.hook"
KERNEL_CMDLINE="/etc/kernel/cmdline"
MKINITCPIO_PRESET="/etc/mkinitcpio.d/linux.preset"
# EFI global-variable GUID — SecureBoot / SetupMode live here.
EFI_GUID="8be4df61-93ca-11d2-aa0d-00e098032b8c"
# Key policy: 1 = keep Microsoft keys (--microsoft), 0 = own keys only, -1 = auto.
USE_MS_KEYS=-1
declare -a BACKED_UP=()

# ── Logging ───────────────────────────────────────────────────────────────────
log()  { printf '%b\n' "$*" | tee -a "$LOG" 2>/dev/null || true; }
info() { log "  ${G}[$(date +%H:%M:%S)]${N} $*"; }
warn() { log "  ${Y}[WARN]${N} $*"; }
err()  { log "  ${R}[ERR] ${N} $*"; }
step() { log "\n${W}${B}▶ $*${N}"; }
ok()   { log "  ${G}✓${N} $*"; }
fail() { log "  ${R}✗${N} $*"; }

# ── Prompts (always from /dev/tty so piped stdin doesn't break them) ──────────
ask_yn() {
    local msg="$1" def="${2:-y}"
    local hint; [[ "$def" == y ]] && hint="${G}Y${N}/n" || hint="y/${G}N${N}"
    while true; do
        printf '%b' "\n  ${C}?${N} $msg [${hint}]: " >/dev/tty
        IFS= read -r ans </dev/tty
        ans="${ans:-$def}"
        case "${ans,,}" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            *) printf '%b\n' "    Please answer y or n." >/dev/tty ;;
        esac
    done
}

ask_pick() {
    local outvar="$1" msg="$2"; shift 2
    local -a opts=("$@")
    printf '%b\n' "\n  ${C}?${N} $msg" >/dev/tty
    local i
    for i in "${!opts[@]}"; do
        printf '%b\n' "    $((i+1))) ${opts[$i]}" >/dev/tty
    done
    while true; do
        printf '    Choice [1-%d]: ' "${#opts[@]}" >/dev/tty
        IFS= read -r choice </dev/tty
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#opts[@]} )); then
            printf -v "$outvar" '%s' "${opts[$((choice-1))]}"
            return 0
        fi
        printf '%b\n' "    Invalid — enter 1 to ${#opts[@]}." >/dev/tty
    done
}

# ── Backup & Rollback ─────────────────────────────────────────────────────────
backup() {
    local f="$1"
    [[ -f "$f" ]] || return 0
    local already
    for already in "${BACKED_UP[@]:-}"; do
        [[ "$already" == "$f" ]] && return 0
    done
    local dst="${BACKUP_DIR}${f}"
    mkdir -p "$(dirname "$dst")"
    cp -a "$f" "$dst"
    BACKED_UP+=("$f")
    ok "Backed up: $f"
}

rollback() {
    warn "═══ ROLLING BACK FILE CHANGES ═══"
    local f
    for f in "${BACKED_UP[@]:-}"; do
        local src="${BACKUP_DIR}${f}"
        [[ -f "$src" ]] || { warn "No backup for $f — skip"; continue; }
        cp -a "$src" "$f"
        ok "Restored: $f"
    done
    warn "Backup files remain in: $BACKUP_DIR"
    warn "If the initramfs/UKI was rebuilt, run: mkinitcpio -P"
    warn "Secure Boot key enrollment is NOT auto-undone — use 'sbctl reset' in"
    warn "firmware Setup Mode if you need to remove enrolled keys."
}

die() {
    err "$*"
    if ask_yn "Roll back file changes made this run?" y; then rollback; fi
    exit 1
}

# ════════════════════════════════════════════════════════════════════════════
#  State detection (read-only; safe without changes)
# ════════════════════════════════════════════════════════════════════════════

require_uefi() {
    [[ -d /sys/firmware/efi/efivars ]] \
        || die "Not a UEFI system (no /sys/firmware/efi). Secure Boot requires UEFI; nothing to do."
}

esp_path() {
    local p
    p="$(bootctl -p 2>/dev/null)" && [[ -n "$p" ]] && { printf '%s' "$p"; return 0; }
    printf '/boot'
}

# Last data byte of an EFI variable (4-byte attribute prefix precedes the value).
_efivar_byte() {
    local name="$1"
    local f="/sys/firmware/efi/efivars/${name}-${EFI_GUID}"
    [[ -r "$f" ]] || return 2
    od -An -t u1 "$f" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' | tail -1
}

# Secure Boot active right now? bootctl → mokutil → raw efivar (mokutil is often
# absent, so the efivar read is the dependable fallback).
sb_enabled() {
    if command -v bootctl &>/dev/null && bootctl status 2>/dev/null | grep -qiE 'Secure Boot:\s*enabled'; then
        return 0
    fi
    if command -v mokutil &>/dev/null && mokutil --sb-state 2>/dev/null | grep -qi 'enabled'; then
        return 0
    fi
    [[ "$(_efivar_byte SecureBoot 2>/dev/null)" == "1" ]]
}

# Firmware in Setup Mode (Platform Key cleared) — required for key enrollment.
setup_mode() {
    if command -v sbctl &>/dev/null && sbctl status 2>/dev/null | grep -qiE 'Setup Mode:\s*Enabled'; then
        return 0
    fi
    [[ "$(_efivar_byte SetupMode 2>/dev/null)" == "1" ]]
}

have_sbctl() { command -v sbctl &>/dev/null; }
have_tpm()   { [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]]; }

# UKI already in use? (preset emits a UKI and at least one is present on the ESP)
is_uki() {
    local esp; esp="$(esp_path)"
    [[ -f "$MKINITCPIO_PRESET" ]] && grep -q '_uki=' "$MKINITCPIO_PRESET" \
        && compgen -G "$esp/EFI/Linux/*.efi" >/dev/null 2>&1
}

# Best-effort: discrete GPU present? Its option ROM is usually Microsoft-signed,
# so own-keys-only enrollment risks no display — bias to keeping MS keys.
detect_dgpu() {
    command -v lspci &>/dev/null || return 1
    lspci -nn 2>/dev/null | grep -iE 'VGA|3D|Display' \
        | grep -iqE 'NVIDIA|Advanced Micro Devices|AMD/ATI'
}

# Firmware admin/supervisor password — 0=set, 1=not set, 2=unknown.
# The OS cannot read this on most firmware; the kernel firmware-attributes class
# exposes it on some Dell/Lenovo/HP, otherwise we fall back to an explicit ack.
firmware_password_state() {
    local f
    for f in /sys/class/firmware-attributes/*/authentication/*[Aa]dmin*/is_enabled \
             /sys/class/firmware-attributes/*/authentication/*[Ss]ystem*/is_enabled; do
        [[ -r "$f" ]] || continue
        case "$(cat "$f" 2>/dev/null)" in
            1) return 0 ;;
            0) [[ -f "$FWPW_ACK" ]] && return 0 || return 1 ;;
        esac
    done
    [[ -f "$FWPW_ACK" ]] && return 0
    return 2
}

# ════════════════════════════════════════════════════════════════════════════
#  Package + key-policy setup
# ════════════════════════════════════════════════════════════════════════════

ensure_sbctl() {
    have_sbctl && { ok "sbctl present"; return 0; }
    step "Installing sbctl"
    pacman -S --noconfirm --needed sbctl >>"$LOG" 2>&1 \
        || die "Failed to install sbctl (pacman). Install it and re-run."
    ok "sbctl installed"
}

decide_key_policy() {
    (( USE_MS_KEYS != -1 )) && return 0
    step "Secure Boot key policy"
    info "Own keys only is strongest (no Microsoft-signed binaries trusted) but can"
    info "leave a discrete GPU or option-ROM-dependent firmware unable to initialise."
    info "Keeping Microsoft keys (--microsoft) is broadly compatible."
    if detect_dgpu; then
        warn "Discrete GPU detected — its option ROM is typically Microsoft-signed."
        info "Defaulting to KEEP Microsoft keys for safety."
        local choice
        ask_pick choice "Key policy:" \
            "Keep Microsoft keys (recommended for this hardware)" \
            "Own keys only (test the fallback boot first — may blank the GPU)"
        [[ "$choice" == Own* ]] && USE_MS_KEYS=0 || USE_MS_KEYS=1
    else
        info "No discrete GPU detected — own-keys-only is usually safe here."
        local choice
        ask_pick choice "Key policy:" \
            "Own keys only (strongest; recommended)" \
            "Keep Microsoft keys (maximum compatibility)"
        [[ "$choice" == Own* ]] && USE_MS_KEYS=0 || USE_MS_KEYS=1
    fi
    if (( USE_MS_KEYS == 1 )); then ok "Policy: keep Microsoft keys"; else ok "Policy: own keys only"; fi
}

# ════════════════════════════════════════════════════════════════════════════
#  Unified Kernel Image conversion
# ════════════════════════════════════════════════════════════════════════════

convert_to_uki() {
    local esp; esp="$(esp_path)"
    step "Unified Kernel Image"

    if is_uki; then
        ok "UKI already configured ($esp/EFI/Linux)."
        return 0
    fi
    [[ -f "$MKINITCPIO_PRESET" ]] \
        || die "No $MKINITCPIO_PRESET — non-standard kernel; set up a signed UKI manually (see security-hardening.md)."

    backup "$MKINITCPIO_PRESET"
    [[ -f "$KERNEL_CMDLINE" ]] && backup "$KERNEL_CMDLINE"
    mkdir -p "$(dirname "$KERNEL_CMDLINE")" "$esp/EFI/Linux"

    # Single source of truth for the cmdline (baked + signed into the UKI). Prefer
    # the existing systemd-boot entry's options line; fall back to /proc/cmdline
    # with bootloader-injected tokens stripped.
    local cmdline="" entry="" e
    for e in "$esp"/loader/entries/*.conf; do
        [[ -f "$e" ]] || continue
        [[ "$e" == *fallback* ]] && continue
        entry="$e"; break
    done
    [[ -n "$entry" ]] && cmdline="$(sed -n 's/^options[[:space:]]\+//p' "$entry" | head -1)"
    if [[ -z "$cmdline" ]]; then
        cmdline="$(tr ' ' '\n' < /proc/cmdline | grep -vE '^(BOOT_IMAGE|initrd)=' | tr '\n' ' ')"
        cmdline="$(printf '%s' "$cmdline" | sed 's/[[:space:]]\+$//')"
    fi
    [[ -n "$cmdline" ]] || die "Could not determine kernel cmdline — refusing to build an unbootable UKI."
    printf '%s\n' "$cmdline" > "$KERNEL_CMDLINE"
    ok "Kernel cmdline → $KERNEL_CMDLINE"

    # Emit signed-ready UKIs (default + fallback); drop the separate initramfs
    # images. Microcode is folded in by the `microcode` mkinitcpio hook.
    sed -i -e 's|^default_image=|#default_image=|' \
           -e 's|^fallback_image=|#fallback_image=|' "$MKINITCPIO_PRESET"
    grep -q '^default_uki=' "$MKINITCPIO_PRESET" \
        || printf 'default_uki="%s/EFI/Linux/arch-linux.efi"\n' "$esp" >> "$MKINITCPIO_PRESET"
    grep -q '^fallback_uki=' "$MKINITCPIO_PRESET" \
        || printf 'fallback_uki="%s/EFI/Linux/arch-linux-fallback.efi"\n' "$esp" >> "$MKINITCPIO_PRESET"
    ok "mkinitcpio preset now builds UKIs (default + fallback)"

    mkinitcpio -P >>"$LOG" 2>&1 || die "mkinitcpio -P failed building the UKI — see $LOG"
    [[ -f "$esp/EFI/Linux/arch-linux.efi" ]] \
        || die "UKI was not produced at $esp/EFI/Linux/arch-linux.efi — see $LOG"
    ok "UKIs built (default + fallback)"

    # systemd-boot auto-discovers EFI/Linux/*.efi — retire the now-stale entries
    # that pointed at the removed initramfs images.
    local le
    for le in "$esp"/loader/entries/arch.conf "$esp"/loader/entries/arch-fallback.conf; do
        [[ -f "$le" ]] && { backup "$le"; rm -f "$le"; ok "Removed stale loader entry: $(basename "$le")"; }
    done
    # Point the default at the UKI and keep the cmdline non-editable at the menu
    # (an editable cmdline under Secure Boot is an init=/bin/sh bypass).
    local lc="$esp/loader/loader.conf"
    if [[ -f "$lc" ]]; then
        backup "$lc"
        grep -q '^default ' "$lc" && sed -i 's|^default .*|default arch-linux.efi|' "$lc" \
            || printf 'default arch-linux.efi\n' >> "$lc"
        grep -q '^editor ' "$lc" && sed -i 's|^editor .*|editor no|' "$lc" \
            || printf 'editor no\n' >> "$lc"
    fi
    ok "systemd-boot points at the UKI (editor disabled)"
}

# ════════════════════════════════════════════════════════════════════════════
#  Keys · signing · verification
# ════════════════════════════════════════════════════════════════════════════

create_keys() {
    step "Secure Boot signing keys"
    if [[ -d /var/lib/sbctl/keys || -d /usr/share/secureboot/keys || -d /etc/sbctl/keys ]]; then
        ok "sbctl keys already present."
        return 0
    fi
    # sbctl create-keys is itself idempotent (skips existing keys); the dir check
    # above just avoids noise on re-runs.
    sbctl create-keys >>"$LOG" 2>&1 || die "sbctl create-keys failed — see $LOG"
    ok "Created sbctl key hierarchy (db/KEK/PK)"
}

# Sign and TRACK (-s) every boot binary so sbctl's own pacman hook re-signs them
# on future linux/systemd/sbctl upgrades — this is what keeps it signed over time.
sign_all() {
    step "Signing boot chain"
    local esp; esp="$(esp_path)"
    local -a targets=() f
    for f in "$esp"/EFI/Linux/*.efi \
             "$esp"/EFI/systemd/systemd-bootx64.efi \
             "$esp"/EFI/BOOT/BOOTX64.EFI; do
        [[ -f "$f" ]] && targets+=("$f")
    done
    (( ${#targets[@]} )) || die "No EFI binaries found to sign under $esp — convert to UKI first."
    for f in "${targets[@]}"; do
        if sbctl sign -s "$f" >>"$LOG" 2>&1; then ok "Signed + tracked: $f"; else warn "Could not sign $f — see $LOG"; fi
    done
    # Catch anything already in sbctl's database that we did not list explicitly.
    sbctl sign-all >>"$LOG" 2>&1 || true
}

verify_quiet() { sbctl verify >/dev/null 2>&1; }

verify_report() {
    step "Verifying signatures (sbctl verify)"
    if sbctl verify 2>&1 | tee -a "$LOG"; then
        ok "All tracked binaries are signed with your keys."
        return 0
    fi
    warn "sbctl verify reported unsigned/mismatched binaries (above)."
    return 1
}

enroll_keys() {
    step "Enrolling keys into firmware"
    if ! setup_mode; then
        warn "Firmware is NOT in Setup Mode — keys cannot be enrolled yet."
        info "Reboot into your UEFI firmware menu and either:"
        info "  • choose 'Erase all Secure Boot keys' / 'Clear PK', or"
        info "  • set Secure Boot mode to 'Setup' / 'Custom' and clear the keys,"
        info "then boot back into Linux and run:  hyprconf secureboot enroll"
        return 1
    fi
    # Never enroll over an unsigned boot chain — that bricks the next SB-on boot.
    verify_quiet || die "Refusing to enroll: 'sbctl verify' is not clean. Run 'hyprconf secureboot sign' first."

    decide_key_policy
    local -a args=(enroll-keys)
    if (( USE_MS_KEYS == 1 )); then
        if sbctl enroll-keys --help 2>&1 | grep -q -- '--microsoft'; then
            args+=(--microsoft)
        else
            args+=(-m)
        fi
        info "Keeping Microsoft keys (--microsoft)."
    else
        # Own keys only: modern sbctl ABORTS with an "Option ROM" error unless the
        # brick risk is explicitly accepted — firmware that loads Microsoft-signed
        # option ROMs (e.g. a dGPU) may fail to initialise without the MS keys.
        # decide_key_policy already warned and offered --microsoft, so honour the
        # choice by passing the override (feature-detected; older sbctl lacks it and
        # also does not need it).
        if sbctl enroll-keys --help 2>&1 | grep -q -- '--yes-this-might-brick-my-machine'; then
            args+=(--yes-this-might-brick-my-machine)
        elif sbctl enroll-keys --help 2>&1 | grep -q -- '--yolo'; then
            args+=(--yolo)
        fi
        info "Enrolling own keys only (no Microsoft keys)."
        warn "If the display goes black after enabling Secure Boot, re-enter Setup"
        warn "Mode and re-run with: hyprconf secureboot enroll --microsoft"
    fi
    sbctl "${args[@]}" >>"$LOG" 2>&1 || die "sbctl enroll-keys failed — see $LOG"
    ok "Keys enrolled. Now enable Secure Boot in firmware (see final instructions)."
}

# ════════════════════════════════════════════════════════════════════════════
#  Persistence: a verify-only pacman safety hook
# ════════════════════════════════════════════════════════════════════════════

install_verify_hook() {
    step "Pacman verify hook"
    mkdir -p "$(dirname "$VERIFY_HOOK")"
    # sbctl ships its own hook that re-signs tracked files on these upgrades; this
    # one runs last and shouts (non-fatally) if anything ended up unsigned.
    cat > "$VERIFY_HOOK" <<'HOOK'
# Installed by hyprconf-secureboot. Verifies the Secure Boot chain after upgrades
# that touch the kernel, bootloader, or sbctl itself. Non-fatal: it only warns.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/systemd/boot/efi/*
Target = usr/bin/sbctl
Target = boot/EFI/Linux/*.efi

[Action]
Description = Verifying Secure Boot signatures (hyprconf)...
When = PostTransaction
Exec = /bin/sh -c 'command -v sbctl >/dev/null 2>&1 && { sbctl sign-all >/dev/null 2>&1 || true; sbctl verify || echo "  !! hyprconf: Secure Boot chain has UNSIGNED binaries — run: sudo hyprconf secureboot sign"; } || true'
NeedsTargets
HOOK
    chmod 644 "$VERIFY_HOOK"
    ok "Installed $VERIFY_HOOK"
}

# ════════════════════════════════════════════════════════════════════════════
#  Optional TPM2 PCR binding (FIDO2 stays the default factor)
# ════════════════════════════════════════════════════════════════════════════

_first_luks2_device() {
    local name fstype dev
    while read -r name fstype; do
        [[ "$fstype" == "crypto_LUKS" ]] || continue
        dev="/dev/$name"
        cryptsetup luksDump "$dev" 2>/dev/null | grep -qE '^Version:\s*2' && { printf '%s' "$dev"; return 0; }
    done < <(lsblk -rno NAME,FSTYPE 2>/dev/null)
    return 1
}

tpm_bind() {
    step "Optional: bind LUKS unlock to the TPM (measured boot)"
    have_tpm || { warn "No TPM2 device (/dev/tpmrm0) — skipping."; return 0; }
    command -v systemd-cryptenroll &>/dev/null || { warn "systemd-cryptenroll missing — skipping."; return 0; }

    local dev; dev="$(_first_luks2_device)" || { warn "No LUKS2 device found — skipping."; return 0; }
    info "TPM binding gates decryption on an unmodified boot chain. With a UKI the"
    info "robust measurement is PCR 11; PCR 7 tracks Secure Boot state."
    warn "Plain --tpm2-pcrs=7+11 must be RE-ENROLLED after every kernel update (PCR 11"
    warn "changes). PCR 7 alone is stable but coarser. A PIN blocks auto-unlock on theft."
    warn "FIDO2 + passphrase/recovery slots are kept as fallback."

    local pcrs
    ask_pick pcrs "PCR policy for $dev:" \
        "7 + PIN  (stable across kernel updates; recommended)" \
        "7+11 + PIN  (strongest; re-enroll each kernel update)" \
        "Skip"
    [[ "$pcrs" == Skip ]] && { info "Skipped TPM binding."; return 0; }

    local pcr_arg="7"; [[ "$pcrs" == 7+11* ]] && pcr_arg="7+11"
    if systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="$pcr_arg" --tpm2-with-pin=yes "$dev"; then
        ok "TPM2 enrolled (PCRs $pcr_arg, PIN required) on $dev"
    else
        warn "TPM enrollment failed — FIDO2/passphrase slots are unaffected."
    fi
}

# ════════════════════════════════════════════════════════════════════════════
#  Firmware-password gating (best-effort) + key-only LUKS delegation
# ════════════════════════════════════════════════════════════════════════════

firmware_password_check() {
    step "Firmware admin password (mandatory layer)"
    case "$(firmware_password_state; echo $?)" in
        0) ok "Firmware admin password reported SET." ;;
        1) warn "Firmware admin password reported NOT set — Secure Boot can be disabled"
           warn "by anyone with physical access. Set one in your UEFI menu, and also"
           warn "lock the one-time boot menu / disable USB boot." ;;
        *) warn "Cannot verify a firmware admin password from the OS (normal on most"
           warn "firmware). It is REQUIRED: without it Secure Boot is trivially bypassed."
           info "Set an Administrator/Supervisor password in your UEFI menu, lock the"
           info "boot-device menu, then run: hyprconf secureboot ack-firmware-password" ;;
    esac
}

ack_firmware_password() {
    step "Acknowledge firmware admin password"
    warn "Only confirm this once you have ACTUALLY set a UEFI Administrator/Supervisor"
    warn "password AND locked the one-time boot menu / disabled removable boot."
    ask_yn "Have you set a firmware admin password and locked the boot menu?" n \
        || { info "Not acknowledged — doctor/status will keep reminding you."; return 0; }
    mkdir -p "$STATE_DIR"
    printf 'acknowledged %s\n' "$(date -Is)" > "$FWPW_ACK"
    ok "Recorded. (This is an attestation — the OS cannot verify the firmware.)"
}

# Resolve the sibling yubikey-fido2-setup (same stowed bin dir) for delegation.
_yubikey_script() {
    local self; self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
    printf '%s/yubikey-fido2-setup' "$(dirname "$self")"
}

do_harden() {
    step "Key-only LUKS (remove the login-reused passphrase slot)"
    info "The installer sets the LUKS passphrase equal to your login password and"
    info "keeps it as a slot. An attacker can ignore the YubiKey and brute-force that"
    info "weaker slot offline. Key-only LUKS removes it (a recovery key is enrolled"
    info "first). This is delegated to yubikey-fido2-setup, which has the guardrails."
    local yk; yk="$(_yubikey_script)"
    if [[ -x "$yk" ]]; then
        exec "$yk" harden-luks
    fi
    die "Could not locate yubikey-fido2-setup. Run: sudo hyprconf yubikey harden-luks"
}

# ════════════════════════════════════════════════════════════════════════════
#  Actions
# ════════════════════════════════════════════════════════════════════════════

do_setup() {
    require_uefi
    step "Secure Boot setup (signed UKI)"
    info "This will: install sbctl, convert to a signed UKI, create + sign keys,"
    info "verify, install a pacman verify hook, and enroll keys if firmware is in"
    info "Setup Mode. Enabling Secure Boot itself is a manual firmware-menu step."

    ensure_sbctl
    create_keys
    convert_to_uki
    sign_all
    if ! verify_report; then
        die "Signatures are not clean — NOT enrolling keys (that would brick the next boot). Fix the above, then re-run."
    fi
    install_verify_hook

    if setup_mode; then
        if ask_yn "Firmware is in Setup Mode — enroll your keys now?" y; then
            enroll_keys
        else
            info "Skipped enrollment. Run 'hyprconf secureboot enroll' later in Setup Mode."
        fi
    else
        warn "Firmware is not in Setup Mode — keys signed but not enrolled."
        info "Enter Setup Mode in firmware, then run: hyprconf secureboot enroll"
    fi

    firmware_password_check
    summary
}

summary() {
    local esp; esp="$(esp_path)"
    log ""
    log "${W}${G}┌──────────────────────────────────────────────────────────────┐${N}"
    log "${W}${G}│  Secure Boot — next steps                                      │${N}"
    log "${W}${G}└──────────────────────────────────────────────────────────────┘${N}"
    log "  ${W}1.${N} Reboot into your UEFI firmware menu (Del / F2 / F10 at power-on)."
    log "  ${W}2.${N} Set an ${W}Administrator/Supervisor password${N} and lock the boot menu."
    log "  ${W}3.${N} Set Secure Boot to ${W}Enabled${N} (keys are already enrolled if Setup Mode"
    log "     was active above; otherwise enter Setup Mode and run 'secureboot enroll')."
    log "  ${W}4.${N} Save & exit. Back in Linux, confirm:"
    log "       ${C}hyprconf secureboot status${N}   → Secure Boot: enabled, sbctl: verified"
    log ""
    log "  ${W}Recommended decrypt factor:${N} ${C}hyprconf yubikey setup${N} (FIDO2 + PIN),"
    log "  then ${C}hyprconf secureboot harden${N} to drop the weak passphrase slot."
    log "  ${W}Optional:${N} ${C}hyprconf secureboot tpm-bind${N} for measured-boot gating."
    log ""
    log "  Signed UKIs: ${esp}/EFI/Linux/   ·   Keys: /var/lib/sbctl"
    log "  Full log: $LOG"
}

do_enroll() {
    require_uefi
    ensure_sbctl
    if ! verify_quiet; then
        warn "Boot chain not fully signed — signing first."
        sign_all
        verify_report || die "Still unsigned after signing — fix before enrolling."
    fi
    # Propagate enrollment status: when it's refused (e.g. not in Setup Mode),
    # enroll_keys prints guidance and returns non-zero — don't mask that as success.
    enroll_keys || return 1
    firmware_password_check
}

do_sign() {
    require_uefi
    ensure_sbctl
    sign_all
    verify_report
}

do_verify() {
    require_uefi
    trap - ERR
    have_sbctl || die "sbctl is not installed — run 'hyprconf secureboot setup' first."
    sbctl verify
}

do_tpm_bind() { require_uefi; tpm_bind; }

# ── Read-only status report ─────────────────────────────────────────────────
do_status() {
    trap - ERR
    printf '%b\n' "\n${W}${B}Secure Boot status${N}"

    if [[ ! -d /sys/firmware/efi/efivars ]]; then
        warn "Not a UEFI system — Secure Boot is not applicable."
        return 0
    fi

    if sb_enabled; then ok "Secure Boot: ${G}enabled${N}"; else warn "Secure Boot: ${Y}disabled${N}"; fi
    if setup_mode; then warn "Setup Mode: enabled (keys can be enrolled)"; else info "Setup Mode: disabled (User Mode)"; fi

    if is_uki; then ok "Boot type: signed-ready UKI ($(esp_path)/EFI/Linux)"; else warn "Boot type: separate kernel+initramfs (run 'secureboot setup' to convert to a signed UKI)"; fi

    if have_sbctl; then
        if [[ $EUID -eq 0 ]]; then
            if sbctl verify >/dev/null 2>&1; then ok "sbctl verify: clean"; else fail "sbctl verify: UNSIGNED binaries present — run 'hyprconf secureboot sign'"; fi
        else
            info "sbctl present (run as root / 'hyprconf secureboot status' for verify detail)"
        fi
    else
        warn "sbctl not installed — run 'hyprconf secureboot setup'"
    fi

    case "$(firmware_password_state; echo $?)" in
        0) ok "Firmware admin password: set/acknowledged" ;;
        1) fail "Firmware admin password: NOT set — Secure Boot is bypassable" ;;
        *) warn "Firmware admin password: unknown (set one; then 'secureboot ack-firmware-password')" ;;
    esac

    # Unlock factors + the YubiKey-bypass-via-passphrase warning.
    if [[ $EUID -eq 0 ]] && command -v systemd-cryptenroll &>/dev/null; then
        local dev; dev="$(_first_luks2_device || true)"
        if [[ -n "$dev" ]]; then
            local n_fido n_tpm n_pass
            n_fido=$(systemd-cryptenroll "$dev" 2>/dev/null | grep -ci 'fido2')
            n_tpm=$(systemd-cryptenroll "$dev" 2>/dev/null | grep -ci 'tpm2')
            n_pass=$(systemd-cryptenroll "$dev" 2>/dev/null | awk 'tolower($2)=="password"{c++} END{print c+0}')
            info "LUKS $dev — FIDO2:$n_fido  TPM2:$n_tpm  passphrase:$n_pass"
            if (( n_fido > 0 && n_pass > 0 )); then
                fail "YubiKey is bypassable: a passphrase slot coexists. Run 'hyprconf secureboot harden' (key-only LUKS)."
            fi
        fi
    fi
    printf '\n'
}

# ── Usage ──────────────────────────────────────────────────────────────────────
usage_sb() {
    cat >&2 <<'EOF'

  Secure Boot (signed UKI) — Arch Linux

  Usage: hyprconf-secureboot [status|setup|enroll|sign|verify|tpm-bind|harden|ack-firmware-password]
         hyprconf secureboot  [status|setup|enroll|sign|verify|tpm-bind|harden]

    status      Read-only report: SB state, Setup Mode, UKI, sbctl verify, factors
    setup       Full setup: sbctl, signed UKI, keys, sign, verify, hook, enroll
    enroll      Enroll keys into firmware (requires Setup Mode)
    sign        (Re)sign + verify the boot chain
    verify      Run 'sbctl verify'
    tpm-bind    Optional: bind LUKS unlock to TPM2 PCRs (FIDO2 stays default)
    harden      Key-only LUKS — remove the login-reused passphrase slot (delegated
                to yubikey-fido2-setup; enrolls a recovery key first)
    ack-firmware-password   Record that a UEFI admin password has been set
    help        Show this help

  Key policy flags (setup/enroll): --microsoft keeps Microsoft keys (compatible);
  --own-keys-only enrolls only your keys (strongest). Default: auto-detected.

  All actions except status/verify modify system files and require root (sudo).
EOF
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    mkdir -p "$BACKUP_DIR"
    LOG="$(mktemp -t hyprconf-secureboot-XXXXXX.log 2>/dev/null || printf '%s' "/tmp/hyprconf-secureboot.$$.log")"

    # ERR trap offers rollback on unexpected failure (disabled in read-only actions).
    trap 'err "Unexpected error (line $LINENO)."; if ask_yn "Roll back file changes?" y; then rollback; fi; exit 1' ERR

    local action="${1:-status}"
    shift || true

    # Parse key-policy flags in any position.
    local a
    for a in "$@"; do
        case "$a" in
            --microsoft|-m) USE_MS_KEYS=1 ;;
            --own-keys-only|--own) USE_MS_KEYS=0 ;;
        esac
    done

    case "$action" in
        status|list|info|"")          do_status ;;
        setup)                        do_setup ;;
        enroll|enroll-keys)           do_enroll ;;
        sign|sign-all)                do_sign ;;
        verify)                       do_verify ;;
        tpm-bind|tpm)                 do_tpm_bind ;;
        harden|harden-luks|key-only)  do_harden ;;
        ack-firmware-password|ack-fwpw) ack_firmware_password ;;
        help|-h|--help)               usage_sb ;;
        *) err "Unknown action: $action"; usage_sb; exit 1 ;;
    esac
}

main "$@"

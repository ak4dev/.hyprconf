#!/usr/bin/env bash
set -euo pipefail

# hc — pure-forwarding shortcut aliases for hyprconf's standalone tools.
# Each arm just execs the real tool with the remaining args untouched; hc
# never parses, validates, or interprets them, and never grows its own
# per-subcommand help. See AGENTS.md — a fancier version of this (its own
# arg handling, ~2,300 lines) was already built and removed for going
# unused (commit fbbd13f). Adding a new standalone tool gets one forwarding
# line here; anything more belongs in the tool itself.

readonly SCRIPTS_DIR="$HOME/.config/hypr/scripts"

case "${1:-}" in
    vm)         shift; exec "$SCRIPTS_DIR/gpu-passthrough.sh" vm "$@" ;;
    gpu)        shift; exec "$SCRIPTS_DIR/gpu-passthrough.sh" "$@" ;;
    secureboot) shift; exec hyprconf-secureboot "$@" ;;
    vpn)        shift; exec hyprconf-vpn "$@" ;;
    yubikey)    shift; exec yubikey-fido2-setup "$@" ;;
    theme)      shift; exec "$SCRIPTS_DIR/theme-switcher/switch_theme.py" "$@" ;;
    sync)       shift; exec "$HOME/.hyprconf/setup.sh" --sync "$@" ;;
    *)
        cat >&2 <<'EOF'
Usage: hc <tool> [args...]

  hc vm ...          gpu-passthrough.sh vm ...   (Windows/Arch VM)
  hc gpu ...         gpu-passthrough.sh ...       (GPU passthrough)
  hc secureboot ...  hyprconf-secureboot ...
  hc vpn ...         hyprconf-vpn ...
  hc yubikey ...     yubikey-fido2-setup ...
  hc theme ...       switch_theme.py ...
  hc sync            setup.sh --sync

Pure forwarding — run the tool's own help/status for its real command surface.
EOF
        exit 1
        ;;
esac

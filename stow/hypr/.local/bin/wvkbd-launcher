#!/usr/bin/env bash
# wvkbd-launcher — start wvkbd with theme-aware colors.
# Reads ~/.config/wvkbd/colors for bg/fg/accent hex values written by the
# theme-switcher, then starts wvkbd-mobintl in hidden mode (auto-shows when
# a text input is focused via the text-input-v3 / input-method-v2 protocols).
set -euo pipefail

if ! command -v wvkbd-mobintl &>/dev/null; then
    echo "wvkbd-launcher: wvkbd-mobintl not found — install with: yay -S wvkbd" >&2
    exit 1
fi

COLORS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/wvkbd/colors"
_hex_re='^#[0-9A-Fa-f]{6}$'

bg=""
fg=""
accent=""

if [[ -f "$COLORS_FILE" ]]; then
    while IFS='=' read -r key val; do
        # Strip surrounding quotes and whitespace from the value.
        val="${val#\"}" ; val="${val%\"}"
        val="${val#\'}" ; val="${val%\'}"
        case "$key" in
            bg)     [[ "$val" =~ $_hex_re ]] && bg="$val" ;;
            fg)     [[ "$val" =~ $_hex_re ]] && fg="$val" ;;
            accent) [[ "$val" =~ $_hex_re ]] && accent="$val" ;;
        esac
    done < "$COLORS_FILE"
fi

# Kill any existing instances so this is safe to call on theme change.
while IFS= read -r _p; do
    kill "$_p" 2>/dev/null || true
done < <(pgrep -x wvkbd-mobintl 2>/dev/null || true)
# Wait up to 1 s for all instances to exit before proceeding.
local_timeout=10
while (( local_timeout-- > 0 )) && pgrep -x wvkbd-mobintl >/dev/null 2>&1; do
    sleep 0.1
done

# Build argument list. Color flags are passed only when wvkbd supports them
# (detected via --help) and values are available.
args=(--hidden)

if [[ -n "$bg" && -n "$fg" ]] \
        && wvkbd-mobintl --help 2>&1 | grep -q -- "--bg"; then
    args+=(--bg "$bg" --fg "$fg")
    [[ -n "$accent" ]] && args+=(--press "$accent")
fi

exec wvkbd-mobintl "${args[@]}"

#!/usr/bin/env bash
set -euo pipefail

# adjust-gaps + | -
# Increase or decrease Hyprland window gaps (inner and outer) by a fixed step.
# Both general:gaps_in and general:gaps_out move together so their difference
# is preserved (proportionate adjustment).
#
# Usage: adjust-gaps +    # increase by STEP
#        adjust-gaps -    # decrease by STEP (floors at 0)

readonly STEP=2

direction="${1:-+}"

_get_int() {
    hyprctl getoption "$1" | awk '/int:/{print $2; exit}' || echo "0"
}

gaps_in=$(  _get_int general:gaps_in  )
gaps_out=$( _get_int general:gaps_out )

if [[ "$direction" == "+" ]]; then
    new_in=$(( gaps_in  + STEP ))
    new_out=$(( gaps_out + STEP ))
else
    new_in=$(( gaps_in  - STEP ))
    new_out=$(( gaps_out - STEP ))
    new_in=$(( new_in  < 0 ? 0 : new_in  ))
    new_out=$(( new_out < 0 ? 0 : new_out ))
fi

hyprctl keyword general:gaps_in  "$new_in"
hyprctl keyword general:gaps_out "$new_out"

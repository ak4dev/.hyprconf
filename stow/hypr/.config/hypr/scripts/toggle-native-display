#!/usr/bin/env bash
set -euo pipefail

# ── Palette (degraded gracefully when not a tty) ──────────────────────────────
if [[ -t 1 ]]; then
    AM=$'\033[38;2;255;184;108m'   # amber
    GR=$'\033[38;2;80;250;123m'    # green
    WH=$'\033[38;2;248;248;242m'   # white
    RS=$'\033[0m'                  # reset
else
    AM=''; GR=''; WH=''; RS=''
fi

log_step() { printf '%s  ▸ %s%s%s\n' "$AM" "$WH" "$1" "$RS"; }
log_ok()   { printf '%s  ✔ %s%s%s\n' "$GR" "$WH" "$1" "$RS"; }

# Auto-detect the built-in laptop panel. Most laptops report eDP-1 / eDP-2;
# desktops do not have one. Allow $PANEL=<name> override for special cases.
detect_panel() {
    if [[ -n "${PANEL:-}" ]]; then
        printf '%s\n' "$PANEL"
        return
    fi
    hyprctl monitors | awk '/^Monitor / && $2 ~ /^eDP-/ {print $2; exit}'
}

PANEL="$(detect_panel)"
if [[ -z "$PANEL" ]]; then
    printf 'No internal panel (eDP-*) detected. Set PANEL=<name> to override.\n' >&2
    exit 1
fi
readonly PANEL

DISABLED=$(hyprctl monitors | awk -v m="$PANEL" '
  $0 ~ "Monitor " m {flag=1}
  flag && $1=="disabled:" {print $2; exit}
')

if [[ "$DISABLED" == "false" ]]; then
    log_step "Disabling $PANEL..."
    hyprctl keyword monitor "$PANEL,disable"
    log_ok "$PANEL disabled."
else
    log_step "Enabling $PANEL..."
    hyprctl keyword monitor "$PANEL,preferred,auto,1"
    log_ok "$PANEL enabled."
fi

#!/usr/bin/env bash
# hyprconf-monitor-preset — switch the desk's monitor layout.
# Goes through Omarchy's Hyprland toggles seam.
#
#   hyprconf-monitor-preset <bedroom|kitchen|K|pc|laptop>   apply that preset
#   hyprconf-monitor-preset stock                            Omarchy's own layout again
#
# A preset is one of the ~/.config/hypr/{pcMonitors.<name>,pcMonitors,
# laptopMonitors}.lua files install.sh seeds — hl.monitor lines plus the
# hl.workspace_rule lines for that layout; edits survive re-selecting it. The
# chosen one is COPIED (never linked) to
# ~/.local/state/omarchy/toggles/hypr/hyprconf-monitor-preset.lua, the
# directory Omarchy's default/hypr/toggles.lua require_all()s with reload=true
# — and config/hypr/hyprland.lua requires it (line 26) AFTER hypr.monitors
# (line 19), so a later hl.monitor for the same output wins over Omarchy's
# monitors.lua (Omarchy 4.0.0-1, Hyprland 0.56). That is exactly what Omarchy's
# own omarchy-hyprland-monitor-internal does: an hl.monitor line written to
# <toggle>.lua in that directory, then `hyprctl reload`; `stock` is
# omarchy-hyprland-toggle's off — rm -f the file, reload. ~/.config/hypr/
# monitors.lua is never touched, so Omarchy's own tooling keeps working on its
# own file (omarchy-hyprland-monitor-scaling seds it; omarchy refresh replaces
# it; neither can now land on a preset).
set -euo pipefail

# ── Palette (degraded gracefully when not a tty) ──────────────────────────────
if [[ -t 1 ]]; then
    AM=$'\033[38;2;255;184;108m'   # amber
    GR=$'\033[38;2;80;250;123m'    # green
    RD=$'\033[38;2;255;85;85m'     # red
    WH=$'\033[38;2;248;248;242m'   # white
    RS=$'\033[0m'                  # reset
else
    AM=''; GR=''; RD=''; WH=''; RS=''
fi

log_step() { printf '%s  ▸ %s%s%s\n' "$AM" "$WH" "$1" "$RS"; }
log_ok()   { printf '%s  ✔ %s%s%s\n' "$GR" "$WH" "$1" "$RS"; }
# The tool is reached from a hotkey, so stdout/stderr go nowhere a human can
# see. printf stays (it is the journal record when run by hand) and Omarchy's
# own channels are added: a notification for anything the user must act on, and
# the OSD for the one-line "which preset am I on now" confirmation.
log_die()  { printf '%s  ✘ %s%s\n'   "$RD" "$1" "$RS" >&2
             omarchy-notification-send -g 󰍹 -u critical "Monitor preset" "$1" >/dev/null 2>&1 || true
             exit 1; }
log_warn() { printf '%s  ! %s%s%s\n' "$AM" "$WH" "$1" "$RS" >&2
             omarchy-notification-send -g 󰍹 "Monitor preset" "$1" >/dev/null 2>&1 || true; }
osd()      { omarchy-osd -i display -m "$1" -d 2000 >/dev/null 2>&1 || true; }

readonly CONFIG_DIR="$HOME/.config/hypr"
readonly TOGGLE="$HOME/.local/state/omarchy/toggles/hypr/hyprconf-monitor-preset.lua"

if [[ -z "${1:-}" || "${1:-}" == -h || "${1:-}" == --help ]]; then
    printf '%s  Usage: %s <preset>%s\n'   "$AM" "$(basename "$0")" "$RS" >&2
    printf '%s  Presets: bedroom, kitchen, K, pc, laptop, stock%s\n' "$AM" "$RS" >&2
    printf '%s  Example: %s bedroom%s\n' "$AM" "$(basename "$0")" "$RS" >&2
    # Asking for help succeeds; arriving with no preset at all is an error.
    # Without this branch -h/--help pass the name whitelist and end at
    # log_die's critical desktop notification: "Preset not found".
    if [[ -n "${1:-}" ]]; then exit 0; fi
    exit 1
fi

# Whitelist preset names to prevent path traversal via $1.
if [[ ! "$1" =~ ^[A-Za-z0-9_-]+$ ]]; then
    log_die "Invalid preset name: '$1' (allowed: A-Z, a-z, 0-9, _, -)"
fi

# `stock` (or `omarchy`): no toggle file, so only Omarchy's own monitors.lua
# speaks — its auto layout, or whatever its tooling wrote there since.
if [[ "$1" == stock || "$1" == omarchy ]]; then
    log_step "Restoring Omarchy's own monitor layout"
    rm -f -- "$TOGGLE"
    hyprctl reload
    log_ok "Preset toggle removed — Omarchy's monitors.lua is the layout"
    osd "Monitor: stock"
    exit 0
fi

# Preset resolution, in order:
#   pcMonitors.<name>.lua  — the named presets (bedroom, kitchen, K)
#   <name>Monitors.lua     — the two whole-machine presets, `pc` and `laptop`
SOURCE="$CONFIG_DIR/pcMonitors.$1.lua"
[[ -f "$SOURCE" ]] || SOURCE="$CONFIG_DIR/${1}Monitors.lua"
[[ -f "$SOURCE" ]] || log_die "Preset not found: pcMonitors.$1.lua"

log_step "Switching monitor config to: $1"

# A copy, via a temp file + mv, so the toggle is never momentarily truncated
# under a reload — and never a link: the preset stays the user's file under
# ~/.config/hypr, and nothing Omarchy does to the toggles directory
# (omarchy-refresh-hyprland recreates it) can reach it.
mkdir -p "$(dirname "$TOGGLE")"
cp -- "$SOURCE" "$TOGGLE.tmp"
mv -f -- "$TOGGLE.tmp" "$TOGGLE"

hyprctl reload

# Workspace rules only place FUTURE workspaces: on a reload Hyprland leaves
# every existing workspace on whatever monitor it already occupies (only a
# disabled output's orphans get rehomed, and to an arbitrary survivor). So a
# bare reload enables the right outputs while workspaces 1-6 stay where the
# last layout had them. Walk the preset's own workspace rules and
# move each one explicitly. `hl.dsp.workspace.move` is the Lua-parser dispatch
# form (verified on Hyprland 0.56.2: `hyprctl dispatch 'hl.dsp.workspace.move({
# workspace = 7, monitor = "HDMI-A-2" })'` answers ok); a rule naming an output
# that is absent or disabled fails its dispatch and is deliberately ignored.
while IFS=$'\t' read -r ws mon; do
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = $ws, monitor = \"$mon\" })" \
        >/dev/null 2>&1 || true
done < <(sed -nE 's/^[[:space:]]*hl\.workspace_rule\(\{ *workspace *= *"([0-9]+)".*monitor *= *"([^"]+)".*/\1\t\2/p' "$SOURCE")

# An output flipping disabled→enabled through this same reload path can hit a
# failed-CRTC-restore bug (aquamarine/nvidia-open: ATOMIC modeset commit
# rejected with EINVAL) —
# Hyprland's config believes the panel is on, but the physical display never
# got a real modeset and stays dark until unplug/replug forces a fresh HPD
# probe. Verify against the kernel's own connector state and force a dpms
# off/on cycle while any output that should be lit isn't.
is_lit() {
    local name=$1 f found=0
    for f in /sys/class/drm/card*-"$name"/enabled; do
        [[ -e "$f" ]] || continue
        found=1
        [[ "$(<"$f")" == "enabled" ]] && return 0
    done
    ((found == 0))
}

all_lit() {
    local mons name
    mons=$(hyprctl monitors 2>/dev/null | awk '/^Monitor /{print $2}')
    [[ -n "$mons" ]] || return 1
    while IFS= read -r name; do
        is_lit "$name" || return 1
    done <<<"$mons"
}

# Only verify when hyprctl actually reports monitors — an empty/absent IPC
# (or a test double) means there's nothing meaningful to check.
if hyprctl monitors 2>/dev/null | grep -q "^Monitor " && ! all_lit; then
    log_step "Output(s) still dark after reload — re-issuing a dpms wake"
    for delay in 1 2 3; do
        # `hyprctl dispatch dpms on` is a Hyprland 0.55-ism: under the Lua
        # parser the two-token form is a syntax error (exit 7) and this
        # recovery never ran at all. This is the form Omarchy itself uses
        # (omarchy-hyprland-monitor-internal). The off half is dropped — a
        # wake is what re-drives the modeset, and blanking first risked
        # leaving a genuinely dead output dark.
        hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
        sleep "$delay"
        all_lit && break
    done
    all_lit || log_warn "Some outputs may still be dark — check hyprland.log"
fi

log_ok "Monitor preset '$1' active — Hyprland reloaded."
osd "Monitor: $1"

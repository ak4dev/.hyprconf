#!/usr/bin/env bash
set -euo pipefail

# hyprconf — launches the Textual TUI, the single configuration surface.
# install.sh copies this launcher to ~/.local/bin and symlinks the TUI
# (tui/) to ~/.config/hypr/scripts/hyprconf-tui and the library
# (lib/hyprconf/) to ~/.local/lib/hyprconf, which main.py imports from.

readonly TUI_SCRIPT="$HOME/.config/hypr/scripts/hyprconf-tui/main.py"

if [[ ! -f "$TUI_SCRIPT" ]]; then
  printf 'hyprconf: TUI not found at %s\nRe-run \`bash ~/.hyprconf/install.sh\` to reinstall it.\n' \
    "$TUI_SCRIPT" >&2
  exit 1
fi

if ! command -v python3 &>/dev/null; then
  printf 'hyprconf: python3 is required for the TUI\n' >&2
  exit 1
fi

if ! python3 -c "import textual" &>/dev/null; then
  printf 'hyprconf: python-textual is not installed.\nInstall with: sudo pacman -S python-textual\n' >&2
  exit 1
fi

exec python3 "$TUI_SCRIPT" "$@"

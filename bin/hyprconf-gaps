#!/usr/bin/env bash
# hyprconf-gaps — step Hyprland's window gaps up or down from a hotkey
# (SUPER+SHIFT+= / SUPER+SHIFT+- in hypr/bindings.lua, bound by name the way
# Omarchy binds its own commands; install.sh puts this on ~/.local/bin).
#
#   hyprconf-gaps +    increase general:gaps_in and gaps_out by STEP
#   hyprconf-gaps -    decrease both by STEP (floors at 0)
#
# Both move together so their difference is preserved (proportionate
# adjustment). Runtime only — a `hyprctl reload` puts the configured values
# back; Omarchy's own `omarchy hyprland window gaps toggle` is the all-or-
# nothing switch and is untouched.
set -euo pipefail

readonly STEP=2

direction="${1:-}"

if [[ "$direction" != "+" && "$direction" != "-" ]]; then
    printf 'Usage: %s <+|->\n' "$(basename "$0")" >&2
    exit 1
fi

_get_gap() {
    # gaps_in / gaps_out are a four-sided gap value, reported as "T R B L".
    # Hyprland 0.56 names that field "css"; older builds called it "custom".
    # Read both, or the step is computed from 0 every single press — the keys
    # still appear to work (0 -> 2 -> 0) while quietly discarding the real gap.
    # jq is how Omarchy itself reads `hyprctl getoption -j`
    # (/usr/share/omarchy/bin/omarchy-capture-screenshot:42), so it is always
    # installed. Non-JSON or empty output makes jq fail, and the gap reads as 0.
    hyprctl getoption "$1" -j 2>/dev/null \
        | jq -r '. as $d
            | ([$d.css, $d.custom] | map(select(type == "string" and . != "")) | first) as $sides
            | if $sides then ($sides | split(" ")[0] | tonumber) else ($d.int // 0) end' \
            2>/dev/null || echo "0"
}

gaps_in=$(  _get_gap general:gaps_in  )
gaps_out=$( _get_gap general:gaps_out )

if [[ "$direction" == "+" ]]; then
    new_in=$(( gaps_in  + STEP ))
    new_out=$(( gaps_out + STEP ))
else
    new_in=$(( gaps_in  - STEP ))
    new_out=$(( gaps_out - STEP ))
    new_in=$(( new_in  < 0 ? 0 : new_in  ))
    new_out=$(( new_out < 0 ? 0 : new_out ))
fi

# `hyprctl keyword` is dead on Hyprland 0.56+: with the Lua parser it answers
# "keyword can't work with non-legacy parsers. Use eval." AND STILL EXITS 0 —
# a silent no-op. `eval` runs the same Lua the config does and reports
# failure (exit 7).
if ! out="$(hyprctl eval "hl.config({ general = { gaps_in = $new_in, gaps_out = $new_out } })" 2>&1)" ||
   [[ "$out" != ok ]]; then
    printf 'hyprconf-gaps: %s\n' "$out" >&2
    exit 1
fi

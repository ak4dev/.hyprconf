#!/usr/bin/env bash
# hyprconf-yubikey — unlock the LUKS2 root at boot with a FIDO2 key (YubiKey).
#
# The one job Omarchy has no tool for: enrolling a FIDO2 token into the LUKS2
# root via systemd-cryptenroll and switching the initramfs so it can use it at
# boot. The other half — FIDO2 for sudo and polkit through pam_u2f —
# IS an Omarchy command (/usr/share/omarchy/bin/omarchy-setup-security-fido2,
# route `omarchy setup security fido2`), so `hyprconf-yubikey sudo` hands over
# to it. Checked on Omarchy 4.0.0-1: `omarchy commands --json` has no route
# that touches systemd-cryptenroll, mkinitcpio HOOKS or the kernel cmdline, and
# /usr/share/omarchy/bin has only omarchy-setup-security-fido2 (PAM) and
# omarchy-refresh-limine (resets /boot/limine.conf, edits no cmdline).
#
# Facts this tool is built on (verified on Omarchy 4.0.0-1, mkinitcpio 41.1,
# systemd 261, limine-mkinitcpio-hook 1.37.1):
#   * Omarchy's initramfs is the busybox chain: /etc/mkinitcpio.conf.d/
#     omarchy_hooks.conf sets HOOKS=(base udev plymouth keyboard autodetect
#     microcode modconf kms keymap consolefont block encrypt filesystems fsck
#     btrfs-overlayfs) and omarchy_resume.conf appends resume. The busybox
#     `encrypt` hook cannot do FIDO2. systemd's `sd-encrypt` hook (/usr/lib/
#     initcpio/install/sd-encrypt) bundles libcryptsetup-token-systemd-fido2.so
#     and libfido2 and reads rd.luks.name= / rd.luks.options= from the cmdline.
#   * mkinitcpio concatenates /etc/mkinitcpio.conf.d/*.conf onto the main
#     config in `sort -V` order and sources the result (/usr/bin/mkinitcpio,
#     "Source additional configuration files"). A drop-in whose name sorts last
#     therefore sees Omarchy's final HOOKS and may rewrite them without editing
#     any file Omarchy owns — that is the seam used here.
#   * omarchy_hooks.conf bundles /etc/vconsole.conf into the image only when
#     XKBLAYOUT's first layout types Latin letters (its closing `case`): the
#     Plymouth LUKS prompt would otherwise make a Latin passphrase untypeable.
#     sd-vconsole (/usr/lib/initcpio/install/sd-vconsole) bundles the file
#     unconditionally, so that guard is gone under systemd init — the tool
#     re-applies it in preflight, with the same layout list.
#   * The kernel cmdline: limine-entry-tool assembles KERNEL_CMDLINE[default]
#     from /usr/share/limine-entry-tool.d/*.conf, /etc/limine-entry-tool.conf,
#     /etc/limine-entry-tool.d/*.conf and /etc/default/limine — the order of
#     /usr/lib/limine/limine-common-functions load_config, the same four paths
#     the limine-entry-tool binary carries — `+=` appending parameters and `=`
#     replacing them (/etc/limine-entry-tool.conf, "Operators":
#     "/etc/default/limine overrides any drop-in configs"). Omarchy adds
#     parameters through drop-ins there: omarchy-hibernation-setup writes
#     resume.conf and rtc-alarm.conf as KERNEL_CMDLINE[default]+=" ..." through
#     `sudo tee`, and migration 1784917531.sh appends initramfs_async=0 to
#     omarchy-defaults.conf the same way. That is the seam: enroll writes
#     /etc/limine-entry-tool.d/zz-hyprconf-fido2.conf with the two rd.luks.*
#     parameters, disable removes it. /etc/default/limine — Omarchy's template
#     default/limine/default.conf, KERNEL_CMDLINE[default]+="cryptdevice=
#     PARTUUID=...:root root=/dev/mapper/root ..." — is only READ, for the
#     mapper name rd.luks.name= must yield (root= points at it). A plain
#     KERNEL_CMDLINE[default]= there replaces every drop-in's parameters,
#     Omarchy's included, so enroll refuses it. cryptdevice= is KEPT: each hook
#     ignores the other's parameters, so the box still boots through `encrypt`
#     if Omarchy ever rewrites its drop-in back to the busybox hooks.
#   * The rebuild is limine-mkinitcpio (limine-mkinitcpio-hook): it runs
#     /usr/share/libalpm/scripts/limine-mkinitcpio-install "rebuild", which
#     calls /usr/bin/mkinitcpio for every installed kernel (build_initramfs /
#     build_uki) into a tmp dir, installs the result with limine-entry-tool
#     --add-kernel / --add-uki only when the build succeeded, and refreshes
#     the Limine entries. A failed build is `error_msg "mkinitcpio failed for
#     kernel ..., skipping."` and `process_kernel ... || true` — so it exits 0
#     regardless, and the previous image stays on the ESP. It is the rebuild
#     Omarchy runs after its own drop-in changes: omarchy-hibernation-setup
#     (`sudo limine-mkinitcpio`, with the reason beside it — "The limine
#     bootloader binary on the ESP doesn't change here, so we don't need
#     limine-update (which would also re-deploy the binary and rebuild a
#     second time)"), omarchy-hibernation-remove and migrations 1784476564/
#     1784917531/1785944594/1786482992/1786605598. (omarchy-plymouth-set and
#     omarchy-upgrade-to-quattro run it too, for a plymouth theme and for
#     root= appended to /etc/default/limine — neither one a drop-in.) It is
#     not what every drop-in change runs, and that is the part to re-check on
#     an Omarchy bump: migration 1785273276.sh edits
#     /etc/mkinitcpio.conf.d/apple-t2.conf and rebuilds with `sudo
#     limine-update`, to redo what the failed hook skipped. That is what
#     limine-update — limine-install --no-efi-register, then limine-mkinitcpio
#     (/usr/bin/limine-update) — is for: repairing a failed hook, or
#     re-deploying the bootloader binary and /boot/limine.conf
#     (omarchy-refresh-limine; omarchy-provision-owner and
#     omarchy-system-factory-reset, each beside its reset_limine_config).
#     Neither is the case here, so it is not called; the externals scan in
#     test_yubikey.py pins that. A separate `mkinitcpio -P` would build
#     everything twice and, on Omarchy, hit the interactive
#     /usr/local/bin/mkinitcpio wrapper the same package installs
#     ("Would you like to run 'limine-mkinitcpio' now?").
#   * Where the image lands (limine-entry-tool README, --add-kernel/--add-uki):
#     ENABLE_UKI=yes on UEFI — Omarchy's /etc/limine-entry-tool.d/omarchy-uki.conf
#     — gives $ESP_PATH/EFI/Linux/<CUSTOM_UKI_NAME or machine-id>_<kernel>.efi
#     (omarchy-defaults.conf sets CUSTOM_UKI_NAME="omarchy"); otherwise
#     $ESP_PATH/<machine-id>/<kernel>/initramfs. ESP_PATH and the switches come
#     from limine's own loader order (/usr/lib/limine/limine-common-functions
#     load_config). mkinitcpio builds reproducibly ("Reproducibility: set all
#     timestamps to 0") and limine-entry-tool does not rewrite an identical
#     image ("Avoid rewriting identical initramfs or UKI files"), so only an
#     image that had to change is required to be newer than the run.
#   * Read-only snapshot boots: limine-mkinitcpio-hook ships the busybox
#     btrfs-overlayfs runtime hook AND sd-btrfs-overlayfs, which bundles
#     overlayfs-setup.service (WantedBy=initrd.target) for the systemd initrd.
#     The drop-in swaps to the sd- variant when it is installed, so snapshots
#     booted from the Limine menu keep their writable overlay. On an older
#     limine-mkinitcpio-hook without it, snapshot boots lose the overlay under
#     systemd init; normal boots are unaffected either way.
#   * Packages come from the official repos via omarchy-pkg-add (libfido2:
#     fido2-token + the library sd-encrypt bundles). Official repos only, never the AUR.
#
# Reverting: `hyprconf-yubikey disable` removes both drop-ins and rebuilds
# (the LUKS slot stays; the passphrase boots the box through Omarchy's encrypt
# hook again); `remove` also wipes the FIDO2 slot. Passphrase slots are never
# touched: the only --wipe-slot this tool knows is fido2.
#
# Paths are env-overridable (never read-only) so the hermetic suite points them
# at tmp copies; every external command is a recording stub on PATH there.
#
# No errexit (`-e`): each step reports its own failure through die/warn with
# what it means for the boot config; an unexplained abort half-way is worse.
set -uo pipefail

: "${_HYPRCONF_LIMINE_DEFAULT:=/etc/default/limine}"
: "${_HYPRCONF_LIMINE_ENTRY_CONF:=/etc/limine-entry-tool.conf}"
: "${_HYPRCONF_LIMINE_CONF_D:=/etc/limine-entry-tool.d}"
: "${_HYPRCONF_LIMINE_USR_D:=/usr/share/limine-entry-tool.d}"
: "${_HYPRCONF_MKINITCPIO_D:=/etc/mkinitcpio.conf.d}"
: "${_HYPRCONF_FIDO2_DROPIN:=zz-hyprconf-fido2.conf}"  # both drop-ins' basename
: "${_HYPRCONF_INITCPIO_INSTALL:=/usr/lib/initcpio/install}"
: "${_HYPRCONF_VCONSOLE:=/etc/vconsole.conf}"
# A non-empty value treats stdin/stdout as a terminal — the hermetic suite's
# only way into the prompts (a pytest run has no tty), same as install.sh.
: "${_HYPRCONF_ASSUME_TTY:=}"
: "${_HYPRCONF_MACHINE_ID:=/etc/machine-id}"
: "${_HYPRCONF_MODULES_DIR:=/usr/lib/modules}"
: "${_HYPRCONF_EFI_DIR:=/sys/firmware/efi}"

DEVICE=""          # --device
YES=0              # --yes
SNAPSHOT=1         # --no-snapshot clears it
ALLOW_NON_LATIN=0  # --allow-non-latin-layout
CHANGED=0          # set by every step that modified a file
DEV=""             # picked LUKS2 device
DEV_UUID=""
MAPPER=""          # the /dev/mapper name the root is opened under
# The KERNEL_CMDLINE[default] line of /etc/default/limine limine_find_line
# picked: the file's lines, the line's index, its parameters (quotes stripped),
# and whether the file has a plain `=` default line.
L_LINES=() L_IDX="" L_VALUE="" L_PLAIN=0

die()  { printf 'hyprconf-yubikey: %s\n' "$*" >&2; exit 1; }
warn() { printf 'hyprconf-yubikey: warning: %s\n' "$*" >&2; }
info() { printf '%s\n' "$*"; }
have() { command -v -- "$1" >/dev/null 2>&1; }

# Root work: direct as root, else through sudo (the suite stubs sudo).
run_root() {
    if ((EUID == 0)); then "$@"; else sudo -- "$@"; fi
}

# Same, but never prompts (status must stay non-interactive).
run_root_quiet() {
    if ((EUID == 0)); then "$@"; else sudo -n -- "$@"; fi
}

# --yes skips the question; without a terminal there is nobody to ask, so
# refuse rather than guess.
confirm() {
    ((YES)) && return 0
    [[ -t 0 && -t 1 ]] || [[ -n $_HYPRCONF_ASSUME_TTY ]] || die "no terminal to confirm on — re-run with --yes"
    local answer
    read -r -p "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
}

usage() {
    cat <<EOF
hyprconf-yubikey — FIDO2 key (YubiKey) unlock of the LUKS2 root at boot, on Omarchy

usage: hyprconf-yubikey status                 devices, enrolment and boot-config state (default)
       hyprconf-yubikey enroll  [options]     enrol the plugged-in key, switch the initramfs to systemd
       hyprconf-yubikey disable [options]     undo the boot config (both drop-ins); LUKS slot kept
       hyprconf-yubikey remove  [options]     wipe the FIDO2 LUKS slot, then disable
       hyprconf-yubikey sudo                  FIDO2 for sudo/polkit: Omarchy's omarchy-setup-security-fido2
       hyprconf-yubikey help

options (enroll, disable, remove):
  --device /dev/X   use this LUKS2 device instead of the picker
  --yes             no prompts; required when there is no terminal to confirm on
  --no-snapshot     skip the \`omarchy snapshot create\` taken before the boot
                    config changes (libfido2 goes in first — fido2-token is
                    how the key is seen at all)
  --allow-non-latin-layout   (enroll) go ahead although $_HYPRCONF_VCONSOLE's
                    XKBLAYOUT starts with a non-Latin layout — see below

what enroll changes (every step is idempotent; nothing is touched before the
confirmation, and a kernel cmdline it cannot read with certainty stops it
before anything is; cryptdevice= is kept):
  1. libfido2 via omarchy-pkg-add (fido2-token + the library the initramfs bundles)
  2. omarchy snapshot create — the restore point, before anything below changes
  3. systemd-cryptenroll --fido2-device=auto --fido2-with-client-pin=yes <dev>
     asks for the LUKS passphrase, the key's FIDO2 PIN, then a touch — the
     passphrase slot stays as the fallback
  4. $_HYPRCONF_LIMINE_CONF_D/$_HYPRCONF_FIDO2_DROPIN — first, so an abort
     between the two drop-ins leaves the inert state (rd.luks.* is ignored
     by the busybox encrypt hook; the systemd hooks without rd.luks.* would
     poison the next rebuild)
     a limine-entry-tool drop-in, the way Omarchy's hibernation setup
     adds resume= (its resume.conf, in the same directory):
       KERNEL_CMDLINE[default]+=" rd.luks.name=<UUID>=<name> rd.luks.options=<UUID>=fido2-device=auto"
     <name> being the mapper cryptdevice= opens and root=/dev/mapper/<name>
     uses on the KERNEL_CMDLINE[default] line of $_HYPRCONF_LIMINE_DEFAULT
     (they must agree). That file is read, never edited.
  5. $_HYPRCONF_MKINITCPIO_D/$_HYPRCONF_FIDO2_DROPIN
     rewrites Omarchy's HOOKS for the systemd initramfs: udev->systemd,
     encrypt->sd-encrypt, keymap->sd-vconsole, btrfs-overlayfs->sd-btrfs-overlayfs
     (when installed), consolefont and resume dropped, everything else kept;
     beside it, .$_HYPRCONF_FIDO2_DROPIN.verified records what the boot
     images were last verified built from (removed by disable)
  6. limine-mkinitcpio — rebuilds the boot images (UKI or initramfs, per
     limine's ENABLE_UKI) and the Limine entries: the same rebuild Omarchy's
     own hibernation setup runs after changing its drop-in (the bootloader
     binary on the ESP does not change, so nothing re-deploys it).
     limine-mkinitcpio exits 0 even when a build fails, so its output is
     checked for limine-mkinitcpio-install's "mkinitcpio failed for kernel"
     and every installed kernel's image is looked up on the ESP (limine's
     ESP_PATH) before success is announced; a failed build leaves the
     previous image in place, which still boots.

at boot: plug the key in, enter its PIN, touch it. With no key present systemd
waits token-timeout (30 s by default, crypttab(5)) and then asks for the
passphrase. The key needs a FIDO2 PIN: \`fido2-token -S /dev/hidrawN\` sets one
(\`fido2-token -L\` lists devices; both from libfido2).

keyboard layout: Omarchy bundles $_HYPRCONF_VCONSOLE into the initramfs
only when XKBLAYOUT's first layout types Latin letters (the guard at the end of
/etc/mkinitcpio.conf.d/omarchy_hooks.conf); the systemd initramfs bundles it
always. With a Hebrew/Greek/Cyrillic/Arabic/... first layout the passphrase
prompt uses that layout, and a Latin passphrase may become untypeable — locking
you out when the key is missing. enroll refuses such a layout unless
--allow-non-latin-layout is given; then make sure the passphrase can be typed
on it (or switch the first layout: localectl set-x11-keymap).

snapshot boots: read-only snapshots started from the Limine menu keep their
writable overlay only when limine-mkinitcpio-hook ships sd-btrfs-overlayfs
(the drop-in swaps to it); an older limine-mkinitcpio-hook without it loses the
overlay under systemd init. Normal boots are unaffected either way.

revert: \`hyprconf-yubikey disable\` puts the boot config back on Omarchy's encrypt
hook (passphrase unlock; the FIDO2 slot stays): both drop-ins go, nothing on
$_HYPRCONF_LIMINE_DEFAULT changes. \`hyprconf-yubikey remove\` also wipes the
FIDO2 slot (systemd-cryptenroll --wipe-slot=fido2).
Passphrase slots are never touched.
EOF
}

parse_flags() {
    while (($#)); do
        case $1 in
            --device) [[ -n ${2:-} ]] || die "--device needs a path"; DEVICE=$2; shift 2 ;;
            --device=*) DEVICE=${1#*=}; shift ;;
            --yes | -y) YES=1; shift ;;
            --no-snapshot) SNAPSHOT=0; shift ;;
            --allow-non-latin-layout) ALLOW_NON_LATIN=1; shift ;;
            -h | --help) usage; exit 0 ;;
            *) die "unknown argument: $1 (see: hyprconf-yubikey help)" ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Devices
# ---------------------------------------------------------------------------

# One "path|version|uuid" line per crypto_LUKS device. -r prints raw, single-
# space-separated fields, so awk must split on exactly one space or an empty
# FSVER would shift the UUID left — and the fields must come back OUT through
# a non-whitespace delimiter, or the consumers' `read` would collapse the
# empty field again and hand the UUID to ver. PATH rather than NAME: a LUKS
# container on a dm device lists as NAME=vg-lv but PATH=/dev/mapper/vg-lv.
list_luks() {
    lsblk -rno PATH,FSTYPE,FSVER,UUID 2>/dev/null |
        awk -F'[ ]' '$2 == "crypto_LUKS" { print $1 "|" $3 "|" $4 }'
}

# Sets DEV and DEV_UUID. --device skips the picker; LUKS1 is refused
# (systemd-cryptenroll needs LUKS2); one candidate is taken as is, several
# need a terminal for the menu or --device.
pick_device() {
    local -a rows=() cands=() all_paths=()
    local row path ver uuid
    mapfile -t rows < <(list_luks)
    ((${#rows[@]})) || die "no LUKS device found (lsblk -rno PATH,FSTYPE,FSVER,UUID lists none)"
    for row in "${rows[@]}"; do
        IFS='|' read -r path ver uuid <<<"$row"
        all_paths+=("$path")
        if [[ -n $DEVICE && $path != "$DEVICE" ]]; then
            continue
        fi
        if [[ $ver != 2 ]]; then
            [[ -n $DEVICE ]] && die "$path is LUKS${ver:-?} — systemd-cryptenroll needs LUKS2 (see cryptsetup(8) convert)"
            warn "$path is LUKS${ver:-?} — not eligible, LUKS2 is required"
            continue
        fi
        [[ -n $uuid ]] || { [[ -n $DEVICE ]] && die "$path has no UUID"; continue; }
        cands+=("$path $uuid")
    done
    if [[ -n $DEVICE ]]; then
        ((${#cands[@]})) || die "$DEVICE is not a LUKS device (lsblk lists: ${all_paths[*]})"
        read -r DEV DEV_UUID <<<"${cands[0]}"
        return 0
    fi
    ((${#cands[@]})) || die "no LUKS2 device found"
    if ((${#cands[@]} == 1)); then
        read -r DEV DEV_UUID <<<"${cands[0]}"
        return 0
    fi
    local -a paths=("${cands[@]%% *}")
    ((YES)) && die "several LUKS2 devices — pick one with --device: ${paths[*]}"
    [[ -t 0 && -t 1 ]] || [[ -n $_HYPRCONF_ASSUME_TTY ]] || die "several LUKS2 devices and no terminal — pick one with --device: ${paths[*]}"
    local i=1 choice
    info "LUKS2 devices:"
    for row in "${cands[@]}"; do
        info "  $i) $row"
        ((i++))
    done
    read -r -p "Which one? [1-${#cands[@]}] " choice
    [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#cands[@]})) || die "invalid choice"
    read -r DEV DEV_UUID <<<"${cands[choice - 1]}"
}

fido2_slot_present() {  # <dev>; needs root to read the LUKS header
    run_root cryptsetup luksDump "$1" 2>/dev/null | grep -q systemd-fido2
}

# ---------------------------------------------------------------------------
# Preflight — read-only; nothing here changes the system
# ---------------------------------------------------------------------------

# XKBLAYOUT's first layout from vconsole.conf, read the way Omarchy's guard
# reads it (`. /etc/vconsole.conf && echo "${XKBLAYOUT%%,*}"`): the last
# assignment wins, one pair of quotes goes. Empty when the file or the key is
# absent — Omarchy bundles the file then, so that counts as Latin here too.
vconsole_xkblayout() {
    local line val=""
    [[ -r $_HYPRCONF_VCONSOLE ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*XKBLAYOUT=(.*)$ ]] || continue
        val=${BASH_REMATCH[1]}
    done <"$_HYPRCONF_VCONSOLE"
    val=${val#\"}; val=${val%\"}
    val=${val#\'}; val=${val%\'}
    printf '%s\n' "${val%%,*}"
}

# The guard at the end of /etc/mkinitcpio.conf.d/omarchy_hooks.conf, layout
# list copied verbatim: Omarchy withholds /etc/vconsole.conf from the image for
# these, "so bundling a Hebrew/Greek/Cyrillic/Arabic layout would [not] make the
# correct passphrase untypeable and lock the user out". sd-vconsole bundles the
# file unconditionally, so under the systemd initramfs that protection is gone.
check_layout() {
    local layout
    layout=$(vconsole_xkblayout)
    case $layout in
        af | am | ara | bd | bg | by | et | ge | gr | il | in | iq | ir | kg | kh | kz | la | lk | mk | mm | mn | mv | np | rs | ru | sy | th | tj | ua) ;;
        *) return 0 ;;
    esac
    if ((ALLOW_NON_LATIN)); then
        warn "XKBLAYOUT in $_HYPRCONF_VCONSOLE starts with '$layout', a non-Latin layout: the systemd initramfs bundles the file, so the passphrase prompt at boot uses it — make sure the passphrase can be typed on it, or you are locked out without the key (--allow-non-latin-layout given, going on)"
        return 0
    fi
    die "XKBLAYOUT in $_HYPRCONF_VCONSOLE starts with '$layout', a non-Latin layout: Omarchy keeps that out of the initramfs so the LUKS passphrase stays typeable (omarchy_hooks.conf), the systemd initramfs cannot. Put a Latin layout first (localectl set-x11-keymap), or re-run with --allow-non-latin-layout if the passphrase is typeable on '$layout' — see: hyprconf-yubikey help"
}

preflight() {
    have omarchy-pkg-add || die "omarchy-pkg-add not found — hyprconf-yubikey runs on Omarchy only"
    have systemd-cryptenroll || die "systemd-cryptenroll not found (package systemd)"
    have limine-mkinitcpio || die "limine-mkinitcpio not found (package limine-mkinitcpio-hook) — Omarchy boots with Limine"
    check_layout
}

# libfido2 = fido2-token + the library sd-encrypt bundles into the initramfs.
# omarchy-pkg-add is a no-op when the package is present (it checks
# omarchy-pkg-missing first) — the same call Omarchy's own FIDO2 script makes.
# It is the first thing that touches the system, so it runs only after the
# confirmation.
install_libfido2() {
    omarchy-pkg-add libfido2 || die "could not install libfido2 (omarchy-pkg-add libfido2)"
}

# Like omarchy-setup-security-fido2's check_fido2_hardware, plus a plug-it-in
# retry on a terminal (three tries).
wait_for_token() {
    local tries=0 tokens
    while :; do
        tokens=$(fido2-token -L 2>/dev/null)
        if [[ -n $tokens ]]; then
            info "FIDO2 token: ${tokens%%$'\n'*}"
            return 0
        fi
        ((tries++))
        if ((YES)) || { [[ ! -t 0 ]] && [[ -z $_HYPRCONF_ASSUME_TTY ]]; } || ((tries >= 3)); then
            die "no FIDO2 device detected (fido2-token -L) — plug the key in (unlock it if needed) and retry"
        fi
        warn "no FIDO2 device detected (attempt $tries/3) — plug the key in"
        read -r -p "Press Enter to retry... "
    done
}

# `omarchy snapshot create` (route -> omarchy-snapshot per `omarchy commands
# --json`; it sudo's snapper itself). Exit 127 means snapper is not installed
# (omarchy-cmd-missing) — nothing to snapshot, carry on. Any other failure
# aborts: never change the boot config without the rollback point asked for.
take_snapshot() {
    ((SNAPSHOT)) || { info "Skipping the snapshot (--no-snapshot)"; return 0; }
    info "Taking a snapper snapshot first (omarchy snapshot create) ..."
    local rc=0
    omarchy-snapshot create || rc=$?
    case $rc in
        0) ;;
        127) warn "snapper not available — continuing without a snapshot" ;;
        *) die "snapshot failed (exit $rc) — fix it, or re-run with --no-snapshot" ;;
    esac
}

# ---------------------------------------------------------------------------
# Files: the mkinitcpio drop-in and the limine-entry-tool drop-in
# ---------------------------------------------------------------------------

# Content on stdin; tee keeps the target's owner and mode — the way Omarchy
# writes its own drop-ins (omarchy-hibernation-setup: `... | sudo tee FILE`).
write_root_file() {
    run_root tee -- "$1" >/dev/null || die "could not write $1"
}

# write_file_once <dir> <path> <what>: content on stdin; a no-op when the file
# already holds it (byte for byte), else mkdir -p + tee, and CHANGED.
write_file_once() {
    local dir=$1 path=$2 what=$3 content
    content=$(cat)
    if [[ -r $path ]] && [[ $(<"$path") == "$content" ]]; then
        info "$path: already in place"
        return 1
    fi
    run_root mkdir -p -- "$dir" || die "could not create $dir"
    write_root_file "$path" < <(printf '%s\n' "$content")
    CHANGED=1
    info "$path: written ($what)"
}

remove_file() {  # <path>
    [[ -e $1 ]] || { info "$1: already absent"; return 1; }
    run_root rm -f -- "$1" || die "could not remove $1"
    CHANGED=1
    info "$1: removed"
}

dropin_content() {
    cat <<'EOF'
# shellcheck shell=bash
# zz-hyprconf-fido2.conf — written by `hyprconf-yubikey enroll`.
# Remove with: hyprconf-yubikey disable
#
# FIDO2 unlock of the LUKS2 root at boot needs systemd's initramfs: the
# sd-encrypt hook (/usr/lib/initcpio/install/sd-encrypt) bundles
# libcryptsetup-token-systemd-fido2.so and libfido2 and honours rd.luks.name= /
# rd.luks.options= on the kernel cmdline. The busybox `encrypt` hook Omarchy
# sets in omarchy_hooks.conf cannot do FIDO2.
#
# mkinitcpio appends /etc/mkinitcpio.conf.d/*.conf to mkinitcpio.conf in name
# order and sources the result; "zz-" sorts after Omarchy's omarchy_hooks.conf
# and omarchy_resume.conf, so this file sees their final HOOKS and rewrites it
# without editing anything Omarchy owns:
#   udev -> systemd, encrypt -> sd-encrypt, keymap -> sd-vconsole,
#   btrfs-overlayfs -> sd-btrfs-overlayfs (limine-mkinitcpio-hook's systemd
#   twin, when installed — keeps read-only snapshot boots writable),
#   consolefont and resume dropped (sd-vconsole covers the font; systemd
#   resumes itself from resume= on the cmdline), empty elements dropped,
#   everything else (plymouth, kms, ...) left where it is.
# _HYPRCONF_INITCPIO_INSTALL exists for the hermetic test-suite only.
_hyprconf_hooks=()
for _hyprconf_hook in "${HOOKS[@]}"; do
  case $_hyprconf_hook in
    udev) _hyprconf_hooks+=(systemd) ;;
    encrypt) _hyprconf_hooks+=(sd-encrypt) ;;
    keymap) _hyprconf_hooks+=(sd-vconsole) ;;
    btrfs-overlayfs)
      if [[ -r "${_HYPRCONF_INITCPIO_INSTALL:-/usr/lib/initcpio/install}/sd-btrfs-overlayfs" ]]; then
        _hyprconf_hooks+=(sd-btrfs-overlayfs)
      else
        _hyprconf_hooks+=(btrfs-overlayfs)
      fi
      ;;
    consolefont | resume | '') ;;
    *) _hyprconf_hooks+=("$_hyprconf_hook") ;;
  esac
done
HOOKS=("${_hyprconf_hooks[@]}")
unset _hyprconf_hooks _hyprconf_hook
EOF
}

dropin_path() { printf '%s/%s\n' "$_HYPRCONF_MKINITCPIO_D" "$_HYPRCONF_FIDO2_DROPIN"; }

# The mkinitcpio drop-in changes the hook set, so the boot image must come
# out different — but "different" is measured against the LAST VERIFIED
# rebuild, not this run's writes: a change whose rebuild failed is still
# pending on the next run (a rerun's no-op write must not read as clean),
# and a disable that reverts a failed enroll is already satisfied by the
# pre-enroll image on the ESP. verify_boot_images compares the fingerprints
# below; the limine drop-in only changes the cmdline.
# Both writers seed only when a change is actually coming: a no-op write or
# removal carries no information about the ESP (and a disable on a box that
# was never configured must make no root call at all — pinned).
write_dropin() {
    if ! { [[ -r $(dropin_path) ]] && [[ $(<"$(dropin_path)") == "$(dropin_content)" ]]; }; then
        seed_verified_state
    fi
    write_file_once "$_HYPRCONF_MKINITCPIO_D" "$(dropin_path)" "systemd initramfs hooks" < <(dropin_content) || true
    return 0
}

remove_dropin() {
    if [[ -e $(dropin_path) ]]; then
        seed_verified_state
    fi
    remove_file "$(dropin_path)" || true
    return 0
}

# What the ESP images are believed built from, as far as this tool changes
# them: the hooks drop-in's bytes, or "absent". Recorded after every verified
# rebuild, and SEEDED from the pre-change config the first time a drop-in is
# about to change — so a box enrolled by a release without the record (or
# whose enroll died mid-rebuild) carries the right baseline forward. A
# missing (or unreadable) record means "unknown": verify accepts an
# identical unrewritten image and records it, the pre-record behaviour, so
# an idempotent re-run on an upgraded box never falsely dies. disable
# removes the record — reverting to stock leaves no residue, and README's
# /etc inventory names it while it exists.
config_fingerprint() {
    if [[ -r $(dropin_path) ]]; then sha256sum < "$(dropin_path)"; else echo absent; fi
}

verified_state_path() { printf '%s/.%s.verified\n' "$_HYPRCONF_MKINITCPIO_D" "$_HYPRCONF_FIDO2_DROPIN"; }

record_verified_state() {
    { config_fingerprint | run_root tee -- "$(verified_state_path)" >/dev/null &&
        run_root chmod 644 -- "$(verified_state_path)"; } ||
        warn "could not record the verified hook set at $(verified_state_path) — a later identical-image check may misjudge"
    return 0
}

# Once, before the first drop-in change: what the ESP was last built from is
# the config as it stands right now.
seed_verified_state() {
    [[ -f $(verified_state_path) ]] || record_verified_state
}

limine_dropin_path() { printf '%s/%s\n' "$_HYPRCONF_LIMINE_CONF_D" "$_HYPRCONF_FIDO2_DROPIN"; }

# limine_dropin_content <uuid> <mapper>: one line, the shape Omarchy's
# omarchy-hibernation-setup writes resume.conf in (KERNEL_CMDLINE[default]+=" ...").
limine_dropin_content() {
    printf 'KERNEL_CMDLINE[default]+=" rd.luks.name=%s=%s rd.luks.options=%s=fido2-device=auto"\n' "$1" "$2" "$1"
}

write_limine_dropin() {  # <uuid> <mapper>
    write_file_once "$_HYPRCONF_LIMINE_CONF_D" "$(limine_dropin_path)" "rd.luks.* kernel parameters" < <(limine_dropin_content "$1" "$2")
    return 0
}

remove_limine_dropin() {
    remove_file "$(limine_dropin_path)"
    return 0
}

# ---------------------------------------------------------------------------
# /etc/default/limine: read for the mapper name, never written
# ---------------------------------------------------------------------------

# split_cmdline_line <line>: L_VALUE — the parameters after the `=` or `+=`,
# quotes stripped. Both forms /etc/limine-entry-tool.conf documents: the
# quoted one Omarchy's template writes (default/limine/default.conf:
# KERNEL_CMDLINE[default]+="...") and the bare one, which may carry quotes of
# its own ("No quotes are needed at the start or end of command lines, since
# quotes inside are not escaped"; example: KERNEL_CMDLINE[default]+=quiet
# splash acpi_osi="..."). So a value is quoted only when it STARTS with a
# quote, and only when that quote's partner is the last thing on the line
# before an optional # comment. A value that starts with a quote but has more
# of them inside is ambiguous, and so is a # anywhere in the parameters ("Do
# not add # as a comment at the end of command lines" — what one does is not
# documented). Returns 1 on either: this tool never reads a mapper name from a
# line it cannot read with certainty.
split_cmdline_line() {
    local rest=${1#*=} q re
    [[ $rest =~ ^[[:space:]]*(.*)$ ]] && rest=${BASH_REMATCH[1]}
    L_VALUE=$rest
    case $rest in
        \"* | \'*)
            q=${rest:0:1}
            re="^$q([^$q]*)${q}[[:space:]]*(#.*)?\$"
            [[ $rest =~ $re ]] || return 1
            L_VALUE=${BASH_REMATCH[1]}
            ;;
    esac
    [[ $L_VALUE != *#* ]]
}

# mapper_name <value>: the /dev/mapper name the root is opened under, read
# from the picked line and nowhere else — Omarchy's encrypt-hook form
# cryptdevice=<dev>:<name>[:opts], and root=/dev/mapper/<name>. Both present
# must agree, one is enough, neither is not a LUKS-root line this tool
# understands. rd.luks.name must yield the /dev/mapper/<name> root= points at,
# or the box does not boot. Runs in a subshell: die ends that.
mapper_name() {
    local w from_crypt="" from_root=""
    local -a words=()
    read -r -a words <<<"$1"
    for w in "${words[@]}"; do
        case $w in
            cryptdevice=*:*) from_crypt=${w#cryptdevice=*:}; from_crypt=${from_crypt%%:*} ;;
            root=/dev/mapper/?*) from_root=${w#root=/dev/mapper/} ;;
        esac
    done
    if [[ -n $from_crypt && -n $from_root && $from_crypt != "$from_root" ]]; then
        die "cryptdevice= opens '$from_crypt' but root=/dev/mapper/$from_root, on the same line of $_HYPRCONF_LIMINE_DEFAULT — fix that by hand first"
    fi
    [[ -n $from_crypt$from_root ]] ||
        die "neither cryptdevice=<dev>:<name> nor root=/dev/mapper/<name> on the KERNEL_CMDLINE[default] line of $_HYPRCONF_LIMINE_DEFAULT — cannot tell what to name the unlocked root"
    printf '%s\n' "${from_crypt:-$from_root}"
}

# cmdline_check <uuid> <name> <value>: what /etc/default/limine's line carries
# beside the drop-in must not fight it. systemd keeps ONE rd.luks.options= per
# device — systemd-cryptsetup-generator(8): it "will override the options for
# the given UUID" — so one there for <uuid> would win over, or lose to, the
# drop-in's fido2-device=auto; an rd.luks.name=<uuid>= there must name the
# same mapper.
cmdline_check() {
    local uuid=$1 name=$2 w
    local -a words=()
    read -r -a words <<<"$3"
    for w in "${words[@]}"; do
        case $w in
            "rd.luks.name=$uuid="*)
                [[ ${w#*=*=} == "$name" ]] ||
                    die "$w is on the KERNEL_CMDLINE[default] line of $_HYPRCONF_LIMINE_DEFAULT but the root is /dev/mapper/$name — fix that line by hand first"
                ;;
            "rd.luks.options=$uuid="*)
                die "$w on the KERNEL_CMDLINE[default] line of $_HYPRCONF_LIMINE_DEFAULT would override the drop-in's rd.luks.options=$uuid=fido2-device=auto (systemd keeps one rd.luks.options= per device) — remove it from that line first"
                ;;
        esac
    done
}

# limine_find_line: /etc/default/limine into L_LINES and the KERNEL_CMDLINE[default]
# line this tool reads into L_IDX — the one carrying cryptdevice=, else the
# first uncommented one; L_PLAIN when any such line assigns with `=` rather
# than `+=`. Returns 1 when the file is unreadable or has no such line.
limine_find_line() {
    local file=$_HYPRCONF_LIMINE_DEFAULT re='^[[:space:]]*KERNEL_CMDLINE\[default\]([+]?=)' i first="" crypt=""
    L_LINES=() L_IDX="" L_PLAIN=0
    [[ -r $file ]] || return 1
    mapfile -t L_LINES <"$file"
    for i in "${!L_LINES[@]}"; do
        [[ ${L_LINES[i]} =~ $re ]] || continue
        [[ ${BASH_REMATCH[1]} == '+=' ]] || L_PLAIN=1
        [[ -n $first ]] || first=$i
        [[ -n $crypt || ${L_LINES[i]} != *cryptdevice=* ]] || crypt=$i
    done
    L_IDX=${crypt:-$first}
    [[ -n $L_IDX ]]
}

# limine_read: limine_find_line, or die; then split the picked line into
# L_VALUE, or die — the mapper name comes from it, so a line that cannot be
# read with certainty stops enroll. Only enroll needs the file: disable and
# remove touch nothing but the two drop-ins, so they never read it. Runs
# before anything else has changed — enroll calls it first for exactly that.
limine_read() {
    local file=$_HYPRCONF_LIMINE_DEFAULT
    if ! limine_find_line; then
        [[ -r $file ]] || die "$file not found — Omarchy keeps the kernel cmdline there (limine-mkinitcpio-hook)"
        die "no KERNEL_CMDLINE[default] line in $file"
    fi
    split_cmdline_line "${L_LINES[L_IDX]}" ||
        die "cannot read $file line $((L_IDX + 1)) with certainty — expected KERNEL_CMDLINE[default]+=\"...\" (one pair of quotes, nothing but blanks or a # comment after them) or bare parameters without a #; fix the line by hand first (format: /etc/limine-entry-tool.conf)"
}

# ---------------------------------------------------------------------------
# The rebuild, and its proof
# ---------------------------------------------------------------------------

# limine_setting <VAR>: the value limine's own loader ends up with —
# /usr/lib/limine/limine-common-functions load_config reads
# /usr/share/limine-entry-tool.d/*.conf, /etc/limine-entry-tool.conf,
# /etc/limine-entry-tool.d/*.conf, then /etc/default/limine; the last
# assignment wins, matched and unquoted the way its load_key_value_config does
# (one pair of double quotes).
limine_setting() {
    local var=$1 file line val="" re
    re="^[[:space:]]*${var}[[:space:]]*=[[:space:]]*(.*)\$"
    for file in "$_HYPRCONF_LIMINE_USR_D"/*.conf "$_HYPRCONF_LIMINE_ENTRY_CONF" \
        "$_HYPRCONF_LIMINE_CONF_D"/*.conf "$_HYPRCONF_LIMINE_DEFAULT"; do
        [[ -f $file ]] || continue
        while IFS= read -r line || [[ -n $line ]]; do
            [[ $line =~ $re ]] || continue
            val=${BASH_REMATCH[1]}
            val=${val%\"}
            val=${val#\"}
        done <"$file"
    done
    printf '%s\n' "$val"
}

# verify_boot_images <epoch the rebuild started at>: the image every installed
# kernel boots from must be on the ESP where limine-mkinitcpio-install put it
# and, when the drop-in changed (so the image had to), newer than the run.
# Paths the way that script derives them: ESP_PATH and the UKI switch through
# limine's config loader; the kernel list from /usr/lib/modules/*/pkgbase — a
# kernel package removes pkgbase and vmlinuz together, so a directory missing
# either is a leftover the script skips as well (it checks ownership); a UKI
# is $ESP_PATH/EFI/Linux/<CUSTOM_UKI_NAME (^[a-z0-9]+$) or machine-id>_<name>.efi
# with ENABLE_UKI=yes on UEFI, an initramfs $ESP_PATH/<machine-id>/<name>/initramfs
# (limine-entry-tool README, --add-kernel / --add-uki). An unchanged image may
# keep its old mtime: mkinitcpio builds reproducibly and limine-entry-tool does
# not rewrite an identical file (see the header).
verify_boot_images() {
    local start=$1 esp mid prefix uki=0 dir name path mtime n=0
    local recorded
    local -a missing=() stale=()
    esp=$(limine_setting ESP_PATH)
    if [[ -z ${esp// /} ]]; then
        warn "ESP_PATH is set in none of limine's config files ($_HYPRCONF_LIMINE_DEFAULT last) — the images on the ESP were not double-checked; limine-mkinitcpio reported no failed build"
        return 0
    fi
    mid=$(<"$_HYPRCONF_MACHINE_ID") || die "cannot read $_HYPRCONF_MACHINE_ID — cannot locate the boot images"
    if [[ $(limine_setting ENABLE_UKI) == yes && -d $_HYPRCONF_EFI_DIR ]]; then
        uki=1
        prefix=$(limine_setting CUSTOM_UKI_NAME)
        [[ $prefix =~ ^[a-z0-9]+$ ]] || prefix=$mid
    fi
    for dir in "$_HYPRCONF_MODULES_DIR"/*/; do
        [[ -f $dir/pkgbase && -f $dir/vmlinuz ]] || continue
        name=$(<"$dir/pkgbase")
        name=${name// /}
        [[ -n $name ]] || continue
        ((n++))
        if ((uki)); then path="$esp/EFI/Linux/${prefix}_$name.efi"; else path="$esp/$mid/$name/initramfs"; fi
        # The ESP is mounted root-only on Omarchy (fmask=0077), hence run_root.
        mtime=$(run_root stat -c %Y -- "$path" 2>/dev/null)
        [[ $mtime =~ ^[0-9]+$ ]] || { missing+=("$path"); continue; }
        # FAT32 keeps mtimes to 2 s.
        if ((mtime >= start - 2)); then info "  $path: rebuilt"; else stale+=("$path"); fi
    done
    ((n)) || die "no kernel under $_HYPRCONF_MODULES_DIR (a directory with pkgbase and vmlinuz) — limine-mkinitcpio had nothing to build, so no boot image carries the new config"
    if ((${#missing[@]})); then
        die "limine-mkinitcpio finished, but no boot image at ${missing[*]} (ESP_PATH=$esp, ENABLE_UKI=$(limine_setting ENABLE_UKI), the way limine-mkinitcpio-install places them) — the boot config is changed but unproven: check limine-mkinitcpio's output above and re-run it: sudo limine-mkinitcpio"
    fi
    if ((${#stale[@]})); then
        recorded=$(cat "$(verified_state_path)" 2>/dev/null || true)
        if [[ -n $recorded && $(config_fingerprint) != "$recorded" ]]; then
            die "limine-mkinitcpio finished, but ${stale[*]} predates this run although the hook set changed since the last verified rebuild — the boot image on the ESP is the previous one and still boots; find the cause in limine-mkinitcpio's output above, then: sudo limine-mkinitcpio"
        fi
        [[ -n $recorded ]] || info "  no verified-rebuild record — accepting the identical image and recording it"
        info "  ${stale[*]}: unchanged (identical image, not rewritten)"
    fi
    record_verified_state
    info "Boot images verified on $esp."
}

# limine-mkinitcpio exits 0 even when a build fails (see the header), so keep
# its output, refuse limine-mkinitcpio-install's failure messages — error_msg
# "mkinitcpio failed for kernel ${KERNEL_VERSION}, skipping." and, for a UKI,
# "failed to get kernel cmdline for '<name>'." — and then look for the images.
rebuild_boot() {
    local start out rc=0
    start=$(date +%s)
    info "Rebuilding the boot images and the Limine entries (limine-mkinitcpio) ..."
    # Live on stderr and kept; pipefail hands limine-mkinitcpio's status through tee.
    out=$(run_root limine-mkinitcpio 2>&1 | tee /dev/stderr) || rc=$?
    if ((rc != 0)); then
        die "limine-mkinitcpio exited $rc — the boot images on the ESP are the previous ones and still boot (limine installs an image only after it built); fix the error above, then: sudo limine-mkinitcpio"
    fi
    if grep -q -F -e "mkinitcpio failed for kernel" -e "failed to get kernel cmdline for" <<<"$out"; then
        die "limine-mkinitcpio reported a failed build (it exits 0 regardless) — the boot image on the ESP is the previous one and still boots (limine installs an image only after it built); fix the error above, then: sudo limine-mkinitcpio"
    fi
    verify_boot_images "$start"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_enroll() {
    parse_flags "$@"
    preflight
    pick_device
    limine_read
    ((L_PLAIN)) && die "$_HYPRCONF_LIMINE_DEFAULT assigns KERNEL_CMDLINE[default] with = — that replaces every parameter the drop-ins in $_HYPRCONF_LIMINE_CONF_D add, Omarchy's included (/etc/limine-entry-tool.conf: \"/etc/default/limine overrides any drop-in configs\"), so $(limine_dropin_path) could never reach the kernel; make it += first"
    MAPPER=$(mapper_name "$L_VALUE") || exit 1
    cmdline_check "$DEV_UUID" "$MAPPER" "$L_VALUE"
    info "Device: $DEV (LUKS2, UUID $DEV_UUID)"
    info "Drop-in $(limine_dropin_path): $(limine_dropin_content "$DEV_UUID" "$MAPPER")"
    confirm "Enrol the plugged-in FIDO2 key to unlock $DEV at boot (installs libfido2, snapshot, LUKS slot, initramfs drop-in, cmdline drop-in, limine-mkinitcpio)?" ||
        die "aborted — nothing changed"
    install_libfido2
    wait_for_token
    take_snapshot
    if fido2_slot_present "$DEV"; then
        info "$DEV: a FIDO2 token is already enrolled — keeping it (to add another key:" \
            "sudo systemd-cryptenroll --fido2-device=auto --fido2-with-client-pin=yes $DEV)"
    else
        info "systemd-cryptenroll will ask for the LUKS passphrase, the key's FIDO2 PIN, then a touch."
        run_root systemd-cryptenroll --fido2-device=auto --fido2-with-client-pin=yes "$DEV" ||
            die "systemd-cryptenroll failed — nothing else was changed"
        info "$DEV: FIDO2 token enrolled (the passphrase slot stays)"
    fi
    # Cmdline drop-in first, hooks drop-in second: an abort between the two
    # must leave the inert state. rd.luks.* with the busybox encrypt hook is
    # ignored (the header's own fact), but a hooks drop-in with no rd.luks.*
    # turns the NEXT rebuild from any source — a kernel upgrade — into a
    # systemd initramfs that never unlocks the root. disable_boot_config
    # removes in the mirror order (hooks first) for the same reason.
    write_limine_dropin "$DEV_UUID" "$MAPPER"
    write_dropin
    rebuild_boot
    info ""
    info "Done. Reboot to test — plug the key in, enter its PIN, touch it."
    info "The passphrase still works as a fallback (systemd asks for it after token-timeout, 30 s)."
    info "Revert with: hyprconf-yubikey disable"
}

disable_boot_config() {
    remove_dropin
    remove_limine_dropin
    if ((CHANGED)); then
        rebuild_boot
    else
        info "Nothing to rebuild — FIDO2 boot unlock was not configured."
    fi
    # Stock means no residue: the believed-ESP record goes too; the next
    # enroll re-seeds it from the config it finds.
    if [[ -e $(verified_state_path) ]]; then
        run_root rm -f -- "$(verified_state_path)"
    fi
    info "Boot config is back on Omarchy's encrypt hook: the passphrase unlocks the root."
}

cmd_disable() {
    parse_flags "$@"
    confirm "Disable FIDO2 unlock at boot (remove both drop-ins) and rebuild?" ||
        die "aborted — nothing changed"
    take_snapshot
    disable_boot_config
    info "The FIDO2 LUKS slot is kept; wipe it with: hyprconf-yubikey remove"
}

cmd_remove() {
    parse_flags "$@"
    have systemd-cryptenroll || die "systemd-cryptenroll not found (package systemd)"
    pick_device
    confirm "Wipe the FIDO2 slot on $DEV (passphrase slots are kept) and disable FIDO2 boot unlock?" ||
        die "aborted — nothing changed"
    take_snapshot
    # Only the FIDO2 token slots go — systemd-cryptenroll(1) --wipe-slot=fido2.
    run_root systemd-cryptenroll --wipe-slot=fido2 "$DEV" ||
        die "systemd-cryptenroll --wipe-slot=fido2 failed — nothing else was changed"
    info "$DEV: FIDO2 slot wiped"
    disable_boot_config
}

cmd_status() {
    local dropin limine_dropin limine tokens row path ver uuid slot sd_overlay
    dropin=$(dropin_path)
    limine_dropin=$(limine_dropin_path)
    limine=$_HYPRCONF_LIMINE_DEFAULT
    info "hyprconf-yubikey status"
    if have omarchy-pkg-add; then info "  omarchy:              found (omarchy-pkg-add)"; else info "  omarchy:              NOT found — not an Omarchy box?"; fi
    if have systemd-cryptenroll; then info "  systemd-cryptenroll:  found"; else info "  systemd-cryptenroll:  NOT found"; fi
    if have fido2-token; then info "  libfido2:             installed (fido2-token)"; else info "  libfido2:             not installed (enroll installs it)"; fi
    tokens=$(fido2-token -L 2>/dev/null || true)
    if [[ -n $tokens ]]; then info "  FIDO2 token:          plugged in — ${tokens%%$'\n'*}"; else info "  FIDO2 token:          none detected"; fi
    info "  LUKS devices:"
    local any=0
    while IFS='|' read -r path ver uuid; do
        [[ -n $path ]] || continue
        any=1
        if [[ $ver == 2 ]]; then
            if run_root_quiet cryptsetup luksDump "$path" 2>/dev/null | grep -q systemd-fido2; then
                slot="yes"
            elif run_root_quiet cryptsetup luksDump "$path" >/dev/null 2>&1; then
                slot="no"
            else
                slot="unknown (run as root)"
            fi
            info "    $path  LUKS2  UUID $uuid  systemd-fido2 slot: $slot"
        else
            info "    $path  LUKS${ver:-?}  UUID $uuid  (not eligible — LUKS2 required)"
        fi
    done < <(list_luks)
    ((any)) || info "    none found"
    if [[ -e $dropin ]]; then info "  initramfs drop-in:    present ($dropin)"; else info "  initramfs drop-in:    absent ($dropin)"; fi
    if [[ -e $limine_dropin ]]; then info "  cmdline drop-in:      present ($limine_dropin)"; else info "  cmdline drop-in:      absent ($limine_dropin)"; fi
    if [[ ! -r $limine ]]; then
        info "  kernel cmdline:       $limine not found"
    elif ! limine_find_line; then
        info "  kernel cmdline:       no KERNEL_CMDLINE[default] line in $limine"
    elif ((L_PLAIN)); then
        info "  kernel cmdline:       KERNEL_CMDLINE[default]= (not +=) in $limine replaces every drop-in's parameters — enroll refuses it"
    else
        info "  kernel cmdline:       KERNEL_CMDLINE[default]+= line found in $limine (read for the mapper name, never edited)"
    fi
    if [[ -r $_HYPRCONF_INITCPIO_INSTALL/sd-btrfs-overlayfs ]]; then
        sd_overlay="sd-btrfs-overlayfs installed — read-only snapshot boots keep their overlay"
    else
        sd_overlay="sd-btrfs-overlayfs NOT installed — snapshot boots lose their overlay under systemd init (normal boots unaffected)"
    fi
    info "  snapshot boots:       $sd_overlay"
    return 0
}

# FIDO2 for sudo + polkit (pam_u2f) is Omarchy's own job — omarchy-setup-security-fido2
# installs libfido2 + pam-u2f, registers the key in /etc/fido2/fido2 and edits
# /etc/pam.d/{sudo,polkit-1} — so hand over rather than duplicate it.
cmd_sudo() { exec omarchy-setup-security-fido2 "$@"; }

main() {
    local cmd=${1:-status}
    (($#)) && shift
    case $cmd in
        status) cmd_status "$@" ;;
        enroll | enrol) cmd_enroll "$@" ;;
        disable) cmd_disable "$@" ;;
        remove) cmd_remove "$@" ;;
        sudo) cmd_sudo "$@" ;;
        help | -h | --help) usage ;;
        *) die "unknown subcommand: $cmd (see: hyprconf-yubikey help)" ;;
    esac
}

main "$@"

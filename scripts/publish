#!/usr/bin/env bash
set -euo pipefail

# scripts/publish — test → deploy → publish dev to mainline (filtered)
#
# Usage:
#   bash scripts/publish [options]
#
# Options:
#   --skip-tests    Skip the full test suite (tiers 1-5); also skips VM lifecycle
#   --skip-deploy   Skip the hyprconf deploy step
#   --dry-run       Build the filtered commit but do not push
#
# What this script does:
#   1. Verifies dev branch with clean working tree
#   2. Starts the test VM if not already running, stops it when done
#   3. Runs all 5 test tiers (unit / integration / tui / vm / install)
#   4. Deploys to hyprconf.sh via:  hyprconf deploy hyprconf.sh
#   5. Creates a filtered snapshot of dev and pushes it to origin/mainline
#      — the following dev-only paths are stripped from the mainline commit:
#           tests/  pyproject.toml  AGENTS.md  .github/  Makefile

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

VM_RUN_SCRIPT="$REPO_ROOT/tests/vm/run_vm.sh"
VM_PID_FILE="/tmp/hyprconf-vm.pid"

INSTALL_VM_RUN_SCRIPT="$REPO_ROOT/tests/install/run_install_vm.sh"
INSTALL_VM_PID_FILE="/tmp/hyprconf-install-vm.pid"
INSTALL_IMAGE="$REPO_ROOT/tests/vm/arch-hyprconf.qcow2"
INSTALL_META="$REPO_ROOT/tests/vm/arch-hyprconf.meta"

# ── VM lifecycle helpers ───────────────────────────────────────────────────────
_vm_is_running() {
  [[ -f "$VM_PID_FILE" ]] && kill -0 "$(cat "$VM_PID_FILE")" 2>/dev/null
}

_install_vm_is_running() {
  [[ -f "$INSTALL_VM_PID_FILE" ]] && kill -0 "$(cat "$INSTALL_VM_PID_FILE")" 2>/dev/null
}

# ── Dev-only paths stripped from mainline ─────────────────────────────────────
EXCLUDE_PATHS=(
  tests
  pyproject.toml
  AGENTS.md
  .github
  Makefile
  .pytest_cache
)

# ── Flags ─────────────────────────────────────────────────────────────────────
SKIP_TESTS=false
SKIP_DEPLOY=false
DRY_RUN=false

for arg in "$@"; do
  case "$arg" in
    --skip-tests)  SKIP_TESTS=true  ;;
    --skip-deploy) SKIP_DEPLOY=true ;;
    --dry-run)     DRY_RUN=true     ;;
    --help|-h)
      sed -n '3,/^REPO_ROOT/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \?//'
      exit 0
      ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

# ── Colour palette ─────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  GR=$'\e[1;32m' AM=$'\e[1;33m' GL=$'\e[1;31m' WH=$'\e[1;37m' DM=$'\e[2;37m' RS=$'\e[0m'
else
  GR='' AM='' GL='' WH='' DM='' RS=''
fi

step() { printf '\n%s  ▸ %s%s\n'      "$AM" "$1" "$RS"; }
ok()   { printf '%s  ✔ %s%s\n'        "$GR" "$1" "$RS"; }
info() { printf '%s  ─ %s%s\n'        "$DM" "$1" "$RS"; }
warn() { printf '%s  ! %s%s\n'        "$AM" "$1" "$RS"; }
die()  { printf '%s  ✘ FATAL: %s%s\n' "$GL" "$1" "$RS" >&2; exit 1; }

# ── Single EXIT handler (accumulates cleanup tasks) ───────────────────────────
VM_STARTED_BY_US=false
INSTALL_VM_STARTED_BY_US=false
WORKTREE_DIR=""

_on_exit() {
  # Remove git worktree if one was created
  if [[ -n "$WORKTREE_DIR" ]]; then
    git worktree remove --force "$WORKTREE_DIR" 2>/dev/null || true
    rm -rf "$WORKTREE_DIR"
  fi
  # Stop the install VM if we started it
  if [[ "$INSTALL_VM_STARTED_BY_US" == true ]]; then
    printf '\n%s  ▸ Stopping install test VM%s\n' "$AM" "$RS"
    bash "$INSTALL_VM_RUN_SCRIPT" --stop 2>&1 || true
    ok "Install VM stopped"
  fi
  # Stop the tier-4 VM if we started it
  if [[ "$VM_STARTED_BY_US" == true ]]; then
    printf '\n%s  ▸ Stopping test VM%s\n' "$AM" "$RS"
    bash "$VM_RUN_SCRIPT" --stop 2>&1 || true
    ok "VM stopped"
  fi
}
trap _on_exit EXIT

# ── 1. Pre-flight checks ──────────────────────────────────────────────────────
step "Pre-flight checks"

current_branch=$(git rev-parse --abbrev-ref HEAD)
[[ "$current_branch" == "dev" ]] || die "Must be on dev branch (currently on '$current_branch')."

[[ -z "$(git status --porcelain)" ]] || die "Uncommitted changes on dev — commit or stash first."

ok "On dev, working tree clean"

# ── 2. Full test suite ────────────────────────────────────────────────────────
if [[ "$SKIP_TESTS" == false ]]; then
  step "Running test suite"

  info "Tiers 1-3: unit / integration / tui"
  make test 2>&1 || die "Tiers 1-3 failed — fix before publishing."
  ok "Tiers 1-3 passed"

  # ── VM lifecycle ────────────────────────────────────────────────────────────
  if _vm_is_running; then
    info "VM already running — reusing"
  else
    info "Starting test VM..."
    bash "$VM_RUN_SCRIPT" 2>&1 || die "VM failed to start."
    VM_STARTED_BY_US=true
  fi

  info "Tier 4: VM integration tests"
  make test-vm 2>&1 || die "Tier 4 (VM) failed — fix before publishing."
  ok "Tier 4 passed"

  info "Tier 5: install validation"

  # ── Install image detection ────────────────────────────────────────────────
  _build_install_image=false
  if [[ -f "$INSTALL_IMAGE" ]]; then
    _built_at="unknown"
    _built_commit="unknown"
    if [[ -f "$INSTALL_META" ]]; then
      _built_at="$(grep '^built_at='    "$INSTALL_META" | cut -d= -f2- || echo unknown)"
      _built_commit="$(grep '^git_commit=' "$INSTALL_META" | cut -d= -f2- || echo unknown)"
    fi
    printf '\n%s  ─ Install image found%s\n'          "$DM" "$RS"
    printf '%s  ─   Built:  %s%s\n'                   "$DM" "$_built_at"    "$RS"
    printf '%s  ─   Commit: %s%s\n\n'                 "$DM" "$_built_commit" "$RS"
    printf '  1) Use existing image (skip install.sh test — faster)\n'
    printf '  2) Rebuild from scratch (tests install.sh — ~20 min)\n\n'
    read -rp "  Choice [1/2, default 1]: " _img_choice
    case "${_img_choice:-1}" in
      2) _build_install_image=true ;;
      *) info "Reusing existing install image" ;;
    esac
  else
    info "No install image found — building from scratch..."
    _build_install_image=true
  fi

  if [[ "$_build_install_image" == true ]]; then
    step "Building install image (running install.sh end-to-end via Packer)"
    bash "$REPO_ROOT/tests/install/build_image.sh" 2>&1 \
      || die "Install image build failed — fix before publishing."
    ok "Install image built"
  fi

  # ── Install VM lifecycle ───────────────────────────────────────────────────
  if _install_vm_is_running; then
    info "Install VM already running — reusing"
  else
    info "Starting install test VM (port 2223)..."
    bash "$INSTALL_VM_RUN_SCRIPT" 2>&1 || die "Install VM failed to start."
    INSTALL_VM_STARTED_BY_US=true
  fi

  make test-install 2>&1 || die "Tier 5 (install) failed — fix before publishing."
  ok "Tier 5 passed"

  ok "All tests passed"
else
  warn "Skipping test suite and VM lifecycle (--skip-tests)"
fi

# ── 3. Deploy ─────────────────────────────────────────────────────────────────
if [[ "$SKIP_DEPLOY" == false ]]; then
  step "Deploying hyprconf.sh"
  hyprconf deploy hyprconf.sh || die "Deploy step failed."
  ok "Deployed successfully"
else
  warn "Skipping deploy (--skip-deploy)"
fi

# ── 4. Build filtered mainline commit ─────────────────────────────────────────
step "Building filtered mainline snapshot"

git fetch --quiet origin mainline

WORKTREE_DIR="$(mktemp -d /tmp/hyprconf-publish.XXXXXX)"

# Create a detached worktree at origin/mainline
git worktree add --detach --quiet "$WORKTREE_DIR" origin/mainline

cd "$WORKTREE_DIR"

# Replace the entire worktree index with dev's tree
git read-tree origin/dev
git checkout --quiet -- .

# Remove dev-only paths
for path in "${EXCLUDE_PATHS[@]}"; do
  if [[ -e "$path" ]]; then
    git rm -rf --quiet --ignore-unmatch "$path"
  fi
done

# Nothing staged means mainline is already identical — nothing to do
if git diff --cached --quiet; then
  ok "mainline is already up to date — nothing to push"
  exit 0
fi

dev_sha=$(git -C "$REPO_ROOT" rev-parse HEAD)
git commit --quiet -m "chore: [publish] sync mainline from dev ${dev_sha:0:7}

Filtered snapshot of dev (${dev_sha}).
Dev-only paths excluded: tests/ pyproject.toml AGENTS.md .github/ Makefile

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"

published_sha=$(git rev-parse HEAD)

if [[ "$DRY_RUN" == true ]]; then
  warn "Dry-run — skipping push. Filtered commit: ${published_sha:0:7}"
else
  step "Pushing to origin/mainline"
  git push origin HEAD:mainline
  ok "origin/mainline updated → ${published_sha:0:7}"
fi

cd "$REPO_ROOT"

ok "Done — dev published to mainline (dev-only paths excluded)"

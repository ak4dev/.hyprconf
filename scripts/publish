#!/usr/bin/env bash
set -euo pipefail

# scripts/publish — lint + test → promote the dev working branch to stable
#
# Usage:
#   bash scripts/publish [options]
#
# Options:
#   --patch         Bump the patch component (default)
#   --minor         Bump the minor component
#   --major         Bump the major component
#   --skip-bump     Skip automatic version bump (version must be pre-bumped manually)
#   --skip-tests    Skip the lint gates and test suite (for the integration
#                   suite's own runs of this script — every real publish must
#                   still pass them)
#   --skip-tag      Skip annotated release-tag creation
#   --dry-run       Run every gate and resolve the tag, but push no branches/tags
#
# What this script does:
#   1. Verifies the dev working branch with a clean, up-to-date working tree
#   2. Runs the CI lint gates (ruff + shellcheck)
#   3. Runs the unit + integration suites via pytest
#   4. Bumps the patch/minor/major version in lib/hyprconf/__init__.py, commits
#      it and pushes the commit to origin/dev
#   5. Creates an annotated version tag from hyprconf.__version__
#   6. Promotes the working-branch HEAD to origin/stable and pushes the tag
#
# Nothing is packaged: users `git clone -b stable` and install.sh runs from
# that checkout, so the promoted branch IS the release.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# The overlay is developed on "dev" and released by promoting that HEAD to
# "stable" (the branch install.sh clones).
WORK_BRANCH="dev"
STABLE_BRANCH="stable"
# Single source of truth for the version.
VERSION_FILE_REL="lib/hyprconf/__init__.py"
VERSION_FILE="$REPO_ROOT/$VERSION_FILE_REL"

SKIP_TAG=false
SKIP_BUMP=false
SKIP_TESTS=false
DRY_RUN=false
BUMP_TYPE="patch"

for arg in "$@"; do
  case "$arg" in
    --patch)       BUMP_TYPE="patch"   ;;
    --minor)       BUMP_TYPE="minor"   ;;
    --major)       BUMP_TYPE="major"   ;;
    --skip-bump)   SKIP_BUMP=true      ;;
    --skip-tests)  SKIP_TESTS=true     ;;
    --skip-tag)    SKIP_TAG=true       ;;
    --dry-run)     DRY_RUN=true        ;;
    --help|-h)
      sed -n '3,/^REPO_ROOT/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \?//'
      exit 0
      ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

if [[ -t 1 ]]; then
  GR=$'\e[1;32m' AM=$'\e[1;33m' GL=$'\e[1;31m' DM=$'\e[2;37m' RS=$'\e[0m'
else
  GR='' AM='' GL='' DM='' RS=''
fi

step() { printf '\n%s  ▸ %s%s\n'      "$AM" "$1" "$RS"; }
ok()   { printf '%s  ✔ %s%s\n'        "$GR" "$1" "$RS"; }
info() { printf '%s  ─ %s%s\n'        "$DM" "$1" "$RS"; }
warn() { printf '%s  ! %s%s\n'        "$AM" "$1" "$RS"; }
die()  { printf '%s  ✘ FATAL: %s%s\n' "$GL" "$1" "$RS" >&2; exit 1; }

_read_version() {
  sed -nE 's/^__version__ = "([^"]+)"$/\1/p' "$VERSION_FILE_REL"
}

# _bump_version <patch|minor|major>: rewrite __version__ and print the new one.
_bump_version() {
  local M m p
  IFS=. read -r M m p < <(_read_version) \
    || die "Could not determine hyprconf version from $VERSION_FILE_REL"
  case "$1" in
    major) M=$((M + 1)); m=0; p=0 ;;
    minor) m=$((m + 1)); p=0 ;;
    *)     p=$((p + 1)) ;;
  esac
  sed -i -E "s/^(__version__ = )\"[^\"]+\"/\\1\"$M.$m.$p\"/" "$VERSION_FILE_REL"
  echo "$M.$m.$p"
}

_tag_points_at_head() {
  local tag="$1"
  [[ "$(git rev-list -n1 "$tag")" == "$(git rev-parse HEAD)" ]]
}

step "Pre-flight checks"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$current_branch" == "$WORK_BRANCH" ]] \
  || die "Must be on the ${WORK_BRANCH} branch (currently on '$current_branch')."

[[ -z "$(git status --porcelain)" ]] \
  || die "Uncommitted changes on ${WORK_BRANCH} — commit or stash first."

ok "On ${WORK_BRANCH}, working tree clean"

git fetch origin "$WORK_BRANCH" --quiet
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/${WORK_BRANCH}")" ]]; then
  die "Local ${WORK_BRANCH} is not in sync with origin/${WORK_BRANCH} — push, pull or rebase first."
fi
ok "Local ${WORK_BRANCH} is up-to-date with origin/${WORK_BRANCH}"

# NOTE: the version bump + tag happen AFTER the suite passes (further down) so a
# release tag is only ever cut from code that has gone green through both suites —
# not from a commit that the test run might still reject.

# Lint + shellcheck are the same gates CI enforces. Run them here (fast, seconds)
# so a release can never be cut with a red lint job — a formatting/shellcheck
# regression must never reach stable just because the test suite was green.
step "Lint gates (ruff + shellcheck)"
if [[ "$SKIP_TESTS" == true ]]; then
  warn "Skipping lint gates (--skip-tests) — ensure ruff + shellcheck passed before this call"
else
  make lint 2>&1       || die "Ruff lint/format check failed — fix before publishing (run: make fmt)."
  make shellcheck 2>&1 || die "ShellCheck failed — fix before publishing."
  ok "Lint + shellcheck clean"
fi

step "Running test suite"

info "Suites: unit / integration"
if [[ "$SKIP_TESTS" == true ]]; then
  warn "Skipping tests (--skip-tests) — ensure suite passed before this call"
else
  make test 2>&1 || die "Tests failed — fix before publishing."
  ok "Unit + integration suites passed"
fi

# Suite is green — now bump the version and cut the tag from the tested HEAD.
if [[ "$SKIP_BUMP" == false ]]; then
  # A previous publish that died after its bump commit (a failed stable or tag
  # push) leaves HEAD as an already-released version with a clean tree, so
  # every pre-flight above passes and a naive rerun would bump AGAIN —
  # stranding the first tag and leaving a version gap on stable.
  if [[ "$(git log -1 --pretty=%s)" == "release: [v$(_read_version)] bump version" ]]; then
    die "HEAD is already the v$(_read_version) release commit (a previous publish failed mid-way) — rerun with --skip-bump to resume the promotion."
  fi
  step "Bumping ${BUMP_TYPE} version (suite is green)"
  version="$(_bump_version "$BUMP_TYPE")"
  release_tag="v${version}"
  if [[ "$DRY_RUN" == true ]]; then
    warn "Dry-run — would commit version bump to ${release_tag}"
    git checkout -- "$VERSION_FILE"
  else
    git add "$VERSION_FILE"
    git commit -m "release: [${release_tag}] bump version"
    git push origin "$WORK_BRANCH"
    ok "Bumped to ${version}"
  fi
else
  version="$(_read_version)"
  release_tag="v${version}"
  warn "Skipping version bump (--skip-bump) — using existing ${release_tag}"
fi

[[ -n "$version" ]] || die "Resolved empty version from $VERSION_FILE."
info "Release tag: ${release_tag}"

if [[ "$SKIP_TAG" == false ]]; then
  if git rev-parse -q --verify "refs/tags/${release_tag}" >/dev/null; then
    if _tag_points_at_head "$release_tag"; then
      warn "Tag ${release_tag} already exists at HEAD — reusing"
    else
      die "Tag ${release_tag} already exists on a different commit. Bump __version__ before publishing."
    fi
  elif [[ "$DRY_RUN" == true ]]; then
    warn "Dry-run — would create annotated tag ${release_tag}"
  else
    step "Creating annotated tag ${release_tag}"
    prev_tag="$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || true)"
    if [[ -n "$prev_tag" ]]; then
      changelog="$(git log --pretty=format:'- %s' "${prev_tag}..HEAD")"
      tag_body="Commits since ${prev_tag}:
${changelog}"
    else
      tag_body="Initial release."
    fi
    git tag -a "$release_tag" -m "release: [${release_tag}] Promote ${WORK_BRANCH} to ${STABLE_BRANCH}

${tag_body}"
    ok "Created tag ${release_tag}"
  fi
else
  warn "Skipping release tag creation (--skip-tag)"
fi

if [[ "$DRY_RUN" == true ]]; then
  warn "Dry-run — skipping branch and tag pushes"
  ok "Done — validated ${WORK_BRANCH} → ${STABLE_BRANCH} promotion flow locally"
  exit 0
fi

release_sha="$(git rev-parse HEAD)"

step "Promoting ${WORK_BRANCH} to origin/${STABLE_BRANCH}"
git push --force-with-lease origin HEAD:"${STABLE_BRANCH}"
git branch -f "${STABLE_BRANCH}" HEAD
ok "origin/${STABLE_BRANCH} updated → ${release_sha:0:7}"

if [[ "$SKIP_TAG" == false ]]; then
  step "Pushing tag ${release_tag}"
  git push origin "refs/tags/${release_tag}"
  ok "Tag pushed → ${release_tag}"
fi

ok "Done — ${WORK_BRANCH} promoted to ${STABLE_BRANCH}"

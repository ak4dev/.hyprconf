#!/usr/bin/env bash
set -euo pipefail

# scripts/publish — the only thing that writes stable.
#
# From a clean `dev` that matches origin/dev: run the three CI gates, cut the
# annotated tag named by VERSION, and move dev, stable and the tag in ONE
# atomic push — so stable carries the exact sha the gates went green on.
#
# VERSION is bumped by hand, in the commit that earns it (SemVer). There is no
# bump commit here and no --skip/--dry-run flag: the only half-published state
# an atomic push can leave is none, so a run that dies is simply rerun.

die() { printf 'publish: %s\n' "$*" >&2; exit 1; }

(($# == 0)) || die "takes no arguments"
# Named here, before anything else runs, or an absent one reaches the caller as
# its gate's message: "ruff failed (run: make fmt)" is what a missing ruff printed.
for tool in ruff shellcheck pytest; do
    command -v "$tool" >/dev/null || die "$tool is not on PATH — the gates need it"
done

cd "$(dirname "${BASH_SOURCE[0]}")/.."
[[ "$(git rev-parse --abbrev-ref HEAD)" == dev ]] || die "not on dev"
[[ -z "$(git status --porcelain)" ]] || die "uncommitted changes — commit or stash first"
git fetch -q origin
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/dev)" ]] ||
    die "dev is not in sync with origin/dev — push, pull or rebase first"

make lint       || die "ruff failed (run: make fmt)"
make shellcheck || die "shellcheck failed"
make test       || die "tests failed"

tag="v$(<VERSION)"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    [[ "$(git rev-list -n1 "$tag")" == "$(git rev-parse HEAD)" ]] ||
        die "$tag already exists on another commit — bump VERSION"
else
    git tag -a "$tag" -m "release: $tag"
fi

# One push or none: --atomic makes the three refs move together, so a network
# failure leaves origin exactly as it was and the rerun is just a rerun. Never
# forced, since every user clone pulls stable --ff-only: a stable that moved
# elsewhere is a stop, not a rewind. The local `stable` branch is deliberately
# NOT moved: `git branch -f stable` exits 128 when stable is checked out in
# another worktree (git 2.55), and nothing reads it — origin/stable is what
# users clone.
git push --atomic origin HEAD:dev HEAD:stable "refs/tags/$tag"
printf 'publish: %s — dev, stable and the tag are at %s\n' "$tag" "$(git rev-parse --short HEAD)"

#!/usr/bin/env bash
set -euo pipefail

# scripts/publish — test → deploy → promote dev to stable
#
# Usage:
#   bash scripts/publish [options]
#
# Options:
#   --patch         Bump the patch version (default: 2.0.6 → 2.0.7)
#   --minor         Bump the minor version (2.0.6 → 2.1.0)
#   --major         Bump the major version (2.0.6 → 3.0.0)
#   --skip-bump     Skip automatic version bump (version must be pre-bumped manually)
#   --skip-tests    Skip the test suite (only for nested test-harness calls — tests
#                   must still pass before any real publish)
#   --skip-deploy   Skip the hyprconf deploy step
#   --skip-tag      Skip annotated release-tag creation
#   --dry-run       Build the release archive locally but do not push branches/tags
#
# What this script does:
#   1. Verifies dev branch with clean working tree
#   2. Bumps the patch/minor/major version in __init__.py and commits it
#   3. Starts the test VM if not already running, stops it when done
#   4. Runs all 5 test tiers (unit / integration / tui / vm / install)
#   5. Deploys to hyprconf.sh via: hyprconf deploy hyprconf.sh
#   6. Builds a filtered release archive from HEAD via git archive + export-ignore
#   7. Promotes dev HEAD to origin/stable
#   8. Creates / pushes an annotated version tag from hyprconf.__version__

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

VM_RUN_SCRIPT="$REPO_ROOT/tests/vm/run_vm.sh"
VM_PID_FILE="/tmp/hyprconf-vm.pid"

INSTALL_VM_RUN_SCRIPT="$REPO_ROOT/tests/install/run_install_vm.sh"
INSTALL_VM_PID_FILE="/tmp/hyprconf-install-vm.pid"
INSTALL_IMAGE="$REPO_ROOT/tests/vm/arch-hyprconf.qcow2"
INSTALL_META="$REPO_ROOT/tests/vm/arch-hyprconf.meta"

STABLE_BRANCH="stable"
VERSION_FILE="$REPO_ROOT/stow/hypr/.local/lib/hyprconf/__init__.py"
DIST_DIR="$REPO_ROOT/dist"

_vm_is_running() {
  [[ -f "$VM_PID_FILE" ]] && kill -0 "$(cat "$VM_PID_FILE")" 2>/dev/null
}

_install_vm_is_running() {
  [[ -f "$INSTALL_VM_PID_FILE" ]] && kill -0 "$(cat "$INSTALL_VM_PID_FILE")" 2>/dev/null
}

SKIP_DEPLOY=false
SKIP_TAG=false
SKIP_BUMP=false
SKIP_TESTS=false
DRY_RUN=false
BUMP_TYPE="patch"

for arg in "$@"; do
  case "$arg" in
    --patch)       BUMP_TYPE="patch"   ;;
    --minor)       BUMP_TYPE="minor"   ;;
    --major)       BUMP_TYPE="major"   ;;
    --skip-bump)   SKIP_BUMP=true      ;;
    --skip-tests)  SKIP_TESTS=true     ;;
    --skip-deploy) SKIP_DEPLOY=true    ;;
    --skip-tag)    SKIP_TAG=true       ;;
    --dry-run)     DRY_RUN=true        ;;
    --help|-h)
      sed -n '3,/^REPO_ROOT/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \?//'
      exit 0
      ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

if [[ -t 1 ]]; then
  GR=$'\e[1;32m' AM=$'\e[1;33m' GL=$'\e[1;31m' WH=$'\e[1;37m' DM=$'\e[2;37m' RS=$'\e[0m'
else
  GR='' AM='' GL='' WH='' DM='' RS=''
fi

step() { printf '\n%s  ▸ %s%s\n'      "$AM" "$1" "$RS"; }
ok()   { printf '%s  ✔ %s%s\n'        "$GR" "$1" "$RS"; }
info() { printf '%s  ─ %s%s\n'        "$DM" "$1" "$RS"; }
warn() { printf '%s  ! %s%s\n'        "$AM" "$1" "$RS"; }
die()  { printf '%s  ✘ FATAL: %s%s\n' "$GL" "$1" "$RS" >&2; exit 1; }

VM_STARTED_BY_US=false
INSTALL_VM_STARTED_BY_US=false

_on_exit() {
  if [[ "$INSTALL_VM_STARTED_BY_US" == true ]]; then
    printf '\n%s  ▸ Stopping install test VM%s\n' "$AM" "$RS"
    bash "$INSTALL_VM_RUN_SCRIPT" --stop 2>&1 || true
    ok "Install VM stopped"
  fi

  if [[ "$VM_STARTED_BY_US" == true ]]; then
    printf '\n%s  ▸ Stopping test VM%s\n' "$AM" "$RS"
    bash "$VM_RUN_SCRIPT" --stop 2>&1 || true
    ok "VM stopped"
  fi
}
trap _on_exit EXIT

_read_version() {
  python3 - <<'PY'
from pathlib import Path
import re

text = Path("stow/hypr/.local/lib/hyprconf/__init__.py").read_text(encoding="utf-8")
match = re.search(r'__version__\s*=\s*"([^"]+)"', text)
if not match:
    raise SystemExit("Could not determine hyprconf version from __init__.py")
print(match.group(1))
PY
}

_bump_version() {
  python3 - "$1" <<'PY'
import sys, re
from pathlib import Path

bump = sys.argv[1]
path = Path("stow/hypr/.local/lib/hyprconf/__init__.py")
text = path.read_text(encoding="utf-8")
m = re.search(r'__version__\s*=\s*"(\d+)\.(\d+)\.(\d+)"', text)
if not m:
    raise SystemExit("Could not parse semver from __init__.py")
major, minor, patch = int(m.group(1)), int(m.group(2)), int(m.group(3))
if bump == "major":
    major += 1; minor = 0; patch = 0
elif bump == "minor":
    minor += 1; patch = 0
else:
    patch += 1
new_version = f"{major}.{minor}.{patch}"
new_text = re.sub(r'(__version__\s*=\s*)"[^"]+"', f'\\1"{new_version}"', text)
path.write_text(new_text, encoding="utf-8")
print(new_version)
PY
}

_build_release_archive() {
  local release_tag="$1"
  local archive_path="$DIST_DIR/hyprconf-${release_tag}.tar.gz"

  mkdir -p "$DIST_DIR"
  git archive --worktree-attributes --format=tar.gz \
    --prefix=".hyprconf/" HEAD > "$archive_path"
  printf '%s\n' "$archive_path"
}

_tag_points_at_head() {
  local tag="$1"
  [[ "$(git rev-list -n1 "$tag")" == "$(git rev-parse HEAD)" ]]
}

step "Pre-flight checks"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$current_branch" == "dev" ]] || die "Must be on dev branch (currently on '$current_branch')."

[[ -z "$(git status --porcelain)" ]] || die "Uncommitted changes on dev — commit or stash first."

ok "On dev, working tree clean"

if [[ "$SKIP_BUMP" == false ]]; then
  step "Bumping ${BUMP_TYPE} version"
  version="$(_bump_version "$BUMP_TYPE")"
  release_tag="v${version}"
  if [[ "$DRY_RUN" == true ]]; then
    warn "Dry-run — would commit version bump to ${release_tag}"
    git checkout -- "$VERSION_FILE"
  else
    git add "$VERSION_FILE"
    git commit -m "release: [${release_tag}] bump version"
    ok "Bumped to ${version}"
  fi
else
  version="$(_read_version)"
  release_tag="v${version}"
  warn "Skipping version bump (--skip-bump) — using existing ${release_tag}"
fi

[[ -n "$version" ]] || die "Resolved empty version from $VERSION_FILE."

info "Release tag: ${release_tag}"

step "Running test suite"

info "Tiers 1-3: unit / integration / tui"
if [[ "$SKIP_TESTS" == true ]]; then
  warn "Skipping tests (--skip-tests) — ensure suite passed before this call"
else
  make test 2>&1 || die "Tiers 1-3 failed — fix before publishing."
  ok "Tiers 1-3 passed"
fi

step "Checking VM image"
_build_image=false
if [[ -f "$INSTALL_IMAGE" ]]; then
  _built_at="unknown"
  _built_commit="unknown"
  if [[ -f "$INSTALL_META" ]]; then
    _built_at="$(grep '^built_at=' "$INSTALL_META" | cut -d= -f2- || echo unknown)"
    _built_commit="$(grep '^git_commit=' "$INSTALL_META" | cut -d= -f2- || echo unknown)"
  fi
  printf '%s  ─ Image found%s\n'            "$DM" "$RS"
  printf '%s  ─   Built:  %s%s\n'           "$DM" "$_built_at" "$RS"
  printf '%s  ─   Commit: %s%s\n\n'         "$DM" "$_built_commit" "$RS"
  printf '  1) Use existing image  (skip install.sh rebuild — faster)\n'
  printf '  2) Rebuild from scratch (tests install.sh end-to-end — ~20 min)\n\n'
  read -rp "  Choice [1/2, default 1]: " _img_choice
  case "${_img_choice:-1}" in
    2) _build_image=true ;;
    *) ok "Reusing existing image" ;;
  esac
else
  warn "No VM image found — must build before running tiers 4 and 5 (~20 min)"
  _build_image=true
fi

if [[ "$_build_image" == true ]]; then
  step "Building VM image (Packer runs install.sh end-to-end)"
  if _vm_is_running; then
    info "Stopping stale VM before rebuild..."
    bash "$VM_RUN_SCRIPT" --stop 2>/dev/null || true
  fi
  bash "$REPO_ROOT/tests/install/build_image.sh" 2>&1 \
    || die "VM image build failed — fix before publishing."
  ok "VM image built"
fi

if _vm_is_running && [[ "$_build_image" == false ]]; then
  info "VM already running — reusing"
else
  info "Starting test VM (port 2222)..."
  bash "$VM_RUN_SCRIPT" 2>&1 || die "VM failed to start."
  VM_STARTED_BY_US=true
fi

info "Tier 4: VM integration tests"
make test-vm 2>&1 || die "Tier 4 (VM) failed — fix before publishing."
ok "Tier 4 passed"

if _install_vm_is_running; then
  info "Install VM already running — reusing"
else
  info "Starting install test VM (port 2223)..."
  if ! bash "$INSTALL_VM_RUN_SCRIPT" 2>&1; then
    printf '\n%s  ✘ Install VM failed to start.%s\n\n' "$GL" "$RS"
    printf '  1) Clean up stale overlays and retry\n'
    printf '  2) Skip tier 5 (not recommended before publishing)\n'
    printf '  3) Abort\n\n'
    read -rp "  Choice [1/2/3, default 3]: " _recovery
    case "${_recovery:-3}" in
      1)
        warn "Cleaning up and retrying..."
        bash "$INSTALL_VM_RUN_SCRIPT" --stop 2>/dev/null || true
        bash "$VM_RUN_SCRIPT" --stop 2>/dev/null || true
        VM_STARTED_BY_US=false
        info "Restarting tier-4 VM..."
        bash "$VM_RUN_SCRIPT" 2>&1 || die "Tier-4 VM failed to restart."
        VM_STARTED_BY_US=true
        info "Restarting install VM..."
        bash "$INSTALL_VM_RUN_SCRIPT" 2>&1 || die "Install VM failed after cleanup — aborting."
        INSTALL_VM_STARTED_BY_US=true
        ;;
      2)
        warn "Skipping tier 5 — publish will proceed without install validation"
        ;;
      *)
        die "Aborted by user."
        ;;
    esac
  else
    INSTALL_VM_STARTED_BY_US=true
  fi
fi

info "Tier 5: install validation"
make test-install 2>&1 || die "Tier 5 (install) failed — fix before publishing."
ok "Tier 5 passed"

ok "All tests passed"

if [[ "$SKIP_DEPLOY" == false ]]; then
  step "Deploying hyprconf.sh"
  hyprconf deploy hyprconf.sh || die "Deploy step failed."
  ok "Deployed successfully"
else
  warn "Skipping deploy (--skip-deploy)"
fi

step "Building release archive"
archive_path="$(_build_release_archive "$release_tag")"
archive_size="$(du -sh "$archive_path" | cut -f1)"
ok "Release archive ready → ${archive_path#$REPO_ROOT/} (${archive_size})"

if [[ "$SKIP_TAG" == false ]]; then
  if git rev-parse -q --verify "refs/tags/${release_tag}" >/dev/null; then
    if _tag_points_at_head "$release_tag"; then
      warn "Tag ${release_tag} already exists at HEAD — reusing"
    else
      die "Tag ${release_tag} already exists on a different commit. Bump __version__ before publishing."
    fi
  elif [[ "$DRY_RUN" == true ]]; then
    warn "Dry-run — would create annotated tag ${release_tag}"
  else
    step "Creating annotated tag ${release_tag}"
    prev_tag="$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || true)"
    if [[ -n "$prev_tag" ]]; then
      changelog="$(git log --pretty=format:'- %s' "${prev_tag}..HEAD")"
      tag_body="Commits since ${prev_tag}:
${changelog}"
    else
      tag_body="Initial release."
    fi
    git tag -a "$release_tag" -m "release: [${release_tag}] Promote dev to stable

${tag_body}"
    ok "Created tag ${release_tag}"
  fi
else
  warn "Skipping release tag creation (--skip-tag)"
fi

if [[ "$DRY_RUN" == true ]]; then
  warn "Dry-run — skipping branch and tag pushes"
  ok "Done — validated dev → stable promotion flow locally"
  exit 0
fi

dev_sha="$(git rev-parse HEAD)"

step "Promoting dev to origin/${STABLE_BRANCH}"
git push origin HEAD:"${STABLE_BRANCH}"
git branch -f "${STABLE_BRANCH}" HEAD
ok "origin/${STABLE_BRANCH} updated → ${dev_sha:0:7}"

if [[ "$SKIP_TAG" == false ]]; then
  step "Pushing tag ${release_tag}"
  git push origin "refs/tags/${release_tag}"
  ok "Tag pushed → ${release_tag}"
fi

ok "Done — dev promoted to stable, archive built"

#!/usr/bin/env bash
# hyprconf/boot-text — the scrolling boot log in place of Omarchy's splash: one Limine drop-in, then a rebuild.
# No Omarchy command shows the log (`omarchy commands --json`, 4.0.6-1: the plymouth group picks themed screens only).
# The drop-in is the shape of install/hardware/asus/fix-asus-ptl-display-backlight.sh; the rebuild, migrations/1791581004.sh's.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

: "${_HYPRCONF_LIMINE_CONF_D:=/etc/limine-entry-tool.d}"
src=$dir/00-hyprconf-boot-text.conf
dst=$_HYPRCONF_LIMINE_CONF_D/00-hyprconf-boot-text.conf

can_sudo() {
    local why
    if [[ -n ${HYPRCONF_NO_SUDO:-} ]]; then why="skipped (--no-packages)"
    elif [[ ! -t 0 && -z ${_HYPRCONF_ASSUME_TTY:-} ]]; then why="no terminal for sudo"
    else return 0
    fi
    echo "  $why — run \`bash $dir/install${1:+ $1}\` from a terminal for the boot log"
    return 1
}

# With UKIs the command line is inside the boot image, so it reaches the next boot only through a rebuild.
# limine-mkinitcpio exits 0 when a build fails (hyprconf-yubikey's header), so its output is read as well.
# A failed build leaves the previous images on the ESP, and they still boot.
rebuild() {
    local out
    if out=$(sudo -- limine-mkinitcpio 2>&1 | tee /dev/stderr) && ! grep -q -F "ERROR:" <<<"$out"; then
        echo "  boot images rebuilt — $1 from the next boot"
    else
        echo "  the boot images were not rebuilt: fix the error above, then \`sudo limine-mkinitcpio\`"
    fi
}

if [[ ${1:-} == undo ]]; then
    [[ -f $dst ]] || exit 0
    can_sudo undo || exit 0
    sudo rm -f -- "$dst" || { echo "  could not remove $dst"; exit 0; }
    echo "  removed $dst"
    rebuild "Omarchy's splash"
    exit 0
fi

cmp -s "$src" "$dst" && exit 0
omarchy-cmd-present limine-mkinitcpio || { echo "  no limine-mkinitcpio: this box does not boot through Limine — skipping"; exit 0; }
can_sudo || exit 0
sudo install -Dm644 -- "$src" "$dst" || { echo "  could not install $dst — skipping"; exit 0; }
echo "  $dst installed — undo: bash $dir/install undo"
rebuild "the boot log"

#!/usr/bin/env bash
# hyprconf/vulkan-gpu — the dual-GPU Vulkan pin tool, on PATH.
# Seam: ~/.local/bin, on the session PATH (default/bash/env-bootstrap:37-40, Omarchy 4.0.3-1).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
tool=hyprconf-vulkan-gpu
src=$dir/bin/$tool
dst=$HOME/.local/bin/$tool

if [[ ${1:-} == undo ]]; then
    if [[ $(readlink "$dst" 2>/dev/null) == "$src" ]]; then
        rm -f "$dst"
        echo "  $dst removed — a pin in ~/.config/uwsm/env.d is still yours: $tool remove"
    fi
    exit 0
fi

mkdir -p "${dst%/*}"
# Guarded because `ln -sfn` re-creates the link, a new inode, on every run; -f
# replaces a hyprconf 7.x rendered copy, -n keeps a link to a directory from
# being followed.
if [[ $(readlink "$dst" 2>/dev/null) != "$src" ]]; then
    ln -sfn "$src" "$dst"
    echo "  $tool on PATH — on a dual-GPU box: $tool status, then $tool fix"
fi

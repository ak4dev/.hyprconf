#!/usr/bin/env bash
# hyprconf-gaps — step Hyprland's window gaps up or down from a hotkey (which
# keys, and the eval-not-keyword fact below: modules/hypr/README.md).
#
#   hyprconf-gaps +    increase general:gaps_in and gaps_out by STEP
#   hyprconf-gaps -    decrease both by STEP (floors at 0)
#
# Both move together so their difference is preserved. Runtime only — a
# `hyprctl reload` puts the configured values back; Omarchy's own `omarchy
# hyprland window gaps toggle` is the all-or-nothing switch and is untouched.
# It says nothing: the gap change is its own feedback, and its failures (a gap
# it cannot read, an eval Hyprland refuses) are stderr + exit 1, invisible from
# the hotkey and accepted — never a step from a guessed 0.
set -euo pipefail

readonly STEP=2

direction=${1:-}
[[ $direction == [+-] ]] || { printf 'Usage: %s <+|->\n' "${0##*/}" >&2; exit 1; }

_get_gap() {
    # gaps_in / gaps_out are a four-sided value, and Hyprland 0.56.2 reports it
    # in "css" ("3 3 3 3") — verified live with `hyprctl getoption
    # general:gaps_in -j`, which carries no other populated field for these two
    # options; a plain "int" is taken where there is no css. jq is how Omarchy
    # itself reads `hyprctl getoption -j` (bin/omarchy-capture-screenshot:42), so
    # it is always installed; anything else — no compositor, a reshaped answer —
    # stops the run rather than stepping from 0.
    hyprctl getoption "$1" -j 2>/dev/null |
        jq -er '(.css // empty | split(" ")[0] | tonumber) // .int | numbers' 2>/dev/null ||
        { printf 'hyprconf-gaps: cannot read %s from hyprctl getoption\n' "$1" >&2; exit 1; }
}

gaps_in=$(_get_gap general:gaps_in)
gaps_out=$(_get_gap general:gaps_out)

step=$direction$STEP  # "+2" / "-2": arithmetic evaluates a variable's value
new_in=$((gaps_in + step)) new_out=$((gaps_out + step))
new_in=$((new_in < 0 ? 0 : new_in)) new_out=$((new_out < 0 ? 0 : new_out))

# eval, never keyword: keyword is a silent no-op under the Lua parser (exits 0), eval reports (exit 7).
if ! out="$(hyprctl eval "hl.config({ general = { gaps_in = $new_in, gaps_out = $new_out } })" 2>&1)" ||
    [[ "$out" != ok ]]; then
    printf 'hyprconf-gaps: %s\n' "$out" >&2
    exit 1
fi

#!/usr/bin/env bash
# hyprconf/hypr — Hyprland deltas: hotkeys, look'n'feel, input, the monitor presets and the two tools they run.
# Seams: ~/.config/hypr/{bindings,input,looknfeel}.lua, require'd after Omarchy's own (config/hypr/hyprland.lua:20-22); presets read from ~/.local/state/omarchy/toggles/hypr (default/hypr/toggles.lua:4,11); OMARCHY_PATH and the ~/.local/bin on the session PATH (default/bash/env-bootstrap:12,16,37-40).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
: "${OMARCHY_PATH:=/usr/share/omarchy}"; export OMARCHY_PATH  # undo's omarchy-refresh-config reads it from the environment (bin/omarchy-refresh-config:21).
hypr=$HOME/.config/hypr
bin=$HOME/.local/bin
state=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}
overrides=(bindings input looknfeel)
tools=(hyprconf-gaps hyprconf-monitor-preset)
# Ours, whichever release wrote it: every override opens "-- hyprconf " (test_hypr.py pins it). Without this a changed
# override met its own previous copy, kept it as .stock, and undo put hyprconf's old file back instead of Omarchy's.
ours() { local l; [[ -f $1 ]] && read -r l <"$1" && [[ $l == "-- hyprconf "* ]]; }
keep() {
    [[ -e $1.stock || -L $1.stock ]] && return
    cp -P -- "$1" "$1.stock"
    echo "  backed up ${1##*/} -> ${1##*/}.stock"
}
if [[ ${1:-} == undo ]]; then
    # The copy goes first, so omarchy-refresh-config takes its no-backup branch (bin/omarchy-refresh-config:41-43) and leaves no .bak behind.
    "$dir/bin/hyprconf-monitor-preset" stock >/dev/null 2>&1 || true
    for f in "${overrides[@]}"; do
        dst=$hypr/$f.lua
        ours "$dst.stock" && rm -f "$dst.stock"  # our own copy, which 8.0–8.2 kept by mistake
        if [[ -e $dst.stock || -L $dst.stock ]]; then
            mv -f -- "$dst.stock" "$dst"
        elif ours "$dst"; then
            rm -f "$dst"
            omarchy-refresh-config "hypr/$f.lua" >/dev/null
        fi
    done
    for f in "$dir"/*Monitors*.lua; do rm -f "$hypr/${f##*/}" "$state/${f##*/}.shipped"; done
    for t in "${tools[@]}"; do rm -f "$bin/$t"; done
    hyprctl reload >/dev/null 2>&1 || true
    exit 0
fi
# A shipped .lua that does not parse takes the session's config down the moment it is copied, so the
# whole set is checked before the first write; without luac the copy proceeds. Omarchy has no such
# check (nothing in bin/ parses Lua), and `lua` is a hyprland dependency, so luac is there on a real box.
! command -v luac >/dev/null || luac -p "$dir"/*.lua
mkdir -p "$hypr" "$bin"
changed=0
for f in "${overrides[@]}"; do
    dst=$hypr/$f.lua
    if [[ -L $dst ]]; then
        # A link into the checkout is a hyprconf 7.x install's own, not the user's.
        [[ $(readlink "$dst") == "${dir%/modules/hypr}"/* ]] || keep "$dst"
        rm -f "$dst"
    elif [[ -e $dst ]]; then
        cmp -s "$dir/$f.lua" "$dst" && continue
        cmp -s "$OMARCHY_PATH/config/hypr/$f.lua" "$dst" || ours "$dst" || keep "$dst"
    fi
    # Copied, never linked: `omarchy refresh` cp -f's the stock template over whatever is at the path (bin/omarchy-refresh-config:31-33), through a link into the checkout.
    install -m 644 "$dir/$f.lua" "$dst"
    changed=1
done
# A seeded preset is the machine's and is never overwritten (README › Settings); $state/<name>.shipped holds the
# bytes last shipped, so an edit of your own stays quiet and only a change made *here* speaks, once per shipped version.
for f in "$dir"/*Monitors*.lua; do
    [[ -f $f ]] || continue
    n=${f##*/} dst=$hypr/$n shipped=$state/$n.shipped
    if [[ ! -e $dst ]]; then
        install -m 644 "$f" "$dst"
    elif ! cmp -s "$f" "$dst" && ! cmp -s "$f" "$shipped"; then
        echo "  $n here has changed since yours was seeded — yours stands: diff it against $f, or delete it to re-seed"
    fi
    cmp -s "$f" "$shipped" || { mkdir -p "$state"; cp -- "$f" "$shipped"; }
done
# ln -sfn recreates an already-correct link with a fresh inode: the readlink test is what keeps a re-run write-free.
for t in "${tools[@]}"; do
    [[ "$(readlink "$bin/$t" 2>/dev/null)" == "$dir/bin/$t" ]] || ln -sfn "$dir/bin/$t" "$bin/$t"
done
if ((changed)); then hyprctl reload >/dev/null 2>&1 || true; fi

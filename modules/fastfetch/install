#!/usr/bin/env bash
# hyprconf/fastfetch — the shell greeting's layout, for `fastfetch -c` in modules/shell-zsh.
# No seam of fastfetch's own: ~/.config/fastfetch/config.jsonc is Omarchy's About screen (bin/omarchy-launch-about:161, custom_fastfetch_config :16-18), so the copy goes to ~/.config/hyprconf.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
target=$HOME/.config/hyprconf/fastfetch.jsonc
legacy=$HOME/.config/fastfetch/config.jsonc

# Releases <= 7.x linked the layout into that slot. The link text is compared raw, never resolved: the checkout it names may be gone, and a dangling link there is still ours to clear.
if [[ $(readlink "$legacy" 2>/dev/null || true) == "${dir%/modules/fastfetch}/fastfetch/config.jsonc" ]]; then
    rm -f "$legacy"
    if [[ -e $legacy.stock || -L $legacy.stock ]]; then
        mv "$legacy.stock" "$legacy"
        echo "  restored your own $legacy"
    else
        echo "  unlinked $legacy — Omarchy's About screen is stock again"
    fi
fi

if [[ ${1:-} == undo ]]; then
    rm -f "$target"
    rmdir "$HOME/.config/hyprconf" 2>/dev/null || true   # ours only while it is empty
    exit 0
fi

mkdir -p "${target%/*}"
cmp -s "$dir/config.jsonc" "$target" && exit 0
install -m 644 "$dir/config.jsonc" "$target"
echo "  greeting layout -> $target — undo: bash $dir/install undo"

#!/usr/bin/env bash
# hyprconf/font — GeistMono Nerd Font as the system monospace, set once.
# Seam: omarchy-font-set (bin/omarchy-font-set:24-27,33-42,57-74), omarchy-pkg-add/-present.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
: "${OMARCHY_PATH:=/usr/share/omarchy}"
family='GeistMono Nerd Font'
stock='JetBrainsMono Nerd Font'   # Omarchy's own monospace: default/fontconfig/conf.avail/50-omarchy.conf:22-29
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/font-applied

if [[ ${1:-} == undo ]]; then
  rm -f "$marker"
  echo "  put Omarchy's font back with: omarchy font set '$stock'"
  exit 0
fi

mapfile -t pkgs < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$dir/packages")
if ! omarchy-pkg-present "${pkgs[@]}"; then
  if [[ -n ${HYPRCONF_NO_SUDO:-} || ( ! -t 0 && -z ${_HYPRCONF_ASSUME_TTY:-} ) ]]; then
    echo "  ${pkgs[*]} not installed — run \`bash $dir/install\` from a terminal"
    exit 0
  fi
  omarchy-pkg-add "${pkgs[@]}"
fi

[[ -e $marker ]] && exit 0
# With kitty present and no user file, bin/omarchy-font-set:33-40 creates one
# holding font_family alone — no theme include, so kitty loses Omarchy's theming.
kitty_conf=$HOME/.config/kitty/kitty.conf
if [[ ! -e $kitty_conf && -f $OMARCHY_PATH/config/kitty/kitty.conf ]] && omarchy-cmd-present kitty; then
  install -Dm644 "$OMARCHY_PATH/config/kitty/kitty.conf" "$kitty_conf"
fi
if ! omarchy-font-set "$family"; then
  echo "  omarchy-font-set rejected $family — the system font stays as it is, retried next run" >&2
  exit 0
fi
mkdir -p "${marker%/*}"
: > "$marker"
echo "  system monospace is $family — change it any time: omarchy font set <name>"

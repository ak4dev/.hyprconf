#!/usr/bin/env bash
# hyprconf/idle — the screensaver starts after 15 minutes instead of Omarchy's 150 s, once.
# Seam: bin/omarchy-shell-config, sourced; omarchy commands --json has no writer for the key (bin/omarchy-toggle-idle:8-9 is a stay-awake flag).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
: "${OMARCHY_PATH:=/usr/share/omarchy}"   # the helper's DEFAULTS_FILE (env-bootstrap:12,16)
seconds=900
json=$HOME/.config/omarchy/shell.json
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/idle-applied

edit() {
  local helper
  helper=$(command -v omarchy-shell-config) || return 1
  # shellcheck source=/dev/null
  ( source "$helper" && commit "$1" )   # subshell: the helper traps EXIT (:51) and fail() exits 1
}

if [[ ${1:-} == undo ]]; then
  # Dropping the key restores the stock 150 s: a user shell.json replaces the defaults whole
  # (shell/shell.qml:73-88), then plugins/services/idle/Service.qml:17,21 applies 150. Guarded,
  # or commit()'s defaults fallback (omarchy-shell-config:20-26) writes a file the user never had.
  if [[ -s $json ]] && jq -e '.idle.screensaver != null' "$json" >/dev/null 2>&1; then
    edit 'del(.idle.screensaver)' ||
      echo "  could not restore idle.screensaver — remove it from $json by hand"
  fi
  rm -f "$marker"
  exit 0
fi

[[ -e $marker ]] && exit 0
if edit ".idle = ((.idle // {}) + { screensaver: $seconds })"; then
  mkdir -p "${marker%/*}"; : > "$marker"
  echo "  idle.screensaver = ${seconds}s — undo: bash $dir/install undo"
else
  echo "  could not set idle.screensaver — will retry on the next run"
fi
exit 0

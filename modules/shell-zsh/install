#!/usr/bin/env bash
# hyprconf/shell-zsh — zsh + powerlevel10k in the terminal; the login shell stays bash (README.md).
# Seams: ~/.zshrc's one source line (/etc/skel/.bashrc:2), kitty's include (config/kitty/kitty.conf:1-2), $OMARCHY_PATH (default/bash/env-bootstrap:12-16).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
: "${OMARCHY_PATH:=/usr/share/omarchy}"
: "${HYPRCONF_STATE:=$HOME/.local/state/hyprconf}"
: "${_HYPRCONF_ASSUME_TTY:=}"
p10k_url=https://github.com/romkatv/powerlevel10k.git
# Pinned, never pulled: this code runs in every interactive zsh (AGENTS rule 8). Verified 2026-09-01:
p10k_pin=3308262dfbd743b6e1d3956a2b5572f7a049d692
p10k=$HOME/.local/share/powerlevel10k
# Written only by the clone below, so undo deletes a checkout this module made and never an adopted one.
p10k_marker=$HYPRCONF_STATE/p10k-cloned
p10krc=$HOME/.p10k.zsh
zshrc=$HOME/.zshrc
kitty=$HOME/.config/kitty
changed=0
line="[ -r \"$dir/zshrc\" ] && source \"$dir/zshrc\""
mark='/modules/shell-zsh/zshrc"'

# rewrite_zshrc keep|drop; the <= 7.x block is cut only with both markers in order — with one gone, a begin-to-EOF cut eats the rest.
rewrite_zshrc() {
    local mode="$1" keep tmp b e
    if [[ ! -f $zshrc ]]; then
        [[ $mode == keep ]] || return 0
        : > "$zshrc"
    fi
    b=$(grep -nxF -e '# >>> hyprconf >>>' "$zshrc" | head -1 | cut -d: -f1 || true)
    e=$(grep -nxF -e '# <<< hyprconf <<<' "$zshrc" | head -1 | cut -d: -f1 || true)
    if [[ -z $b || -z $e || $b -ge $e ]]; then b=0; e=0; fi
    keep=$(mktemp)
    tmp=$(mktemp)
    # The kept line reaches awk as a FILE: -v is escape-processed, so a backslash in $dir would stop the line in place from matching.
    if [[ $mode == keep ]]; then printf '%s\n' "$line" > "$keep"; fi
    awk -v b="$b" -v e="$e" -v mark="$mark" '
        FILENAME == ARGV[1] { want = $0; next }
        b && FNR >= b && FNR <= e { next }
        $0 != want && index($0, mark) { next }
        want != "" && $0 == want { if (seen) next; seen = 1 }
        { print }
    ' "$keep" "$zshrc" > "$tmp"
    if [[ $mode == keep ]] && ! grep -qxF -- "$line" "$tmp"; then
        printf '%s\n' "$line" >> "$tmp"
    fi
    if ! cmp -s "$tmp" "$zshrc"; then
        # Over the file, never through a rename: a ~/.zshrc that is a dotfiles symlink keeps its link.
        cat "$tmp" > "$zshrc"
        changed=1
    fi
    rm -f "$tmp" "$keep"
}

# Timeout-bounded and never fatal: a dead network must not stall the omarchy-update this runs under.
clone_p10k() {
    if [[ ! -d $p10k ]]; then
        if timeout 300 git clone -q --depth=1 --revision="$p10k_pin" -- "$p10k_url" "$p10k"; then
            mkdir -p "$HYPRCONF_STATE"
            : > "$p10k_marker"
            changed=1
        else
            rm -rf "$p10k"
            echo "  could not clone powerlevel10k — the prompt stays stock; retried on the next run"
        fi
        return 0
    fi
    # omarchy-plugin-update:111's test: `git rev-parse` on a plain directory answers for the repository enclosing it.
    if [[ ! -d $p10k/.git ]]; then
        echo "  $p10k is not a git checkout — left as it is (move it aside to let the pin re-clone)"
        return 0
    fi
    if [[ $(git -C "$p10k" rev-parse HEAD 2>/dev/null || true) == "$p10k_pin" ]]; then
        return 0
    fi
    if timeout 300 git -C "$p10k" fetch -q --depth=1 -- "$p10k_url" "$p10k_pin" &&
        timeout 300 git -C "$p10k" checkout -q --detach FETCH_HEAD; then
        changed=1
    else
        echo "  could not move powerlevel10k to its pin — the checkout in place stays in use"
    fi
}
if [[ ${1:-} == undo ]]; then
    rewrite_zshrc drop
    # Stock Omarchy ships no ~/.zshrc (/etc/skel has .bashrc, .bash_profile, .bash_logout), so one left empty goes too.
    if [[ -f $zshrc && ! -L $zshrc && ! -s $zshrc ]]; then rm -f "$zshrc"; fi
    # --follow-symlinks and in place, the way Omarchy edits this file (migrations/1788745941.sh:19).
    if [[ -f $kitty/kitty.conf ]]; then
        sed --follow-symlinks -i -e '/^include hyprconf-zsh\.conf$/d' "$kitty/kitty.conf"
    fi
    rm -f "$kitty/hyprconf-zsh.conf"
    if [[ $(readlink "$p10krc" 2>/dev/null || true) == "$dir/.p10k.zsh" ]]; then
        rm -f "$p10krc"
        if [[ -e $p10krc.stock || -L $p10krc.stock ]]; then mv -- "$p10krc.stock" "$p10krc"; fi
    fi
    if [[ -f $p10k_marker && -d $p10k/.git ]]; then rm -rf "$p10k"; fi
    rm -f "$p10k_marker"
    rmdir "$HYPRCONF_STATE" "$HOME/.local/state" "$HOME/.local/share" "$HOME/.local" \
        2>/dev/null || true
    exit 0
fi
# Asked first — omarchy-pkg-add (/usr/bin/omarchy-pkg-add:8-14) is pacman -S --needed, but asking costs a sudo prompt.
mapfile -t pkgs < <(sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$dir/packages")
if ! omarchy-pkg-present "${pkgs[@]}"; then
    if [[ -n ${HYPRCONF_NO_SUDO:-} ]]; then
        echo "  packages left to a run without --no-packages: ${pkgs[*]}"
    elif [[ ! -t 0 && -z $_HYPRCONF_ASSUME_TTY ]]; then
        echo "  no terminal for sudo — from one: omarchy pkg add ${pkgs[*]}"
    else
        omarchy-pkg-add "${pkgs[@]}" || {
            echo "  omarchy-pkg-add failed — see pacman's error above; re-run to retry" >&2
            exit 1
        }
    fi
fi
# kitty pointed at a shell that is not there would not start at all.
if ! omarchy-pkg-present zsh; then
    echo "  zsh is not installed — nothing to configure (run from a terminal, without --no-packages)"
    exit 0
fi
clone_p10k
# A .p10k.zsh of theirs is kept once as .stock; a link into the checkout is <= 7.x's own — a .stock of it would dangle.
root=${dir%/modules/shell-zsh}
target=$(readlink "$p10krc" 2>/dev/null || true)
if [[ (-e $p10krc || -L $p10krc) && $target != "$dir/.p10k.zsh" && $target != "$root"/* ]] &&
    [[ ! -e $p10krc.stock && ! -L $p10krc.stock ]]; then
    cp -P "$p10krc" "$p10krc.stock"
    echo "  backed up .p10k.zsh -> .p10k.zsh.stock"
fi
if [[ $target != "$dir/.p10k.zsh" ]]; then
    ln -sfn "$dir/.p10k.zsh" "$p10krc"
    changed=1
fi
rewrite_zshrc keep
if [[ -f $kitty/kitty.conf ]] || omarchy-cmd-present kitty; then
    mkdir -p "$kitty"
    if ! cmp -s "$dir/hyprconf-zsh.conf" "$kitty/hyprconf-zsh.conf"; then
        install -m 644 "$dir/hyprconf-zsh.conf" "$kitty/hyprconf-zsh.conf"
        changed=1
    fi
    # The theme include lives only in Omarchy's stub (config/kitty/kitty.conf:1-2); seeded as omarchy-install-terminal:39-42 seeds it.
    if [[ ! -e $kitty/kitty.conf && -f $OMARCHY_PATH/config/kitty/kitty.conf ]]; then
        install -m 644 "$OMARCHY_PATH/config/kitty/kitty.conf" "$kitty/kitty.conf"
        changed=1
    fi
    if ! grep -qxF 'include hyprconf-zsh.conf' "$kitty/kitty.conf" 2>/dev/null; then
        # A file not ending in a newline gets one here, and undo cannot tell it from the user's own; Omarchy's stub ends in one.
        if [[ -s $kitty/kitty.conf && -n $(tail -c1 "$kitty/kitty.conf") ]]; then
            printf '\n' >> "$kitty/kitty.conf"
        fi
        printf 'include hyprconf-zsh.conf\n' >> "$kitty/kitty.conf"
        changed=1
    fi
else
    echo "  kitty is not installed — zsh becomes its shell as soon as it is"
fi
if (( changed )); then
    echo "  zsh + powerlevel10k in kitty — undo: bash $dir/install undo"
fi
exit 0

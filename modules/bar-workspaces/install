#!/usr/bin/env bash
# hyprconf/bar-workspaces — the overlay's own workspaces widget on the bar.
# Seam: ~/.config/omarchy/plugins/<id>, a folder the third-party scan follows through a
# symlink (shell/services/PluginRegistry.qml:712-713); omarchy-plugin-enable; rescanPlugins.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.workspaces
plugins=$HOME/.config/omarchy/plugins link=$plugins/$id
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/workspaces-applied

# -q returns success when no shell answers (bin/omarchy-shell:7-11,14-17); `|| true` covers
# the command missing. inotifywait never descends a link (PluginRegistry.qml:663-674), so
# this explicit rescan is what picks a `git pull` up.
rescan() { omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true; }

if [[ ${1:-} == undo ]]; then
  # Disabled while still installed: the clonedFrom entry hands the slot back to the stock
  # widget (PluginRegistry.qml:555 -> restoreCloneSource:441).
  omarchy-plugin-disable "$id" >/dev/null 2>&1 || true
  # Only this module's link: a real directory here is someone else's, and `rm -f` on one
  # fails, taking the undo down with it.
  [[ -L $link ]] && rm -f "$link"
  rm -f "$marker"
  rescan
  exit 0
fi

if [[ -d $link/.git ]]; then
  echo "  $id is an \`omarchy plugin add\` checkout — left to omarchy plugin update"
  exit 0
fi
mkdir -p "$plugins" "${marker%/*}"
# Moved aside, never deleted (bin/omarchy-plugin-remove:106).
[[ -d $link && ! -L $link ]] && mv "$link" "$plugins/.$id.bak.$(date -u +%Y%m%d%H%M%S)"
[[ $(readlink "$link" 2>/dev/null) == "$dir/plugin" ]] || ln -sfn "$dir/plugin" "$link"
rescan

# Enabled once (rule 5) with no placement: the enable swaps the copy into the stock
# widget's slot whatever it is (PluginRegistry.qml:528-534) and a --section would splice it
# straight back out (:545-546). The wait is omarchy-plugin-add's own (bin/omarchy-plugin-
# add:163-171): the rescan is asynchronous, and an enable before it lands fails "plugin is
# not known" (bin/omarchy-plugin-enable:86-87).
[[ -e $marker ]] && exit 0
for (( i = 0; i < 40; i++ )); do   # no shell answering → omarchy-plugin-list exits 1 → no wait
  list=$(omarchy-plugin-list --json 2>/dev/null) || break
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$list" >/dev/null 2>&1 && break
  sleep 0.05
done
omarchy-plugin-enable "$id" >/dev/null 2>&1 || { echo "  no shell answering — enabled on the next run"; exit 0; }
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"

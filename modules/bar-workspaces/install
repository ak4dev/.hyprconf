#!/usr/bin/env bash
# hyprconf/bar-workspaces — the overlay's own workspaces widget on the bar.
# Seam: a clonedFrom copy the registry swaps into the stock widget's slot; the link, the rescan, the enable and the undo are ../bar-plugin.sh's.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.workspaces stock=omarchy.workspaces
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/workspaces-applied
source "$dir/../bar-plugin.sh"

if [[ ${1:-} == undo ]]; then
    plugin_disable "$stock"
    plugin_unlink
    exit 0
fi

plugin_link
[[ -e $marker ]] && exit 0   # enabled once (rule 5): a bar the user took it off stays that way
plugin_enable
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"

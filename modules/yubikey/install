#!/usr/bin/env bash
# hyprconf/yubikey — puts `hyprconf-yubikey` (FIDO2 unlock of the LUKS2 root at boot) on PATH.
# Seam: ~/.local/bin, on the session PATH (default/bash/env-bootstrap:38-39, envs:32-33; Omarchy 4.0.3-1).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
tool=hyprconf-yubikey
bin=$HOME/.local/bin

if [[ ${1:-} == undo ]]; then
    [[ -e $bin/$tool || -L $bin/$tool ]] || exit 0
    rm -f "$bin/$tool"
    echo "  $bin/$tool removed — if a key is enrolled, revert the boot config with: bash $dir/bin/$tool remove"
    exit 0
fi

mkdir -p "$bin"
# readlink first: ln -sfn would give an already-correct link a new inode.
[[ $(readlink "$bin/$tool" 2>/dev/null) == "$dir/bin/$tool" ]] ||
    ln -sfn "$dir/bin/$tool" "$bin/$tool"

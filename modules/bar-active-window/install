#!/usr/bin/env bash
# hyprconf/bar-active-window — the focused window's title on two lines, as a bar plugin.
# Seam: a clonedFrom copy the registry swaps into the stock widget's slot at enable time and carries back on disable (shell/services/PluginRegistry.qml:529-534,555), so the enable needs no placement of its own.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.active-window
plugins=$HOME/.config/omarchy/plugins link=$plugins/$id
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/active-window-applied

if [[ ${1:-} == undo ]]; then
  omarchy-plugin-disable "$id" >/dev/null 2>&1 || true   # restoreCloneSource puts stock back (PluginRegistry.qml:555)
  if [[ -L $link ]]; then rm -f "$link"
  elif [[ -d $link ]]; then echo "  $link is not this module's symlink — left alone"
  fi
  rm -f "$marker"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  exit 0
fi

if [[ -d $link/.git ]]; then
  echo "  $id is an \`omarchy plugin add\` checkout — left to omarchy plugin update"
  exit 0
fi
mkdir -p "$plugins" "${marker%/*}"
[[ -d $link && ! -L $link ]] && mv "$link" "$plugins/.$id.bak.$(date -u +%Y%m%d%H%M%S)"
[[ $(readlink "$link" 2>/dev/null) == "$dir/plugin" ]] || ln -sfn "$dir/plugin" "$link"   # the third-party scan follows a link (PluginRegistry.qml:710-714)
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true   # inotifywait -r never descends a link (:664-674)

[[ -e $marker ]] && exit 0
for (( i = 0; i < 40; i++ )); do   # omarchy-plugin-add:164-171; no shell answering → the list exits 1 → no wait
  list=$(omarchy-plugin-list --json 2>/dev/null) || break
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$list" >/dev/null && break
  sleep 0.05
done
omarchy-plugin-enable "$id" >/dev/null 2>&1 || { echo "  no shell answering — enabled on the next run"; exit 0; }
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"

#!/usr/bin/env bash
# hyprconf/bar-active-window — the focused window's title on two lines, as a bar plugin.
# Seam: a clonedFrom copy the registry swaps into the stock widget's slot; the link, the rescan, the enable and the undo are ../bar-plugin.sh's.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.active-window stock=omarchy.active-window
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/active-window-applied
source "$dir/../bar-plugin.sh"

if [[ ${1:-} == undo ]]; then
    # A non-empty marker says the enable ADDED a slot, so the slot goes too — but only
    # while our copy still holds it: disabling it hands the slot to the stock widget
    # (PluginRegistry.qml:555 -> :459-463), and taking that one off is a plain splice
    # (:556). A stock title the user has placed since is left alone — the disable moves
    # nothing without a bar location of ours (:449-450).
    if [[ -s $marker ]] && on_bar "$id"; then
        plugin_disable
        omarchy-plugin-disable "$stock" >/dev/null 2>&1 || true
    else
        plugin_disable "$stock"
    fi
    plugin_unlink
    exit 0
fi

plugin_link
[[ -e $marker ]] && exit 0   # enabled once (rule 5): a bar the user took it off stays that way
plugin_enable
# `.enabled` is on-the-bar for a widget (shell.qml:1681-1682): with neither id on the
# bar before it, the enable ADDED a slot (:535-540) rather than taking the stock one's.
# A list that never answered leaves the marker empty — undo then leaves stock in place.
# shellcheck disable=SC2154  # $list: the answer plugin_enable's wait ended on
jq -r --arg id "$id" --arg stock "$stock" \
    'if any(.[]; (.id == $id or .id == $stock) and .enabled) then empty else "added" end' \
    <<<"$list" > "$marker" 2>/dev/null || true
echo "  $id enabled — undo: bash $dir/install undo"

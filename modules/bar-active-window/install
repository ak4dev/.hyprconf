#!/usr/bin/env bash
# hyprconf/bar-active-window — the focused window's title on two lines.
# plugin/ is a clonedFrom copy of Omarchy's own omarchy.active-window widget
# (its behaviour, its one setting and the deltas: plugin/README.md): the
# registry swaps the copy into the stock widget's slot at enable time and
# restoreCloneSource carries the entry back on disable
# (shell/services/PluginRegistry.qml:529-534,555, Omarchy 4.0.3-1), so the
# enable needs no placement of its own. Omarchy's default layout carries no
# omarchy.active-window entry at all (config/omarchy/shell.json .bar.layout),
# so the usual path is the other one: barWidget.defaultSection "left" and the
# anchor barTarget uses there, after omarchy.workspaces (:270-275),
# clone-resolved to hyprconf.workspaces while that copy holds the slot — the
# same place either way, so this module and bar-workspaces are order-free.
# A SYMLINK: the third-party scan is `for sub in "$dir"/*/` + `[[ -f
# "$sub/manifest.json" ]]`, which follows one (PluginRegistry.qml:710-714);
# `omarchy plugin remove` unlinks one (bin/omarchy-plugin-remove:99-101);
# `omarchy plugin add` refuses the id while it exists (:141-143); the
# validator wants a trailing slash (bin/omarchy-plugin-validate:115).
# The shell's inotifywait -r (PluginRegistry.qml:664-674) never descends a
# link, so every run asks for a rescan — that is what picks a `git pull` up.
# Enabled ONCE behind a marker (rule 5): `omarchy plugin disable
# hyprconf.active-window` then sticks. The discovery wait before the enable is
# omarchy-plugin-add's own (bin/omarchy-plugin-add:164-171).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.active-window
plugins=$HOME/.config/omarchy/plugins link=$plugins/$id
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/active-window-applied

if [[ ${1:-} == undo ]]; then
  omarchy-plugin-disable "$id" >/dev/null 2>&1 || true   # restoreCloneSource puts the stock widget back
  # Only ever the module's own link: a real directory there is somebody else's
  # copy (the pre-module sync, or one dropped in by hand) and is left whole.
  if [[ -L $link ]]; then rm -f "$link"
  elif [[ -d $link ]]; then echo "  $link is not this module's symlink — left alone"
  fi
  rm -f "$marker"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  exit 0
fi

if [[ -d $link/.git ]]; then
  echo "  $id is an \`omarchy plugin add\` checkout — left to omarchy plugin update"
  exit 0
fi
mkdir -p "$plugins" "${marker%/*}"
# A directory where the link goes is the pre-module synced copy (or a folder
# copied in by hand): moved aside once, never deleted.
[[ -d $link && ! -L $link ]] && mv "$link" "$plugins/.$id.bak.$(date -u +%Y%m%d%H%M%S)"
[[ $(readlink "$link" 2>/dev/null) == "$dir/plugin" ]] || ln -sfn "$dir/plugin" "$link"
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

[[ -e $marker ]] && exit 0
for (( i = 0; i < 40; i++ )); do   # no shell answering → omarchy-plugin-list exits 1 → no wait
  list=$(omarchy-plugin-list --json 2>/dev/null) || break
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$list" >/dev/null && break
  sleep 0.05
done
omarchy-plugin-enable "$id" >/dev/null 2>&1 || { echo "  no shell answering — enabled on the next run"; exit 0; }
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"

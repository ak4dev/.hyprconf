#!/usr/bin/env bash
# hyprconf/bar-clock — Omarchy's own clock showing seconds: `hh:mm:ss AP`, put back on any run that finds a format printing none.
# Seam: omarchy-bar set (bin/omarchy-bar:426-456), the running shell's own write. No widget of ours: the stock clock ticks every second for a format that prints them (shell/plugins/panels/clock/BarWidget.qml:34,126).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
: "${OMARCHY_PATH:=/usr/share/omarchy}"
clock=omarchy.clock format='hh:mm:ss AP'
# The widget's own default, what `undo` puts back (BarWidget.qml:21, config/omarchy/shell.json:27, shell/shell.qml:54; the test pins it).
stock_format='dddd HH:mm'
# The bar a box with no shell.json of its own shows is the shipped one (bin/omarchy-shell-config:20-26).
config=$HOME/.config/omarchy/shell.json
[[ -s $config ]] || config=$OMARCHY_PATH/config/omarchy/shell.json

# The clock's format as the bar has it — a bare-id entry or no format is the widget's default — and nothing where the bar carries no clock.
current() {
    jq -r --arg id "$clock" --arg d "$stock_format" 'first(.bar.layout // {} | .[]? | .[]?
        | if type == "object" then . else {id: .} end | select(.id == $id) | .format // $d)' "$config" 2>/dev/null || true
}
# $1 the format, $2 what to say once the shell has taken it.
set_format() {
    if omarchy-bar set "$clock" format "$1" >/dev/null 2>&1; then
        echo "  $2"
    else
        echo "  could not set the clock's format to $1 — retried on the next run"
    fi
}

# Before 10.0 this module shipped the stock clock as a plugin of its own, hyprconf.clock, for the seconds Omarchy 4.5 now ticks
# itself. Its link, dangling since that pull, is handed back the way its undo did — the slot to omarchy.clock, format and all —
# and the swap waited for: the shell persists it on a later event-loop turn, and `undo` below reads the file.
if [[ -L $HOME/.config/omarchy/plugins/hyprconf.clock ]]; then
    # shellcheck disable=SC2034  # what ../bar-plugin.sh is sourced with
    id=hyprconf.clock marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/clock-applied
    source "$dir/../bar-plugin.sh"
    plugin_disable "$clock"
    plugin_unlink
    for ((i = 0; i < 40; i++)); do [[ -n $(current) ]] && break; sleep 0.05; done
    echo "  hyprconf.clock retired — $clock ticks seconds itself"
fi

if [[ ${1:-} == undo ]]; then
    # Only ours goes back: a format of the user's own stays theirs.
    if [[ $(current) == "$format" ]]; then set_format "$stock_format" "$clock format back to $stock_format"; fi
    exit 0
fi

# Omarchy's own test for a format that prints seconds: an `s` outside a quoted literal, an unclosed quote running to the end
# (shell/plugins/panels/clock/Model.js:48-51). A right-click walks its ring of presets, most of which print none.
now=$(current)
if [[ -n $now && $(sed "s/'[^']*'\?//g" <<<"$now") != *s* ]]; then
    set_format "$format" "$clock showed no seconds — format back to $format"
fi

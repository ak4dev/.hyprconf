#!/usr/bin/env bash
# hyprconf/themes — links the dracula user theme in (never activated) and seeds extra wallpapers.
# Seams: ~/.config/omarchy/themes (omarchy-theme-set:204-208,275, omarchy-theme-extras:12 — a link takes the plain `cp -r` branch and `omarchy theme update` skips it) and ~/.config/omarchy/backgrounds/<theme>/ (omarchy-theme-bg-next:7-14, omarchy-theme-bg-switcher:11-14 — the only other place the picker looks).
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
themes=$HOME/.config/omarchy/themes
backgrounds=$HOME/.config/omarchy/backgrounds
link=$themes/dracula

if [[ ${1:-} == undo ]]; then
    # omarchy-theme-remove gates on `[[ -d $THEME_PATH ]]` (follows the link) and then
    # `rm -rf "$THEME_PATH"` (:31-37); the rm after it is for the Omarchy that refused.
    if [[ $(readlink "$link" 2>/dev/null) == "$dir/dracula" ]]; then
        omarchy-theme-remove dracula >/dev/null 2>&1 || true
        rm -f "$link"
    fi
    for f in "$dir"/backgrounds/*/*; do
        rel=${f#"$dir"/backgrounds/}   # <theme>/<file>; an unmatched glob fails the cmp
        if cmp -s "$f" "$backgrounds/$rel"; then
            rm -f "$backgrounds/$rel"
            rmdir "$backgrounds/${rel%/*}" 2>/dev/null || true
        fi
    done
    exit 0
fi

mkdir -p "$themes"
# hyprconf 7.x linked <checkout>/themes/dracula (v7.0.0 install.sh:769); 8.0 moved it here, so that link dangles — and is ours.
[[ $(readlink "$link" 2>/dev/null) == "${dir%/modules/themes}/themes/dracula" ]] && rm -f "$link"
# `ln -sfn` over a directory only drops a stray link inside it (-n guards a link, not a
# directory); and no `.stock` beside it either — omarchy-theme-list:7 lists every dir and
# link under ~/.config/omarchy/themes as a theme, so a backup would show up in the menu.
if [[ -e $link || -L $link ]] && [[ $(readlink "$link" 2>/dev/null) != "$dir/dracula" ]]; then
    echo "  $link is yours — left alone (move it away to get hyprconf's dracula)" >&2
elif [[ ! -L $link ]]; then
    ln -sfn "$dir/dracula" "$link"
    echo "  dracula is in the theme menu (SUPER+SHIFT+CTRL+SPACE) — the active theme is left as it is"
fi

for f in "$dir"/backgrounds/*/*; do
    [[ -f $f ]] || continue # no nullglob: an empty backgrounds/ iterates the pattern itself
    rel=${f#"$dir"/backgrounds/}
    [[ -e $backgrounds/$rel ]] || {
        install -Dm644 "$f" "$backgrounds/$rel"
        echo "  ${rel#*/} -> ${rel%/*} backgrounds (SUPER+CTRL+SPACE to pick it)"
    }
done

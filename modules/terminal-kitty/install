#!/usr/bin/env bash
# hyprconf/terminal-kitty — kitty as Omarchy's default terminal, plus one kitty include.
# Seams: bin/omarchy-default-terminal:31-35 (~/.config/xdg-terminals.list), config/kitty/kitty.conf.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# Omarchy's own variable, with Omarchy's own fallback (default/bash/env-bootstrap:10-16).
: "${OMARCHY_PATH:=/usr/share/omarchy}"
: "${HYPRCONF_STATE:=$HOME/.local/state/hyprconf}"
: "${_HYPRCONF_ASSUME_TTY:=}"

conf_dir=$HOME/.config/kitty
conf=$conf_dir/kitty.conf
mine=$conf_dir/hyprconf.conf
marker=$HYPRCONF_STATE/terminal-applied
# /usr/share/xdg-terminal-exec/hyprland-xdg-terminals.list names foot.desktop (omarchy-settings 4.0.3-1).
stock_terminal=foot
warn() { printf 'terminal-kitty: %s\n' "$*" >&2; }

if [[ ${1:-} == undo ]]; then
    # In place and --follow-symlinks, the way Omarchy edits it (migrations/1788745941.sh:19).
    [[ -f $conf ]] &&
        sed --follow-symlinks -i -e '/^# hyprconf overlay$/d' -e '/^include hyprconf\.conf$/d' "$conf"
    rm -f "$mine" "$marker"
    [[ $(omarchy-default-terminal 2>/dev/null || true) == kitty ]] &&
        { omarchy-default-terminal "$stock_terminal" >/dev/null 2>&1 || true; }
    exit 0
fi

pkgs=()
while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [[ -n $line ]] && pkgs+=("$line")
done < "$dir/packages"

if (( ${#pkgs[@]} )) && ! omarchy-pkg-present "${pkgs[@]}"; then
    if [[ -n ${HYPRCONF_NO_SUDO:-} ]]; then
        echo "  --no-packages: ${pkgs[*]} not installed — run \`bash $dir/install\` from a terminal"
    elif [[ ! -t 0 && -z $_HYPRCONF_ASSUME_TTY ]]; then
        echo "  no terminal for the sudo prompt — ${pkgs[*]} left alone"
    else
        # Not omarchy-install-terminal: it prints "Failed to install" and exits 0 anyway (bin/omarchy-install-terminal:50-52).
        omarchy-pkg-add "${pkgs[@]}" || {
            warn "package install failed — see pacman's error above; re-run to retry"
            exit 1
        }
    fi
fi

# The setter checks nothing (bin/omarchy-default-terminal:20-37), so kitty is asked for first.
omarchy-pkg-present kitty || {
    warn "kitty is not installed — the default terminal and its include are left alone"
    exit 0
}

if [[ ! -e $marker ]]; then
    mkdir -p "$HYPRCONF_STATE"
    current=$(omarchy-default-terminal 2>/dev/null || true)
    if [[ $current == kitty ]]; then
        : > "$marker"
    elif omarchy-default-terminal kitty >/dev/null 2>&1; then
        : > "$marker"
        echo "  kitty is now the default terminal"
    else
        # It exits with its closing notification's status (bin/omarchy-default-terminal:37), which
        # fails with no shell to notify — AFTER the list file is written; the next run records it.
        warn "could not set the default terminal — retried on the next run" \
             "(or set it by hand: omarchy default terminal kitty)"
    fi
fi

mkdir -p "$conf_dir"
cmp -s "$dir/hyprconf.conf" "$mine" || install -m 644 "$dir/hyprconf.conf" "$mine"

# From 4.0.3 the user file is optional (defaults in /etc/xdg/kitty/kitty.conf, merged below it) and the theme include lives only in Omarchy's stub (config/kitty/kitty.conf:1-2).
if [[ ! -e $conf && -f $OMARCHY_PATH/config/kitty/kitty.conf ]]; then
    install -m 644 "$OMARCHY_PATH/config/kitty/kitty.conf" "$conf"
fi
if ! grep -qxF 'include hyprconf.conf' "$conf" 2>/dev/null; then
    # A file NOT ending in a newline gets one here, and undo cannot tell that byte from the user's own: such a file comes back one newline longer.
    [[ ! -s $conf || -z $(tail -c1 "$conf") ]] || printf '\n' >> "$conf"
    printf '# hyprconf overlay\ninclude hyprconf.conf\n' >> "$conf"
fi
exit 0

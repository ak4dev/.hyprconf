#!/usr/bin/env bash
# hyprconf/keychron — one udev rule so Keychron / Lemokey boards answer WebHID.
# No Omarchy command for udev (`omarchy commands --json`, 4.0.3-1); the shape is install/hardware/framework/qmk-hid.sh:4-6.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")

: "${_HYPRCONF_UDEV_RULES:=/etc/udev/rules.d}"
: "${_HYPRCONF_ASSUME_TTY:=}"
src=$dir/70-keychron.rules
dst=$_HYPRCONF_UDEV_RULES/70-keychron.rules

can_sudo() {
    if [[ -n ${HYPRCONF_NO_SUDO:-} ]]; then
        echo "  skipped (--no-packages) — run \`bash $dir/install\` from a terminal for the udev rule"
        return 1
    fi
    if [[ ! -t 0 && -z $_HYPRCONF_ASSUME_TTY ]]; then
        echo "  no terminal for sudo — run \`bash $dir/install\` from a terminal for the udev rule"
        return 1
    fi
    return 0
}

if [[ ${1:-} == undo ]]; then
    [[ -f $dst ]] || exit 0
    can_sudo || exit 0
    sudo rm -f -- "$dst" || { echo "  could not remove $dst"; exit 0; }
    # No trigger: 73-seat-late.rules only ever adds an ACL, so one granted stands until re-plug.
    sudo udevadm control --reload-rules || true
    echo "  removed $dst"
    exit 0
fi

[[ -f $dst ]] && cmp -s "$src" "$dst" && exit 0
can_sudo || exit 0
sudo install -Dm644 -- "$src" "$dst" || { echo "  could not install $dst — skipping"; exit 0; }
echo "  $dst installed (Keychron 0x3434, Lemokey 0x362d) — undo: bash $dir/install undo"
# Without the trigger the ACL reaches an already-plugged board only on its next re-plug.
if sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=hidraw; then
    echo "  applied to connected devices"
else
    echo "  installed but not applied — re-plug the board or reboot"
fi
exit 0

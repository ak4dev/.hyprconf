# hyprconf — Keychron / Lemokey HID access for the web-based launcher.
#
# What TAG+="uaccess" does, why the file must sort at 70-, why the match is on
# vendor alone (and what that costs), why there is no MODE=, which boards are
# NOT covered, and the undo: README.md beside this file — the one home for it.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="362d", TAG+="uaccess"

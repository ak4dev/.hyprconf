#!/usr/bin/env bash
# hyprconf/bar-resources — installs plugin/, the hyprconf.resources bar widget, as a symlink.
# Seam: its own widget, not a clone, so it lands in the manifest's barWidget.defaultSection; the link, the rescan, the enable and the undo are ../bar-plugin.sh's.
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.resources
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/resources-applied
source "$dir/../bar-plugin.sh"

if [[ ${1:-} == undo ]]; then
    plugin_disable   # nothing to hand the slot back to: the entry comes off
    plugin_unlink
    exit 0
fi

plugin_link
[[ -e $marker ]] && exit 0   # enabled once (rule 5): a bar the user took it off stays that way
plugin_enable
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"

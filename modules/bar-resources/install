#!/usr/bin/env bash
# hyprconf/bar-resources — CPU, RAM, GPU and network on the bar, fed by the two
# streams bundled in plugin/bin/. plugin/ is a plugin in its own right (its own
# manifest and README); this file only installs it.
#
# Installed as a SYMLINK into ~/.config/omarchy/plugins/: the third-party scan is
# a glob that follows one (shell/services/PluginRegistry.qml:712-713), `omarchy
# plugin remove` unlinks one (bin/omarchy-plugin-remove:87-88,99-101), `omarchy
# plugin add` refuses the id while it exists (bin/omarchy-plugin-add:141-143) and
# the validator wants the trailing slash (bin/omarchy-plugin-validate:115). The
# shell's `inotifywait -r` (PluginRegistry.qml:663-667) never descends a link, so
# the rescan below is what carries a `git pull` into the running shell — it
# re-reads what is on disk and writes nothing, so it runs on every run.
#
# Both feeders are run by absolute path from the INSTALLED folder (Service.qml's
# pluginDir), so through the link they exec out of this checkout and nothing has
# to land on PATH.
#
# Enabled ONCE behind a marker: whether a widget is on the bar is the user's call
# from then on, and the post-update hook re-runs this after every omarchy-update
# (`omarchy plugin disable hyprconf.resources` sticks). The discovery wait before
# the enable is omarchy-plugin-add's own (bin/omarchy-plugin-add:164-171): the
# rescan is asynchronous and an enable issued before it lands fails "not known"
# (bin/omarchy-plugin-enable:85-87). Placement comes from the manifest's
# barWidget.defaultSection (PluginRegistry.qml:194-196), so no --section here.
#
# Usage: install | install undo
set -euo pipefail
dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
id=hyprconf.resources
plugins=$HOME/.config/omarchy/plugins link=$plugins/$id
marker=${HYPRCONF_STATE:-$HOME/.local/state/hyprconf}/resources-applied

if [[ ${1:-} == undo ]]; then
    omarchy-plugin-disable "$id" >/dev/null 2>&1 || true
    [[ -L $link ]] && rm -f "$link"   # only ever our own link: a real folder there is someone else's
    rm -f "$marker"
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    exit 0
fi

if [[ -d $link/.git ]]; then
    echo "  $id is an \`omarchy plugin add\` checkout — left to: omarchy plugin update $id"
    exit 0
fi
mkdir -p "$plugins"
# A real directory here is the pre-module synced copy (or a hand-dropped one):
# moved aside under omarchy-plugin-remove's own name (bin/omarchy-plugin-remove:106).
[[ -d $link && ! -L $link ]] && mv "$link" "$plugins/.$id.bak.$(date -u +%Y%m%d%H%M%S)"
[[ $(readlink "$link" 2>/dev/null) == "$dir/plugin" ]] || ln -sfn "$dir/plugin" "$link"
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

[[ -e $marker ]] && exit 0
for (( i = 0; i < 40; i++ )); do   # no shell answering → omarchy-plugin-list exits 1 → no wait
    list=$(omarchy-plugin-list --json 2>/dev/null) || break
    jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$list" >/dev/null 2>&1 && break
    sleep 0.05
done
omarchy-plugin-enable "$id" >/dev/null 2>&1 || { echo "  no shell answering — enabled on the next run"; exit 0; }
mkdir -p "${marker%/*}"
: > "$marker"
echo "  $id enabled — undo: bash $dir/install undo"
